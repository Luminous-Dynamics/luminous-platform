{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsi.example/spec/0.1/operation-event.schema.json",
  "title": "OMSI 0.1 Operation Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "tenant_id",
    "operation_id",
    "sequence",
    "occurred_at",
    "producer",
    "from_state",
    "to_state",
    "correlation_id"
  ],
  "properties": {
    "schema": {
      "const": "org.omsi.operation-event/0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "from_state": {
      "enum": [
        "none",
        "proposed",
        "validated",
        "authorized",
        "accepted",
        "running",
        "cancel_requested",
        "applied"
      ]
    },
    "to_state": {
      "enum": [
        "proposed",
        "validated",
        "authorized",
        "accepted",
        "running",
        "cancel_requested",
        "applied",
        "verified",
        "verification_failed",
        "rejected",
        "cancelled",
        "expired",
        "failed",
        "indeterminate"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "extensions": {
      "type": "object"
    }
  }
}
