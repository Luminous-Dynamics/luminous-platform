    {
      "id": "WIFI_FAILURE_RECOVERY_001",
      "domain": "resilience",
      "metric": "recovery_after_named_ap_aaa_idp_federation_wan_or_resolver_failure",
      "operator": "baseline_then_set_target",
      "target": null,
      "target_status": "baseline_first",
      "evidence_classes": ["bench_measured", "field_observed"],
      "dimensions": ["fault_domain", "p50_ms", "p95_ms", "failed_recoveries", "new_vs_existing_sessions"]
