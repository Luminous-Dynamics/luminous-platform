              },
              "target": {
                "const": 0
              },
              "target_status": {
                "const": "proposed_target"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DUPLICATE_APPLICATION_EFFECT_001"
