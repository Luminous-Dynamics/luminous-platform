{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-assurance-report-v0.1.json",
  "title":"OpsBench scenario-cluster assurance report v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","input_study_status","study_id","results_input_sha256","preregistration_sha256","scenario_cluster_definition","familywise_comparison_policy","statistical_generalization_scope","population_sampling_assumptions_verified","started_trial_count","scenario_count","baseline_arm_id","candidate_arm_ids","arms","paired_comparisons_vs_baseline","claim_ceiling","report_sha256"],
  "properties":{
    "schema":{"const":"luminous-opsbench-assurance-report-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","analysis_only_not_a_claim_of_superiority"]},
    "input_study_status":{"enum":["example_only","screening","confirmatory"]},
    "study_id":{"type":"string","minLength":1},
    "results_input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "preregistration_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "scenario_cluster_definition":{"type":"string","minLength":20},
    "familywise_comparison_policy":{"type":"string","minLength":20},
    "statistical_generalization_scope":{"type":"string","minLength":40},
    "population_sampling_assumptions_verified":{"const":false},
    "started_trial_count":{"type":"integer","minimum":1},
    "scenario_count":{"type":"integer","minimum":1},
    "baseline_arm_id":{"type":"string","minLength":1},
    "candidate_arm_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "arms":{"type":"object","minProperties":2,"additionalProperties":{"type":"object","required":["trial_count","scenario_cluster_count","strict_verified_success_count","trial_weighted_strict_success_rate","scenario_weighted_strict_success_rate","scenario_cluster_bootstrap_95","per_family","safety"],"properties":{
      "trial_count":{"type":"integer","minimum":1},
      "scenario_cluster_count":{"type":"integer","minimum":1},
      "strict_verified_success_count":{"type":"integer","minimum":0},
      "trial_weighted_strict_success_rate":{"type":"number","minimum":0,"maximum":1},
      "scenario_weighted_strict_success_rate":{"type":"number","minimum":0,"maximum":1},
      "scenario_cluster_bootstrap_95":{"type":"object"},
      "per_family":{"type":"object","minProperties":1},
      "safety":{"type":"object","required":["gate","population_inference_assumptions_verified","population_zero_failure_claim_permitted"],"properties":{
        "gate":{"enum":["pass","fail","indeterminate"]},
        "population_inference_assumptions_verified":{"const":false},
        "population_zero_failure_claim_permitted":{"const":false}
      }}
    }}},
    "paired_comparisons_vs_baseline":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","required":["candidate_trial_count","baseline_trial_count","matched_pair_count","matched_scenario_cluster_count","unmatched_candidate_trial_count","unmatched_baseline_trial_count","scenario_weighted_paired_difference","scenario_cluster_bootstrap_familywise_interval","familywise_comparison_count","inference_uses_only_exact_common_pair_keys"],"properties":{
      "candidate_trial_count":{"type":"integer","minimum":1},
      "baseline_trial_count":{"type":"integer","minimum":1},
      "matched_pair_count":{"type":"integer","minimum":0},
      "matched_scenario_cluster_count":{"type":"integer","minimum":0},
      "unmatched_candidate_trial_count":{"type":"integer","minimum":0},
      "unmatched_baseline_trial_count":{"type":"integer","minimum":0},
      "scenario_weighted_paired_difference":{"type":["number","null"],"minimum":-1,"maximum":1},
      "scenario_cluster_bootstrap_familywise_interval":{"type":"object"},
      "familywise_comparison_count":{"type":"integer","minimum":1},
      "inference_uses_only_exact_common_pair_keys":{"const":true}
    }}},
    "claim_ceiling":{"type":"string","minLength":80},
    "report_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}