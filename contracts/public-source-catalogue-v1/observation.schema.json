{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/public-observation-v1.json",
  "title": "Luminous Public Source Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_id",
    "source_uri",
    "retrieved_at",
    "source_period",
    "dataset_id",
    "field_path",
    "raw_value",
    "raw_value_state",
    "normalization",
    "source_snapshot_sha256",
    "fixture_only"
  ],
  "properties": {
    "schema_version": {
      "const": "public-observation-v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "source_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_label"
      ],
      "properties": {
        "financial_year_end": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "period_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "field_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "raw_value": {},
    "raw_value_state": {
      "type": "string",
      "enum": [
        "reported_value",
        "reported_zero",
        "reported_null",
        "row_omitted",
        "invalid_value",
        "not_retrieved",
        "stale",
        "provisional"
      ]
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "rule_id",
        "rule_version",
        "normalized_value",
        "reason"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "rule_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "normalized_value": {},
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "if": {
        "properties": {
          "applied": {
            "const": true
          }
        },
        "required": [
          "applied"
        ]
      },
      "then": {
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "rule_id": {
            "type": "null"
          },
          "rule_version": {
            "type": "null"
          }
        }
      }
    },
    "source_snapshot_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "fixture_only": {
      "type": "boolean"
    }
  }
}
