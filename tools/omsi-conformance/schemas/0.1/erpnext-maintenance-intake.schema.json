{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMSI ERPNext maintenance intake projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tenant_id",
    "source",
    "maintenance",
    "source_claims",
    "assurance",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "org.omsi.erpnext-maintenance-intake/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "instance_namespace",
        "release_tag",
        "repository_commit",
        "license",
        "doctype",
        "record_id",
        "plan_record_id",
        "task_record_id",
        "company_id",
        "exported_at"
      ],
      "properties": {
        "system": {
          "const": "ERPNext"
        },
        "instance_namespace": {
          "type": "string",
          "minLength": 1
        },
        "release_tag": {
          "const": "v16.51.0"
        },
        "repository_commit": {
          "const": "fd97695de7bfeb1d7728a7370c3e128d0cc1509e"
        },
        "license": {
          "const": "GPL-3.0"
        },
        "doctype": {
          "const": "Asset Maintenance Log"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_record_id": {
          "type": "string",
          "minLength": 1
        },
        "task_record_id": {
          "type": "string",
          "minLength": 1
        },
        "company_id": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status",
        "source_docstatus",
        "normalized_status",
        "plan_ref",
        "task_ref",
        "asset_ref",
        "maintenance_type",
        "periodicity",
        "due_date",
        "next_task_due_date",
        "completion_date",
        "last_task_completion_date",
        "amended_from_ref",
        "mapping_conflicts",
        "mapping_losses"
      ],
      "properties": {
        "source_status": {
          "enum": [
            "Planned",
            "Completed",
            "Cancelled",
            "Overdue"
          ]
        },
        "source_docstatus": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "normalized_status": {
          "enum": [
            "scheduled",
            "closed",
            "cancelled",
            "overdue",
            "blocked"
          ]
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "maintenance_type": {
          "enum": [
            "Preventive Maintenance",
            "Calibration"
          ]
        },
        "periodicity": {
          "enum": [
            "Daily",
            "Weekly",
            "Monthly",
            "Quarterly",
            "Half-yearly",
            "Yearly",
            "2 Yearly",
            "3 Yearly"
          ]
        },
        "due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_task_due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_task_completion_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "amended_from_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapping_losses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_required",
        "has_certificate_flag",
        "certificate_attachment_present",
        "actions_performed_present",
        "assigned_user_present"
      ],
      "properties": {
        "certificate_required": {
          "type": "boolean"
        },
        "has_certificate_flag": {
          "type": "boolean"
        },
        "certificate_attachment_present": {
          "type": "boolean"
        },
        "actions_performed_present": {
          "type": "boolean"
        },
        "assigned_user_present": {
          "type": "boolean"
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workmanship_quality",
        "practitioner_credential_status",
        "independent_verification",
        "certificate_authenticity"
      ],
      "properties": {
        "workmanship_quality": {
          "const": "not_verified"
        },
        "practitioner_credential_status": {
          "const": "not_provided_by_source"
        },
        "independent_verification": {
          "const": "not_provided_by_source"
        },
        "certificate_authenticity": {
          "const": "not_established"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_actions_performed_exported",
        "certificate_bytes_exported",
        "customer_contact_exported"
      ],
      "properties": {
        "raw_actions_performed_exported": {
          "const": false
        },
        "certificate_bytes_exported": {
          "const": false
        },
        "customer_contact_exported": {
          "const": false
        }
      }
    }
  }
}
