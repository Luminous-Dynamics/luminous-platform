{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/opsbench-service-observations-v0.1.json",
  "title": "OpsBench independent service and business observations v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "study_id",
    "run_id",
    "episode_id",
    "service_id",
    "observer",
    "business_oracle",
    "profile_sha256",
    "phase_schedule_sha256",
    "windows"
  ],
  "properties": {
    "schema": {
      "const": "luminous-opsbench-service-observations-v0.1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "example_only",
        "captured"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "trust_domain_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_domain_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "business_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "trust_domain_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_domain_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_schedule_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window_id",
          "phase_id",
          "class_id",
          "server_received_count",
          "server_rejected_count",
          "server_retry_attempt_count",
          "business_checked_count",
          "business_correct_count",
          "started_at",
          "ended_at"
        ],
        "properties": {
          "window_id": {
            "type": "string",
            "minLength": 1
          },
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "server_received_count": {
            "type": "integer",
            "minimum": 0
          },
          "server_rejected_count": {
            "type": "integer",
            "minimum": 0
          },
          "server_retry_attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "business_checked_count": {
            "type": "integer",
            "minimum": 0
          },
          "business_correct_count": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
