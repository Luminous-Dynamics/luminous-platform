{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/probe-impact-report-v0.1.schema.json",
  "title": "Probe Interference Evaluator Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "disposition",
    "probe_run_id",
    "no_probe_run_id",
    "scenario_id",
    "paired_block_id",
    "execution_count",
    "receipt_count",
    "total_resource_usage",
    "service_impacts",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "continuous-opsbench-probe-impact-v0.1"
    },
    "disposition": {
      "enum": [
        "Pass",
        "Fail",
        "Indeterminate"
      ]
    },
    "probe_run_id": {
      "type": "string",
      "minLength": 1
    },
    "no_probe_run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "paired_block_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_count": {
      "type": "integer",
      "minimum": 0
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millicore_ms",
        "memory_byte_ms",
        "disk_read_bytes",
        "disk_write_bytes",
        "network_bytes",
        "query_rows",
        "duration_ms"
      ],
      "properties": {
        "cpu_millicore_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "memory_byte_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_read_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "disk_write_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "network_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "query_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "service_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "workload_class",
          "offered_requests",
          "failure_delta_ppm",
          "slow_delta_ppm",
          "incorrect_delta_ppm"
        ],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "workload_class": {
            "type": "string",
            "minLength": 1
          },
          "offered_requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failure_delta_ppm": {
            "type": "integer"
          },
          "slow_delta_ppm": {
            "type": "integer"
          },
          "incorrect_delta_ppm": {
            "type": "integer"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "InvalidIdentity",
          "InvalidContract",
          "TooManyRecords",
          "DuplicateExecution",
          "DuplicateReceipt",
          "MissingImpactReceipt",
          "DuplicateEvidence",
          "IncompleteImpactReceipt",
          "ImpactIdentityMismatch",
          "ObserverNotIndependent",
          "InvalidExecutionInterval",
          "ProbeNotReadOnly",
          "ProbeDurationExceeded",
          "ResourceAccountingOverflow",
          "ResourceEnvelopeExceeded",
          "MissingServiceWindow",
          "DuplicateServiceWindow",
          "IncompleteServiceWindow",
          "ServiceWindowIdentityMismatch",
          "InvalidRequestCounts",
          "ZeroOfferedDemand",
          "MissingServiceLimit",
          "ServiceFailureImpactExceeded",
          "ServiceLatencyImpactExceeded",
          "BusinessCorrectnessImpactExceeded",
          "ImpactSequenceRegression",
          "ImpactSequenceGap"
        ]
      }
    }
  }
}
