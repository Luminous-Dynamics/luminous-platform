    {
      "id": "WIFI_CLIENT_ISOLATION_001",
      "domain": "network_security",
      "metric": "unauthorized_guest_to_guest_or_guest_to_management_connections_succeeded",
      "operator": "==",
      "target": 0,
      "target_status": "proposed_target",
      "evidence_classes": ["bench_measured"],
      "negative_cases": ["cross_guest_ipv4", "cross_guest_ipv6", "ap_management_access", "lateral_discovery"]
