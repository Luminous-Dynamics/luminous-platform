{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:security:osi-xap-assurance-graph:0.1",
  "title": "Luminous XAP assurance graph fixtures v0.1",
  "type": "object",
  "required": [
    "profile",
    "version",
    "status",
    "fixtures"
  ],
  "properties": {
    "profile": {
      "const": "luminous-osi-xap-assurance-graph"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_fixture_suite"
    },
    "fixtures": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "expected_disposition",
          "expected_reason",
          "graph"
        ],
        "properties": {
          "expected_disposition": {
            "enum": [
              "qualified",
              "refuted",
              "indeterminate"
            ]
          },
          "expected_reason": {
            "type": "string",
            "minLength": 10
          },
          "graph": {
            "$ref": "#/$defs/graph"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "fault_domain",
        "enforcement_roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "type": {
          "enum": [
            "untrusted_ingress",
            "principal",
            "workload",
            "device",
            "firmware_artifact",
            "policy",
            "authority_grant",
            "enforcement_point",
            "network_path",
            "data_object",
            "transformation",
            "consequential_sink",
            "participant_effect",
            "observer",
            "evidence_artifact",
            "shared_dependency"
          ]
        },
        "fault_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforcement_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "network_egress",
              "broker_authorization",
              "participant_authorization",
              "physical_safety",
              "data_release",
              "evidence_verification"
            ]
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "type",
        "inventory_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2
        },
        "from": {
          "type": "string",
          "minLength": 2
        },
        "to": {
          "type": "string",
          "minLength": 2
        },
        "type": {
          "enum": [
            "proposes",
            "authenticates",
            "delegates",
            "constrains",
            "routes",
            "enforces",
            "reads",
            "transforms",
            "discloses",
            "commits",
            "observes",
            "attests",
            "depends_on",
            "revokes",
            "recovers"
          ]
        },
        "inventory_status": {
          "enum": [
            "verified",
            "declared",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": [
        "graph_id",
        "scope",
        "inventory",
        "nodes",
        "edges",
        "claim"
      ],
      "properties": {
        "graph_id": {
          "type": "string",
          "minLength": 4
        },
        "scope": {
          "type": "string",
          "minLength": 4
        },
        "inventory": {
          "type": "object",
          "required": [
            "complete",
            "unknown_nodes",
            "unknown_edges",
            "source"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "unknown_nodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknown_edges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string",
              "minLength": 3
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "claim": {
          "type": "object",
          "required": [
            "claim_id",
            "property",
            "scope"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "minLength": 3
            },
            "property": {
              "enum": [
                "complete_mediation",
                "evidence_independence"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 3
            },
            "source_node_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "sink_node_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "required_enforcement_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "network_egress",
                  "broker_authorization",
                  "participant_authorization",
                  "physical_safety",
                  "data_release",
                  "evidence_verification"
                ]
              }
            },
            "observer_node_refs": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "property": {
                    "const": "complete_mediation"
                  }
                },
                "required": [
                  "property"
                ]
              },
              "then": {
                "required": [
                  "source_node_refs",
                  "sink_node_refs",
                  "required_enforcement_roles"
                ],
                "not": {
                  "required": [
                    "observer_node_refs"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "property": {
                    "const": "evidence_independence"
                  }
                },
                "required": [
                  "property"
                ]
              },
              "then": {
                "required": [
                  "observer_node_refs"
                ],
                "not": {
                  "required": [
                    "source_node_refs",
                    "sink_node_refs",
                    "required_enforcement_roles"
                  ]
                }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
