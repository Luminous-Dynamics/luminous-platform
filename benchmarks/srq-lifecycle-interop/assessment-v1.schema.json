{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/srq-lifecycle-interop-assessment-v1.schema.json",
  "title": "SRQ lifecycle interoperability assessment v1",
  "description": "Closed, fail-closed interoperability report schema; this report is structurally passing but always release-blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_status",
    "release_status",
    "claim_ceiling",
    "scenario_id",
    "sources",
    "transaction",
    "boot_observation",
    "evidence_plane",
    "release_blockers",
    "invariant",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "srq-lifecycle-interop-assessment-v1"
    },
    "contract_status": {
      "const": "PASS"
    },
    "release_status": {
      "const": "BLOCKED"
    },
    "claim_ceiling": {
      "const": "none"
    },
    "scenario_id": {
      "const": "LIFECYCLE-001"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nixward_transaction",
        "mycelix_evidence_plane_schema",
        "mycelix_evidence_plane_receipt",
        "sovereign_boot_probe_source",
        "sovereign_boot_observation",
        "interop_harness"
      ],
      "properties": {
        "nixward_transaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit_sha",
            "git_blob_sha1",
            "raw_sha256"
          ],
          "properties": {
            "repository": {
              "const": "Luminous-Dynamics/nixward"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "mycelix_evidence_plane_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit_sha",
            "git_blob_sha1",
            "raw_sha256"
          ],
          "properties": {
            "repository": {
              "const": "Luminous-Dynamics/mycelix"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "mycelix_evidence_plane_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit_sha",
            "git_blob_sha1",
            "raw_sha256"
          ],
          "properties": {
            "repository": {
              "const": "Luminous-Dynamics/mycelix"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "sovereign_boot_probe_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit_sha",
            "git_blob_sha1"
          ],
          "properties": {
            "repository": {
              "const": "Luminous-Dynamics/sovereign-boot"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "sovereign_boot_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_sha256"
          ],
          "properties": {
            "raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "interop_harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit_sha",
            "validator_git_blob_sha1",
            "validator_raw_sha256",
            "adversarial_script_git_blob_sha1",
            "adversarial_script_raw_sha256",
            "schema_validator_git_blob_sha1",
            "schema_validator_raw_sha256",
            "schema_validator_test_git_blob_sha1",
            "schema_validator_test_raw_sha256",
            "schema_requirements_git_blob_sha1",
            "schema_requirements_raw_sha256",
            "test_git_blob_sha1",
            "test_raw_sha256",
            "upstream_lock_git_blob_sha1",
            "upstream_lock_raw_sha256",
            "assessment_schema_git_blob_sha1",
            "assessment_schema_raw_sha256",
            "corpus_protocol_git_blob_sha1",
            "corpus_protocol_raw_sha256",
            "corpus_protocol_id",
            "corpus_schema_git_blob_sha1",
            "corpus_schema_raw_sha256",
            "corpus_validator_git_blob_sha1",
            "corpus_validator_raw_sha256",
            "corpus_validator_test_git_blob_sha1",
            "corpus_validator_test_raw_sha256"
          ],
          "properties": {
            "repository": {
              "const": "Luminous-Dynamics/luminous-platform"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "validator_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "validator_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "adversarial_script_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "adversarial_script_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_validator_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "schema_validator_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_validator_test_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "schema_validator_test_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_requirements_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "schema_requirements_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "test_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "test_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "upstream_lock_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "upstream_lock_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "assessment_schema_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "assessment_schema_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "corpus_protocol_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "corpus_protocol_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "corpus_protocol_id": {
              "const": "srq-lifecycle-adversarial-v1"
            },
            "corpus_schema_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "corpus_schema_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "corpus_validator_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "corpus_validator_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "corpus_validator_test_git_blob_sha1": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "corpus_validator_test_raw_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "phase",
        "transaction_id",
        "target_machine_digest",
        "plan_digest",
        "authorization_present",
        "verification_present",
        "outcome_present"
      ],
      "properties": {
        "schema": {
          "const": "luminous-nixward-system-transaction-v1"
        },
        "phase": {
          "enum": [
            "planned",
            "validated",
            "authorized",
            "snapshotted",
            "applied",
            "verified",
            "promoted",
            "failed",
            "recovered"
          ]
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_machine_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_present": {
          "type": "boolean"
        },
        "verification_present": {
          "type": "boolean"
        },
        "outcome_present": {
          "type": "boolean"
        }
      }
    },
    "boot_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evidence_tier",
        "status",
        "authenticated",
        "release_qualifying",
        "security_bindings_complete"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "evidence_tier": {
          "const": "D0_LOCAL_DIAGNOSTIC"
        },
        "status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "BLOCKED"
          ]
        },
        "authenticated": {
          "type": "boolean"
        },
        "release_qualifying": {
          "type": "boolean"
        },
        "security_bindings_complete": {
          "type": "boolean"
        }
      }
    },
    "evidence_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "run_status",
        "evidence_tier",
        "claim_ceiling",
        "result_state",
        "independent_verification"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "run_status": {
          "const": "planned"
        },
        "evidence_tier": {
          "const": "S0"
        },
        "claim_ceiling": {
          "const": "synthetic_only"
        },
        "result_state": {
          "const": "not_run"
        },
        "independent_verification": {
          "const": "none"
        }
      }
    },
    "release_blockers": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "non_claims": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
