{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:omsi:interoperability-target-matrix:0.1",
  "title": "OMSI Interoperability Target Matrix 0.1",
  "description": "Qualification backlog for manufacturing interoperability targets. It explicitly separates research targets from assessed conformance.",
  "type": "object",
  "required": [
    "contract",
    "status",
    "purpose",
    "authority",
    "targets",
    "cross_cutting_gates",
    "non_claims",
    "references"
  ],
  "properties": {
    "contract": {
      "const": "omsi-interoperability-target-matrix/0.1"
    },
    "status": {
      "const": "research_targets_only_not_conformance"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "planning_only"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "standard",
          "domain",
          "role",
          "candidate_payload_family",
          "implementation_status",
          "conformance_status",
          "required_inputs",
          "benchmarks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "candidate_payload_family": {
            "type": "string",
            "minLength": 1
          },
          "implementation_status": {
            "enum": [
              "not_implemented",
              "prototype",
              "implemented"
            ]
          },
          "conformance_status": {
            "enum": [
              "not_assessed",
              "partial",
              "conformant",
              "nonconformant"
            ]
          },
          "required_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "benchmarks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "metric",
                "target",
                "unit",
                "gate",
                "acceptance"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                "target": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "gate": {
                  "enum": [
                    "hard",
                    "release",
                    "provisional"
                  ]
                },
                "acceptance": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "implementation_status": {
                  "const": "not_implemented"
                }
              },
              "required": [
                "implementation_status"
              ]
            },
            "then": {
              "properties": {
                "conformance_status": {
                  "const": "not_assessed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "implementation_status": {
                  "const": "prototype"
                }
              },
              "required": [
                "implementation_status"
              ]
            },
            "then": {
              "properties": {
                "conformance_status": {
                  "enum": [
                    "not_assessed",
                    "partial",
                    "nonconformant"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "cross_cutting_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "metric",
          "target",
          "unit",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "metric": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "target": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
