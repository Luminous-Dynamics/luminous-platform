      "cost_per_on_time_useful_mib",
      "energy_per_on_time_useful_mib",
      "companion_flow_retention",
      "redundant_bytes",
      "late_payload_bytes",
      "deadline_lateness_tail",
      "resource_utilization"
    ],
    "no_scalar_aggregate_score": true,
    "throughput_only_win_is_insufficient": true,
    "late_useful_bytes_are_not_credited_as_on_time": true,
    "incomplete_task_is_not_complete": true,
    "task_value_is_all_or_nothing_for_this_v1": true,
    "future_streaming_chunk_value_requires_separate_contract": true,
    "scheduler_actuation": false
  },
