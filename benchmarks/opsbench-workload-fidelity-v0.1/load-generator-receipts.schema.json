{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/opsbench-load-generator-receipts-v0.1.json",
  "title": "OpsBench independent load-generator receipts v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "study_id",
    "run_id",
    "episode_id",
    "service_id",
    "load_generator",
    "profile_sha256",
    "phase_schedule_sha256",
    "windows"
  ],
  "properties": {
    "schema": {
      "const": "luminous-opsbench-load-generator-receipts-v0.1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "example_only",
        "captured"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "load_generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "trust_domain_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_domain_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_schedule_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window_id",
          "phase_id",
          "class_id",
          "started_at",
          "ended_at",
          "offered_count",
          "offered_rps",
          "response_success_count",
          "response_error_count",
          "response_timeout_count",
          "peak_concurrency",
          "latency_histogram",
          "response_drop_count",
          "payload_profile_id",
          "client_timeout_ms"
        ],
        "properties": {
          "window_id": {
            "type": "string",
            "minLength": 1
          },
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "offered_count": {
            "type": "integer",
            "minimum": 1
          },
          "offered_rps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "response_success_count": {
            "type": "integer",
            "minimum": 0
          },
          "response_error_count": {
            "type": "integer",
            "minimum": 0
          },
          "response_timeout_count": {
            "type": "integer",
            "minimum": 0
          },
          "peak_concurrency": {
            "type": "integer",
            "minimum": 1
          },
          "latency_histogram": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "buckets"
            ],
            "properties": {
              "unit": {
                "const": "s"
              },
              "buckets": {
                "type": "array",
                "minItems": 2,
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "upper_bound_seconds",
                    "count"
                  ],
                  "properties": {
                    "upper_bound_seconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "response_drop_count": {
            "type": "integer",
            "minimum": 0
          },
          "payload_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "client_timeout_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
