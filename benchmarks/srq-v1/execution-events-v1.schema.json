{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRQ execution witness event ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "trial_id", "fault_id", "input_sha256", "event_kind", "source_role", "monotonic_ns"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"},
          "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"},
          "fault_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "event_kind": {"enum": ["fault_injection", "post_restart_observation"]},
          "source_role": {"enum": ["fault_injector", "independent_observer"]},
          "monotonic_ns": {"type": "integer", "minimum": 1},
          "mechanism": {"enum": ["function_return", "sigkill", "qemu_reset", "kernel_panic", "physical_power_cut"]},
          "trigger_confirmed": {"type": "boolean"},
          "post_restart": {"type": "boolean"},
          "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,120}$"},
          "outcome": {"enum": ["old_complete", "new_complete", "recoverable_blocked", "state_lost", "state_inconsistent", "unavailable_unobserved", "unauthorized_accept", "replay_accept", "hybrid_state", "unclassified_fault"]},
          "state_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"event_kind": {"const": "fault_injection"}}, "required": ["event_kind"]},
            "then": {"required": ["mechanism", "trigger_confirmed"], "properties": {"source_role": {"const": "fault_injector"}}}
          },
          {
            "if": {"properties": {"event_kind": {"const": "post_restart_observation"}}, "required": ["event_kind"]},
            "then": {"required": ["observation_id", "post_restart", "outcome", "state_digest_sha256"], "properties": {"source_role": {"const": "independent_observer"}}}
          }
        ]
      }
    }
  }
}
