{
  "schema_version": "luminous.lnf-mpath-coexistence-profile.v1",
  "profile_id": "lnf-mpath-do-no-harm-v1",
  "status": "draft_targets_not_results",
  "reviewed_on": "2026-11-03",
  "parent_issue": 212,
  "qualification_issue": 222,
  "objective": "Evaluate MPTCP best-path improvement and TCP coexistence fairness using exact matched independent/shared-bottleneck experiments.",
  "execution_stage": "deterministic_evidence_evaluator_only",
  "standards_basis": [
    "RFC 6356",
    "RFC 8684"
  ],
  "design_goals": {
    "best_path_improvement": "MPTCP application goodput should be no worse than the best matched single-path TCP reference over genuinely independent capacity domains.",
    "do_no_harm": "An MPTCP connection must not obtain materially more capacity at shared bottlenecks than an equivalent single TCP flow at the expense of a companion TCP flow.",
    "resource_pooling": "Move traffic away from congestion where practical without double-counting shared capacity or harming competing traffic."
  },
  "paired_identity": {
    "required_digests": [
      "kernel_build_sha256",
      "topology_sha256",
      "qdisc_config_sha256",
      "workload_sha256",
      "impairment_sha256"
    ],
    "required_scalar_identity": [
      "seed",
      "warmup_us",
      "measurement_duration_us",
      "tcp_congestion_control",
      "mptcp_congestion_control",
      "mptcp_scheduler",
      "mptcp_scheduler_provenance",
      "mptcp_congestion_control_provenance",
      "tcp_congestion_control_provenance"
    ],
    "all_arms_must_match_identity": true,
    "mismatched_identity_disposition": "inconclusive",
    "implementation_identity_must_be_exact": true,
    "implementation_provenance_contract": "in_tree_implementations_are_bound_to_kernel_build_sha256; each_out_of_tree_tcp_or_mptcp_controller_and_scheduler_requires_its_own_artifact_sha256"
  },
  "evidence_requirements": {
    "mptcp_kernel_support_required": true,
    "mptcp_scheduler_support_required": true,
    "authoritative_negotiation_proof_both_endpoints": true,
    "minimum_negotiated_subflows": 2,
    "maximum_evaluator_subflows": 64,
    "all_required_counters_required": true,
    "cleanup_verification_required": true,
    "unsupported_or_missing_is_not_pass": true,
    "fixed_point_ratio_unit": "parts_per_million",
    "statistical_confidence_intervals": "external analysis layer retains all repetitions and denominators",
    "paired_gate_scope": "single_paired_trial_only",
    "programme_qualification_requires_external_repeated_trial_analysis": true
  },
  "scenarios": [
