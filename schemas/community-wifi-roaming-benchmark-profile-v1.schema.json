          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "WIFI_SECRET_EXPOSURE_001"
              },
              "operator": {
                "const": "=="
              },
              "target": {
                "const": 0
              },
              "target_status": {
                "const": "proposed_target"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "WIFI_TIME_TO_USABLE_IP_001"
              },
              "operator": {
                "const": "baseline_then_set_target"
              },
              "target": {
                "const": null
              },
              "target_status": {
                "const": "baseline_first"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "WIFI_FIRST_ATTEMPT_AUTH_001"
              },
              "operator": {
                "const": "baseline_then_set_target"
              },
              "target": {
                "const": null
              },
              "target_status": {
                "const": "baseline_first"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
