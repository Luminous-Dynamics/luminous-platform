{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-cluster-inference-input-v0.1.json",
  "title": "Continuous OpsBench paired cluster inference input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "clusters"
  ],
  "properties": {
    "schema_version": {
      "const": "continuous-opsbench-cluster-inference-input-v0.1"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "claim_mode",
        "algorithm_version",
        "bootstrap_seed_commitment",
        "minimum_independent_clusters",
        "bootstrap_replicates",
        "confidence_level_bps",
        "minimum_meaningful_effect_ppm",
        "maximum_indeterminate_rate_ppm"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-cluster-inference-v0.1"
        },
        "algorithm_version": {
          "const": "splitmix64-paired-cluster-bootstrap-v1"
        },
        "bootstrap_seed_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "minimum_independent_clusters": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "bootstrap_replicates": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000
        },
        "confidence_level_bps": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 9999
        },
        "minimum_meaningful_effect_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maximum_indeterminate_rate_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "claim_mode": {
          "enum": [
            "exploratory",
            "confirmatory"
          ]
        }
      }
    },
    "clusters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id",
          "candidate",
          "baseline"
        ],
        "properties": {
          "cluster_id": {
            "$ref": "#/$defs/id"
          },
          "candidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fault_schedule_digest",
              "topology_digest",
              "workload_profile_digest",
              "offered_demand_contract_digest",
              "outcomes"
            ],
            "properties": {
              "fault_schedule_digest": {
                "$ref": "#/$defs/sha256"
              },
              "topology_digest": {
                "$ref": "#/$defs/sha256"
              },
              "workload_profile_digest": {
                "$ref": "#/$defs/sha256"
              },
              "offered_demand_contract_digest": {
                "$ref": "#/$defs/sha256"
              },
              "outcomes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "planned_faults",
                  "verified_recoveries",
                  "known_nonrecoveries",
                  "indeterminate_recoveries"
                ],
                "properties": {
                  "planned_faults": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verified_recoveries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "known_nonrecoveries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "indeterminate_recoveries": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fault_schedule_digest",
              "topology_digest",
              "workload_profile_digest",
              "offered_demand_contract_digest",
              "outcomes"
            ],
            "properties": {
              "fault_schedule_digest": {
                "$ref": "#/$defs/sha256"
              },
              "topology_digest": {
                "$ref": "#/$defs/sha256"
              },
              "workload_profile_digest": {
                "$ref": "#/$defs/sha256"
              },
              "offered_demand_contract_digest": {
                "$ref": "#/$defs/sha256"
              },
              "outcomes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "planned_faults",
                  "verified_recoveries",
                  "known_nonrecoveries",
                  "indeterminate_recoveries"
                ],
                "properties": {
                  "planned_faults": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verified_recoveries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "known_nonrecoveries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "indeterminate_recoveries": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
