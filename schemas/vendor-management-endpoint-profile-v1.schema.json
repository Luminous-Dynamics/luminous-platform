{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/vendor-management-endpoint-profile-v1.schema.json",
  "title": "Luminous Vendor Management Endpoint Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "state",
    "as_of",
    "adapter",
    "scope",
    "endpoint",
    "peer_verification",
    "redirect_policy",
    "authentication",
    "egress",
    "limits",
    "privacy",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.vendor-management-endpoint-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "draft",
        "retired"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_revision",
        "vendor",
        "product_family"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "adapter_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "vendor": {
          "type": "string",
          "minLength": 2
        },
        "product_family": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "hardware_revision",
        "software_version",
        "deployment_jurisdiction",
        "hardware_or_commercial_region",
        "support_jurisdiction",
        "expected_principal_ref",
        "expected_tenant_or_org_ref"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 2
        },
        "hardware_revision": {
          "type": "string",
          "minLength": 1
        },
        "software_version": {
          "type": "string",
          "minLength": 1
        },
        "deployment_jurisdiction": {
          "$ref": "#/$defs/assessedDimension"
        },
        "hardware_or_commercial_region": {
          "$ref": "#/$defs/assessedDimension"
        },
        "support_jurisdiction": {
          "$ref": "#/$defs/assessedDimension"
        },
        "expected_principal_ref": {
          "type": "string",
          "minLength": 8
        },
        "expected_tenant_or_org_ref": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "transport",
        "host",
        "port",
        "api_base_path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vendor_cloud_api",
            "local_device_api",
            "netconf_ssh",
            "netconf_tls",
            "gnmi_tls",
            "snmpv3"
          ]
        },
        "transport": {
          "enum": [
            "https",
            "ssh",
            "tls",
            "grpc_tls",
            "snmpv3_usm"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9:.-]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "api_base_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      }
    },
    "peer_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "trust_reference",
        "hostname_validation",
        "minimum_tls_version",
        "insecure_fallback_allowed"
      ],
      "properties": {
        "method": {
          "enum": [
            "platform_trust_store",
            "pinned_certificate_sha256",
            "ssh_known_hosts",
            "protocol_specific_trust"
          ]
        },
        "trust_reference": {
          "type": "string",
          "minLength": 8
        },
        "hostname_validation": {
          "type": "boolean"
        },
        "minimum_tls_version": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "TLSv1.2",
            "TLSv1.3",
            null
          ]
        },
        "insecure_fallback_allowed": {
          "const": false
        }
      }
    },
    "redirect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed_origins",
        "credential_forwarding_across_origin"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deny",
            "allowlisted_origins"
          ]
        },
        "allowed_origins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          }
        },
        "credential_forwarding_across_origin": {
          "const": false
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "credential_reference",
        "expected_principal_ref",
        "permission_scope_ref",
        "read_only",
        "mutation_enabled",
        "expected_tenant_or_org_ref"
      ],
      "properties": {
        "mode": {
          "enum": [
            "api_token_reference",
            "oauth_profile_reference",
            "mtls_client_certificate_reference",
            "ssh_key_reference",
            "snmpv3_authpriv_reference"
          ]
        },
        "credential_reference": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "pattern": "^(secretref|credential-profile|vaultref):[A-Za-z0-9._:/-]+$"
        },
        "expected_principal_ref": {
          "type": "string",
          "minLength": 8
        },
        "permission_scope_ref": {
          "type": "string",
          "minLength": 8
        },
        "read_only": {
          "const": true
        },
        "mutation_enabled": {
          "const": false
        },
        "expected_tenant_or_org_ref": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowlist_policy_ref",
        "proxy_mode",
        "ambient_proxy_allowed",
        "proxy_profile_ref"
      ],
      "properties": {
        "allowlist_policy_ref": {
          "type": "string",
          "minLength": 8
        },
        "proxy_mode": {
          "enum": [
            "disabled",
            "explicit_profile"
          ]
        },
        "ambient_proxy_allowed": {
          "const": false
        },
        "proxy_profile_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 8,
          "maxLength": 512
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connect_timeout_ms",
        "request_timeout_ms",
        "max_response_bytes",
        "max_redirects",
        "max_retries",
        "rate_limit_policy_ref"
      ],
      "properties": {
        "connect_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "rate_limit_policy_ref": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secrets_in_profile",
        "secrets_in_logs",
        "raw_configuration_in_shared_dht",
        "customer_personal_data_in_shared_dht"
      ],
      "properties": {
        "secrets_in_profile": {
          "const": false
        },
        "secrets_in_logs": {
          "const": false
        },
        "raw_configuration_in_shared_dht": {
          "const": false
        },
        "customer_personal_data_in_shared_dht": {
          "const": false
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "purposes",
          "last_reviewed_on"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "endpoint_selection",
                "product_api",
                "protocol_contract",
                "security_baseline"
              ]
            }
          },
          "last_reviewed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "assessedDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "assessed",
            "not_applicable",
            "unresolved"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
