{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/lnf-mpath-coexistence-profile-v1.schema.json",
  "title": "LNF MPTCP Coexistence and Do-no-harm Profile v1",
  "description": "Strict experiment and evaluator contract. Profile validation is not a benchmark result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "reviewed_on",
    "parent_issue",
    "qualification_issue",
    "objective",
    "execution_stage",
    "standards_basis",
    "design_goals",
    "paired_identity",
    "evidence_requirements",
    "scenarios",
    "scenario_definitions",
    "comparators",
    "benchmarks",
    "required_metrics",
    "verdicts",
    "target_defaults",
    "evidence_classes",
    "explicit_non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.lnf-mpath-coexistence-profile.v1"
    },
    "profile_id": {
      "const": "lnf-mpath-do-no-harm-v1"
    },
    "status": {
      "const": "draft_targets_not_results"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "parent_issue": {
      "const": 212
    },
    "qualification_issue": {
      "const": 222
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "execution_stage": {
      "const": "deterministic_evidence_evaluator_only"
    },
    "standards_basis": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "RFC 6356",
          "RFC 8684"
        ]
      }
    },
    "design_goals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_path_improvement",
        "do_no_harm",
        "resource_pooling"
      ],
      "properties": {
        "best_path_improvement": {
          "type": "string",
          "minLength": 1
        },
        "do_no_harm": {
          "type": "string",
          "minLength": 1
        },
        "resource_pooling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paired_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_digests",
        "required_scalar_identity",
        "all_arms_must_match_identity",
        "mismatched_identity_disposition",
        "implementation_identity_must_be_exact"
      ],
      "properties": {
        "required_digests": {
          "const": [
            "kernel_build_sha256",
            "topology_sha256",
            "qdisc_config_sha256",
            "workload_sha256",
            "impairment_sha256"
          ]
        },
        "required_scalar_identity": {
          "const": [
            "seed",
            "warmup_us",
            "measurement_duration_us",
            "tcp_congestion_control",
            "mptcp_congestion_control",
            "mptcp_scheduler"
          ]
        },
        "all_arms_must_match_identity": {
          "const": true
        },
        "mismatched_identity_disposition": {
          "const": "inconclusive"
        },
        "implementation_identity_must_be_exact": {
          "const": true
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mptcp_kernel_support_required",
        "mptcp_scheduler_support_required",
        "authoritative_negotiation_proof_both_endpoints",
        "minimum_negotiated_subflows",
        "maximum_evaluator_subflows",
        "all_required_counters_required",
        "cleanup_verification_required",
        "unsupported_or_missing_is_not_pass",
        "fixed_point_ratio_unit",
        "statistical_confidence_intervals"
      ],
      "properties": {
        "mptcp_kernel_support_required": {
          "const": true
        },
        "mptcp_scheduler_support_required": {
          "const": true
        },
        "authoritative_negotiation_proof_both_endpoints": {
          "const": true
        },
        "minimum_negotiated_subflows": {
          "const": 2
        },
        "maximum_evaluator_subflows": {
          "const": 64
        },
        "all_required_counters_required": {
          "const": true
        },
        "cleanup_verification_required": {
          "const": true
        },
        "unsupported_or_missing_is_not_pass": {
          "const": true
        },
        "fixed_point_ratio_unit": {
          "const": "parts_per_million"
        },
        "statistical_confidence_intervals": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MPCX-[0-9]{2}$"
      }
    },
    "scenario_definitions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topology",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MPCX-[0-9]{2}$"
          },
          "topology": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "operator",
          "target",
          "target_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MPCX_[A-Z0-9_]{3,80}$"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "==",
              ">=",
              "<="
            ]
          },
          "target": {
            "type": "number"
          },
          "target_status": {
            "const": "proposed_target"
          }
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdicts": {
      "const": [
        "pass",
        "fail",
        "inconclusive",
        "unsupported"
      ]
    },
    "target_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_best_path_min_ratio_ppm",
        "shared_mptcp_max_single_tcp_equivalent_ratio_ppm",
        "shared_companion_min_retention_ratio_ppm",
        "target_status"
      ],
      "properties": {
        "independent_best_path_min_ratio_ppm": {
          "const": 1000000
        },
        "shared_mptcp_max_single_tcp_equivalent_ratio_ppm": {
          "const": 1100000
        },
        "shared_companion_min_retention_ratio_ppm": {
          "const": 900000
        },
        "target_status": {
          "const": "proposed_not_measured"
        }
      }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "deterministic_evaluator",
          "network_namespace_or_vm_emulation",
          "hardware_bench",
          "field_observed"
        ]
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
