{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/integrations/event-triggered-attention-v0.1/watch-request.schema.json",
  "title": "Luminous Event-triggered Watch Request v0.1",
  "description": "Bounded declarative watch request referencing existing CloudEvents/inbox infrastructure; it grants no mutation authority.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "watch_id",
    "task_binding",
    "authority_context",
    "source",
    "condition",
    "policy",
    "resource_budget"
  ],
  "properties": {
    "schema": {
      "const": "luminous-event-watch-request-v0.1"
    },
    "version": {
      "const": 1
    },
    "watch_id": {
      "type": "string",
      "pattern": "^watch-[A-Za-z0-9._-]{1,96}$"
    },
    "task_binding": {
      "type": "object",
      "required": [
        "episode_ref",
        "episode_digest",
        "tenant_ref",
        "principal_ref",
        "session_ref",
        "intent_ref",
        "intent_digest",
        "purpose_ref",
        "purpose_digest",
        "target_ref",
        "target_digest"
      ],
      "properties": {
        "episode_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "episode_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "intent_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "authority_context": {
      "type": "object",
      "required": [
        "xenia_capability_ref",
        "xenia_capability_digest",
        "consent_request_ref",
        "authority_epoch",
        "capability_expires_at",
        "revocation_snapshot_ref",
        "revocation_snapshot_digest"
      ],
      "properties": {
        "xenia_capability_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "xenia_capability_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "consent_request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authority_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "capability_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_snapshot_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revocation_snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source_ref",
        "source_digest",
        "control_domain_ref",
        "event_contract_ref",
        "event_contract_digest",
        "clock_domain_ref",
        "allowed_event_types"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "control_domain_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_contract_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_contract_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "clock_domain_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowed_event_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "max_source_age_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": [
        "condition_ref",
        "condition_digest",
        "language",
        "field_path",
        "operator",
        "expected_value_digest",
        "persistence"
      ],
      "properties": {
        "condition_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "condition_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "language": {
          "const": "bounded_predicate_v1"
        },
        "field_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,256}$"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "greater_than",
            "greater_or_equal",
            "contains",
            "present",
            "absent"
          ]
        },
        "expected_value_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "persistence": {
          "enum": [
            "persistent",
            "ephemeral"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "requested_purpose_ref",
        "action_after_wake",
        "starts_at",
        "expires_at",
        "max_detection_latency_ms",
        "allow_poll_fallback",
        "poll_fallback_min_interval_ms",
        "human_notification_policy"
      ],
      "properties": {
        "requested_purpose_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_after_wake": {
          "enum": [
            "wake_agent",
            "notify_principal",
            "request_human_approval"
          ]
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_detection_latency_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "allow_poll_fallback": {
          "type": "boolean"
        },
        "poll_fallback_min_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000,
          "maximum": 86400000
        },
        "human_notification_policy": {
          "enum": [
            "never",
            "on_match",
            "on_gap_or_revocation",
            "on_match_and_gap"
          ]
        }
      },
      "additionalProperties": false
    },
    "resource_budget": {
      "type": "object",
      "required": [
        "max_event_checks",
        "max_watch_duration_ms",
        "max_wakeups",
        "max_llm_wakeups",
        "max_poll_fallback_per_minute",
        "max_event_bytes"
      ],
      "properties": {
        "max_event_checks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_watch_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "max_wakeups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_llm_wakeups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_poll_fallback_per_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "max_event_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "allow_poll_fallback": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "poll_fallback_min_interval_ms": {
                "type": "integer",
                "minimum": 1000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "allow_poll_fallback": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "poll_fallback_min_interval_ms": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
