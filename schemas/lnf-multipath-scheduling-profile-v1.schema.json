{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/lnf-multipath-scheduling-profile-v1.schema.json",
  "title": "LNF Multipath Session Scheduling Benchmark Profile v1",
  "description": "Strict profile for proposed constrained multipath scheduling benchmarks. Validation is not execution or measurement evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "reviewed_on",
    "objective",
    "ownership_boundary",
    "units",
    "baseline_strategies",
    "transport_profiles",
    "baseline_methodology",
    "scenario_ids",
    "benchmarks",
    "required_metrics",
    "evidence_classes",
    "explicit_non_claims",
    "target_defaults"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.lnf-multipath-scheduling-profile.v1"
    },
    "profile_id": {
      "const": "lnf-multipath-session-scheduling-v1"
    },
    "status": {
      "const": "draft_targets_not_results"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "ownership_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_owns_path_eligibility",
        "path_manager_owns_subflow_and_address_lifecycle",
        "scheduler_owns_packet_or_byte_allocation_only",
        "application_owns_task_success_and_deadline",
        "no_packet_content_inspection",
        "no_privileged_network_actuation"
      ],
      "properties": {
        "broker_owns_path_eligibility": {
          "const": true
        },
        "path_manager_owns_subflow_and_address_lifecycle": {
          "const": true
        },
        "scheduler_owns_packet_or_byte_allocation_only": {
          "const": true
        },
        "application_owns_task_success_and_deadline": {
          "const": true
        },
        "no_packet_content_inspection": {
          "const": true
        },
        "no_privileged_network_actuation": {
          "const": true
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bandwidth",
        "rtt",
        "jitter",
        "loss",
        "cost_rate",
        "energy_rate",
        "data_allowance",
        "reorder_buffer"
      ],
      "properties": {
        "bandwidth": {
          "const": "bits_per_second"
        },
        "rtt": {
          "const": "microseconds"
        },
        "jitter": {
          "const": "microseconds"
        },
        "loss": {
          "const": "parts_per_million"
        },
        "cost_rate": {
          "const": "integer_microcurrency_per_MiB"
        },
        "energy_rate": {
          "const": "microwatt_hours_per_MiB"
        },
        "data_allowance": {
          "const": "bytes"
        },
        "reorder_buffer": {
          "const": "bytes"
        }
      }
    },
    "baseline_strategies": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "best_rtt_single_path",
          "lowest_cost_single_path",
          "capacity_weighted_aggregate",
          "round_robin",
          "earliest_completion_first_ecf",
          "blest_reordering_aware",
          "redundant_retransmission_control",
          "linux_in_tree_default_scheduler_exact_kernel",
          "approved_multipath_quic_stack_when_available",
          "lnf_intent_aware_constrained"
        ]
      }
    },
    "transport_profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "pin_required"
        ],
        "properties": {
          "id": {
            "enum": [
              "mptcp-rfc8684",
              "multipath-quic"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string"
          },
          "pin_required": {
            "const": true
          },
          "peer_support_required": {
            "type": "boolean"
          },
          "scheduler_not_defined_by_transport_document": {
            "type": "boolean"
          }
        }
      }
    },
    "scenario_ids": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MPATH-[0-9]{2}$"
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "operator",
          "target",
          "target_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MPATH_[A-Z0-9_]{3,80}$"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "==",
              "baseline_first",
              "within_declared_buffer_limit"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_status": {
            "enum": [
              "proposed_target",
              "baseline_first"
            ]
          }
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 36,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 36
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "deterministic_model",
          "network_namespace_or_vm_emulation",
          "hardware_bench",
          "field_observed",
          "deterministic_packet_trace_model"
        ]
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduler_implementation_pinning_required",
        "congestion_control_pinning_required",
        "congestion_control_factorial_or_matched_comparison_required",
        "external_scheduler_modules_must_not_be_mislabeled_in_tree",
        "default_scheduler_must_be_identified_from_exact_kernel_source",
        "redundant_transmission_is_separate_reliability_energy_control",
        "same_workload_and_path_trace_required",
        "same_cost_currency_required"
      ],
      "properties": {
        "scheduler_implementation_pinning_required": {
          "const": true
        },
        "congestion_control_pinning_required": {
          "const": true
        },
        "congestion_control_factorial_or_matched_comparison_required": {
          "const": true
        },
        "external_scheduler_modules_must_not_be_mislabeled_in_tree": {
          "const": true
        },
        "default_scheduler_must_be_identified_from_exact_kernel_source": {
          "const": true
        },
        "redundant_transmission_is_separate_reliability_energy_control": {
          "const": true
        },
        "same_workload_and_path_trace_required": {
          "const": true
        },
        "same_cost_currency_required": {
          "const": true
        }
      }
    },
    "target_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_capacity_domain_confidence_floor_ppm",
        "capacity_domain_evidence_floor_status"
      ],
      "properties": {
        "minimum_capacity_domain_confidence_floor_ppm": {
          "const": 950000
        },
        "capacity_domain_evidence_floor_status": {
          "const": "proposed_not_calibrated"
        }
      }
    }
  }
}
