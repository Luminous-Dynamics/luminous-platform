{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/lnf-qdisc-command-plan-v1.schema.json",
  "title": "LNF Qdisc Isolated Command Plan v1",
  "description": "Read-only argv plan for future namespace-isolated qdisc testing. A valid plan is not an executed experiment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "run_suffix",
    "host_interface_route_or_qdisc_mutation",
    "public_network_access",
    "nat_enabled",
    "execution_conducted",
    "namespaces",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.lnf-qdisc-command-plan.v1"
    },
    "profile_id": {
      "const": "lnf-qdisc-namespace-plan-v1"
    },
    "run_suffix": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,8}$"
    },
    "host_interface_route_or_qdisc_mutation": {
      "const": false
    },
    "public_network_access": {
      "const": false
    },
    "nat_enabled": {
      "const": false
    },
    "execution_conducted": {
      "const": false
    },
    "namespaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lnfq-[a-z0-9]{1,8}-(gw|srv|a|b)$"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "parallel_group",
          "artifact_id",
          "guard",
          "program",
          "args"
        ],
        "properties": {
          "phase": {
            "enum": [
              "preflight",
              "setup",
              "workload-server",
              "workload-client",
              "capture",
              "cleanup",
              "post-cleanup-capture"
            ]
          },
          "parallel_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "guard": {
            "type": [
              "string",
              "null"
            ]
          },
          "program": {
            "enum": [
              "uname",
              "ip",
              "tc",
              "iperf3"
            ]
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
