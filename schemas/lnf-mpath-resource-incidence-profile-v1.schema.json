{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/lnf-mpath-resource-incidence-profile-v1.schema.json",
  "title": "LNF MPTCP Resource-Incidence Benchmark Profile v1",
  "description": "Strict deterministic resource allocator profile. Validation is not execution or network evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "reviewed_on",
    "parent_issue",
    "execution_stage",
    "objective",
    "model",
    "scenarios",
    "supported_scenario_ids",
    "baselines",
    "benchmarks",
    "required_metrics",
    "evidence_classes",
    "explicit_non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.lnf-mpath-resource-incidence-profile.v1"
    },
    "profile_id": {
      "const": "lnf-mpath-resource-incidence-v1"
    },
    "status": {
      "const": "draft_targets_not_results"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "parent_issue": {
      "const": 226
    },
    "execution_stage": {
      "const": "deterministic_rust_allocator_only"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_unit",
        "dependency_model",
        "every_path_consumes_all_declared_resources",
        "shared_resource_capacity_is_one_aggregate_ceiling",
        "resource_identity_is_not_failure_domain_identity",
        "unknown_or_incomplete_inventory",
        "algorithm",
        "fixed_point_level_scale",
        "max_paths",
        "max_resources",
        "max_resources_per_path",
        "max_weight",
        "objective_non_claim"
      ],
      "properties": {
        "decision_unit": {
          "const": "candidate_path_rate"
        },
        "dependency_model": {
          "const": "resource_incidence_matrix"
        },
        "every_path_consumes_all_declared_resources": {
          "const": true
        },
        "shared_resource_capacity_is_one_aggregate_ceiling": {
          "const": true
        },
        "resource_identity_is_not_failure_domain_identity": {
          "const": true
        },
        "unknown_or_incomplete_inventory": {
          "const": "caller_must_reject_before_allocation"
        },
        "algorithm": {
          "const": "weighted_max_min_progressive_filling"
        },
        "fixed_point_level_scale": {
          "const": 1000000000000
        },
        "max_paths": {
          "const": 64
        },
        "max_resources": {
          "const": 128
        },
        "max_resources_per_path": {
          "const": 32
        },
        "max_weight": {
          "const": 1000000
        },
        "objective_non_claim": {
          "const": "weighted_max_min_fairness_is_not_maximum_sum_throughput"
        },
        "level_search": {
          "const": "event_driven_weighted_progressive_filling"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topology",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RESINC-[0-9]{2}$"
          },
          "topology": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supported_scenario_ids": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "RESINC-01",
          "RESINC-02",
          "RESINC-03",
          "RESINC-04",
          "RESINC-05",
          "RESINC-06",
          "RESINC-07",
          "RESINC-08",
          "RESINC-09",
          "RESINC-10",
          "RESINC-11",
          "RESINC-12"
        ]
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "conservative_pairwise_disjoint_path_selection",
          "single_best_path_only",
          "equal_weight_max_min_resource_incidence",
          "weighted_max_min_resource_incidence",
          "weighted_proportional_fair_resource_incidence",
          "exact_small_topology_lp_reference",
          "naive_sum_of_per_path_capacities_negative_control"
        ]
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "operator",
          "target",
          "target_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RESINC_[A-Z0-9_]{3,80}$"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "==",
              ">=",
              "baseline_first"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "target_status": {
            "enum": [
              "proposed_target",
              "baseline_first"
            ]
          }
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "deterministic_unit_test",
          "small_topology_lp_reference",
          "network_namespace_or_vm_emulation",
          "hardware_or_field_observed"
        ]
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
