      "target": null,
      "target_status": "baseline_first",
      "evidence_classes": ["bench_measured", "field_observed"],
      "dimensions": ["device_os_profile_ap_firmware_idp_visited_network", "failure_category"]
    },
    {
      "id": "WIFI_HANDOFF_INTERRUPTION_001",
      "domain": "roaming_performance",
      "metric": "active_controlled_application_interruption_during_roam_p95_ms",
      "operator": "baseline_then_set_target",
      "target": null,
      "target_status": "baseline_first",
      "evidence_classes": ["bench_measured", "field_observed"],
