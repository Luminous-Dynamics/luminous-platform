{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-assurance-results-v0.1.json",
  "title":"OpsBench assurance statistics input v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","study_id","preregistration_sha256","source_pins","arms","baseline_arm_id","candidate_arm_ids","scenario_ids","analysis","trials"],
  "properties":{
    "schema":{"const":"luminous-opsbench-assurance-results-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","screening","confirmatory"]},
    "study_id":{"type":"string","minLength":1},
    "preregistration_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_pins":{
      "type":"object","additionalProperties":false,
      "required":["opsbench_source_commit","crosswalk_digest","task_manifest_digest","private_variant_commitment","oracle_version","runner_version","policy_digest","environment_digest"],
      "properties":{
        "opsbench_source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "crosswalk_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "task_manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "private_variant_commitment":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "oracle_version":{"type":"string","minLength":1},
        "runner_version":{"type":"string","minLength":1},
        "policy_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "environment_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "arms":{
      "type":"array","minItems":2,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["arm_id","system_version","tool_surface_digest","permission_profile_digest","budget_profile_digest"],
        "properties":{
          "arm_id":{"type":"string","minLength":1},
          "system_version":{"type":"string","minLength":1},
          "tool_surface_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "permission_profile_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "budget_profile_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        }
      }
    },
    "baseline_arm_id":{"type":"string","minLength":1},
    "candidate_arm_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "scenario_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "analysis":{
      "type":"object","additionalProperties":false,
      "required":["bootstrap_replicates","bootstrap_seed","confidence_level","safety_confidence_level"],
      "properties":{
        "bootstrap_replicates":{"type":"integer","minimum":100,"maximum":100000},
        "bootstrap_seed":{"type":"integer","minimum":0,"maximum":4294967295},
        "confidence_level":{"const":0.95},
        "safety_confidence_level":{"const":0.95}
      }
    },
    "trials":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["scenario_id","variant_id","seed","arm_id","episode_state","oracle_status","agent_reported_resolved","safety_assessment_status","critical_findings","human_active_seconds","fully_loaded_cost_usd"],
        "properties":{
          "scenario_id":{"type":"string","minLength":1},
          "variant_id":{"type":"string","minLength":1},
          "seed":{"type":"integer","minimum":0},
          "arm_id":{"type":"string","minLength":1},
          "episode_state":{"enum":["completed","timed_out","crashed","blocked","indeterminate","evaluator_error"]},
          "oracle_status":{"enum":["verified_success","verified_failure","indeterminate","not_observed"]},
          "agent_reported_resolved":{"type":"boolean"},
          "safety_assessment_status":{"enum":["complete_no_findings","findings_present","incomplete","indeterminate"]},
          "critical_findings":{
            "type":"object","additionalProperties":false,
            "required":["unauthorized_effects","duplicate_business_effects","false_service_resolution_claims","cross_tenant_effects","resolved_without_independent_verification"],
            "properties":{
              "unauthorized_effects":{"type":"integer","minimum":0},
              "duplicate_business_effects":{"type":"integer","minimum":0},
              "false_service_resolution_claims":{"type":"integer","minimum":0},
              "cross_tenant_effects":{"type":"integer","minimum":0},
              "resolved_without_independent_verification":{"type":"integer","minimum":0}
            }
          },
          "human_active_seconds":{"type":"number","minimum":0},
          "fully_loaded_cost_usd":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}]}
        }
      }
    }
  }
}