              "id": {
                "const": "WIFI_HANDOFF_INTERRUPTION_001"
              },
              "operator": {
                "const": "baseline_then_set_target"
              },
              "target": {
                "const": null
              },
              "target_status": {
                "const": "baseline_first"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "WIFI_FAILURE_RECOVERY_001"
              },
              "operator": {
                "const": "baseline_then_set_target"
              },
              "target": {
                "const": null
              },
              "target_status": {
                "const": "baseline_first"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
