{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/hardware-deployment-profile-v1.schema.json",
  "title": "Luminous Hardware Deployment Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "title",
    "as_of",
    "status",
    "deployment_authorization",
    "deployment_class",
    "jurisdiction",
    "permitted_data_classification",
    "purpose",
    "not_for_production",
    "assumptions",
    "design_principles",
    "network",
    "components",
    "pricing_snapshot",
    "acceptance_gates",
    "explicit_non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.hardware-deployment-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "draft_not_qualified"
    },
    "deployment_authorization": {
      "const": false
    },
    "deployment_class": {
      "const": "nonproduction_validation_lab"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "permitted_data_classification": {
      "enum": [
        "public_or_synthetic_only",
        "approved_non_sensitive_test_data",
        "customer_classification_defined"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "not_for_production": {
      "const": true
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_endpoints_min",
        "managed_endpoints_target",
        "managed_endpoints_max",
        "wireless_access_points",
        "primary_site_count",
        "internet_circuit_mbps_target",
        "workload_notes"
      ],
      "properties": {
        "managed_endpoints_min": {
          "type": "integer",
          "minimum": 1
        },
        "managed_endpoints_target": {
          "type": "integer",
          "minimum": 1
        },
        "managed_endpoints_max": {
          "type": "integer",
          "minimum": 1
        },
        "wireless_access_points": {
          "type": "integer",
          "minimum": 0
        },
        "primary_site_count": {
          "type": "integer",
          "minimum": 1
        },
        "internet_circuit_mbps_target": {
          "type": "integer",
          "minimum": 1
        },
        "workload_notes": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "design_principles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inter_vlan_default_policy",
        "remote_administration_requires",
        "management_plane",
        "segments",
        "required_flow_contracts"
      ],
      "properties": {
        "inter_vlan_default_policy": {
          "const": "deny"
        },
        "remote_administration_requires": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "management_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "internet_exposure",
            "cloud_controller_allowed",
            "restriction",
            "recovery_limit"
          ],
          "properties": {
            "internet_exposure": {
              "const": false
            },
            "cloud_controller_allowed": {
              "type": "boolean"
            },
            "restriction": {
              "type": "string",
              "minLength": 20
            },
            "recovery_limit": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "vlan_id",
              "name",
              "internet_egress",
              "purpose"
            ],
            "properties": {
              "segment_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "vlan_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4094
              },
              "name": {
                "type": "string",
                "minLength": 2
              },
              "internet_egress": {
                "type": "boolean"
              },
              "purpose": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        },
        "required_flow_contracts": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to",
              "decision",
              "limits",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "from": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "decision": {
                "enum": [
                  "allow",
                  "deny"
                ]
              },
              "limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "description": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "function",
          "required",
          "quantity",
          "selection_state",
          "catalog_refs",
          "model_candidate",
          "minimum_requirements",
          "blockers"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "function": {
            "type": "string",
            "minLength": 10
          },
          "required": {
            "type": "boolean"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "selection_state": {
            "enum": [
              "candidate_not_approved",
              "unselected",
              "candidate_for_comparison"
            ]
          },
          "catalog_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "model_candidate": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 3
          },
          "candidate_use": {
            "type": "string"
          },
          "minimum_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 6
            }
          },
          "blockers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "pricing_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_on",
        "currency",
        "confidence",
        "price_research",
        "partial_subtotal_min_zar",
        "partial_subtotal_max_zar",
        "included_components",
        "excluded_components",
        "explanation"
      ],
      "properties": {
        "checked_on": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "const": "ZAR"
        },
        "confidence": {
          "const": "marketplace_indicative_not_quote"
        },
        "price_research": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "catalog_ref",
              "minimum_zar",
              "maximum_zar",
              "source_url",
              "configuration_note"
            ],
            "properties": {
              "component_id": {
                "type": "string"
              },
              "catalog_ref": {
                "type": "string"
              },
              "minimum_zar": {
                "type": "number",
                "minimum": 0
              },
              "maximum_zar": {
                "type": "number",
                "minimum": 0
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "configuration_note": {
                "type": "string",
                "minLength": 15
              }
            }
          }
        },
        "partial_subtotal_min_zar": {
          "type": "number",
          "minimum": 0
        },
        "partial_subtotal_max_zar": {
          "type": "number",
          "minimum": 0
        },
        "included_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status",
          "evidence_expected"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence_expected": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    },
    "explicit_non_claims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    }
  }
}
