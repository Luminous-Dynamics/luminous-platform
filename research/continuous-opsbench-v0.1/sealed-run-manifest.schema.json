{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-sealed-run-v0.1.json",
  "title": "Continuous OpsBench frozen run manifest and freeze receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest",
    "freeze_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "continuous-opsbench-sealed-run-v0.1"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "freeze_receipt": {
      "$ref": "#/$defs/freeze_receipt"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_image_digest",
        "source_commit",
        "model_provider",
        "model_id",
        "model_version",
        "scaffold_digest",
        "prompt_digest",
        "toolchain_digest",
        "runtime_config_digest",
        "tool_policy_digest",
        "control_domain"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/id"
        },
        "agent_image_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/git_revision"
        },
        "model_provider": {
          "$ref": "#/$defs/id"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "model_version": {
          "$ref": "#/$defs/id"
        },
        "scaffold_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "tool_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "control_domain": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "image_digest",
        "source_commit",
        "model_id",
        "scaffold_digest",
        "prompt_digest",
        "tool_policy_digest",
        "model_provider",
        "model_version",
        "toolchain_digest",
        "runtime_config_digest",
        "control_domain"
      ],
      "properties": {
        "baseline_id": {
          "$ref": "#/$defs/id"
        },
        "image_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/git_revision"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "scaffold_digest": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "tool_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model_provider": {
          "$ref": "#/$defs/id"
        },
        "model_version": {
          "$ref": "#/$defs/id"
        },
        "toolchain_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_config_digest": {
          "$ref": "#/$defs/sha256"
        },
        "control_domain": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "cluster_id",
        "maximum_attempts",
        "first_arm"
      ],
      "properties": {
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "cluster_id": {
          "$ref": "#/$defs/id"
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "first_arm": {
          "enum": [
            "candidate",
            "baseline"
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "run_id",
        "lane",
        "created_at_ms",
        "frozen_at_ms",
        "evaluator_digest",
        "agent_identity_digest",
        "baseline_identity_digest",
        "agent",
        "baseline",
        "freeze_authority_id",
        "freeze_authority_control_domain",
        "evaluator_control_domain",
        "evidence_source_id",
        "evidence_control_domain",
        "trials",
        "execution_environment_digest",
        "resource_budget_digest",
        "arm_order_schedule_digest",
        "state_isolation_policy_digest",
        "artifact_access_policy_digest",
        "network_egress_policy_digest",
        "runtime_observer_source_id",
        "runtime_observer_control_domain",
        "runtime_observer_adapter_digest",
        "runtime_challenge_authority_id",
        "runtime_challenge_authority_control_domain",
        "sandbox_tier",
        "sandbox_profile_digest",
        "supervisor_id",
        "supervisor_source_id",
        "supervisor_control_domain",
        "supervisor_adapter_digest",
        "supervisor_key_class"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-sealed-run-v0.1"
        },
        "version": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "lane": {
          "enum": [
            "open_development",
            "sealed_certification",
            "retired_reproducibility"
          ]
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "evaluator_digest": {
          "$ref": "#/$defs/sha256"
        },
        "agent_identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "freeze_authority_id": {
          "$ref": "#/$defs/id"
        },
        "freeze_authority_control_domain": {
          "$ref": "#/$defs/id"
        },
        "evaluator_control_domain": {
          "$ref": "#/$defs/id"
        },
        "evidence_source_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_control_domain": {
          "$ref": "#/$defs/id"
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/trial"
          }
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/sha256"
        },
        "resource_budget_digest": {
          "$ref": "#/$defs/sha256"
        },
        "arm_order_schedule_digest": {
          "$ref": "#/$defs/sha256"
        },
        "state_isolation_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_access_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "network_egress_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_challenge_authority_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_challenge_authority_control_domain": {
          "$ref": "#/$defs/id"
        },
        "sandbox_tier": {
          "enum": [
            "research",
            "process",
            "container",
            "micro_vm"
          ]
        },
        "sandbox_profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "supervisor_id": {
          "$ref": "#/$defs/id"
        },
        "supervisor_source_id": {
          "$ref": "#/$defs/id"
        },
        "supervisor_control_domain": {
          "$ref": "#/$defs/id"
        },
        "supervisor_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "supervisor_key_class": {
          "enum": [
            "software_test_only",
            "hardware_protected"
          ]
        }
      }
    },
    "freeze_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "manifest_commitment",
        "committed_at_ms",
        "frozen_at_ms",
        "agent_identity_digest",
        "baseline_identity_digest",
        "evaluator_digest",
        "publisher_id",
        "publisher_control_domain",
        "execution_environment_digest",
        "resource_budget_digest",
        "arm_order_schedule_digest",
        "state_isolation_policy_digest",
        "artifact_access_policy_digest",
        "network_egress_policy_digest",
        "runtime_observer_source_id",
        "runtime_observer_control_domain",
        "runtime_observer_adapter_digest",
        "runtime_challenge_authority_id",
        "runtime_challenge_authority_control_domain",
        "sandbox_tier",
        "sandbox_profile_digest",
        "supervisor_id",
        "supervisor_source_id",
        "supervisor_control_domain",
        "supervisor_adapter_digest",
        "supervisor_key_class"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "manifest_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "committed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "agent_identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "evaluator_digest": {
          "$ref": "#/$defs/sha256"
        },
        "publisher_id": {
          "$ref": "#/$defs/id"
        },
        "publisher_control_domain": {
          "$ref": "#/$defs/id"
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/sha256"
        },
        "resource_budget_digest": {
          "$ref": "#/$defs/sha256"
        },
        "arm_order_schedule_digest": {
          "$ref": "#/$defs/sha256"
        },
        "state_isolation_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_access_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "network_egress_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_challenge_authority_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_challenge_authority_control_domain": {
          "$ref": "#/$defs/id"
        },
        "sandbox_tier": {
          "enum": [
            "research",
            "process",
            "container",
            "micro_vm"
          ]
        },
        "sandbox_profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "supervisor_id": {
          "$ref": "#/$defs/id"
        },
        "supervisor_source_id": {
          "$ref": "#/$defs/id"
        },
        "supervisor_control_domain": {
          "$ref": "#/$defs/id"
        },
        "supervisor_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "supervisor_key_class": {
          "enum": [
            "software_test_only",
            "hardware_protected"
          ]
        }
      }
    }
  }
}
