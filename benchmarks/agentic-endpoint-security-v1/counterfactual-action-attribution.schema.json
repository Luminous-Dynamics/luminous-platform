{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:counterfactual-action-attribution:0.1",
  "title": "Counterfactual Action Attribution Benchmark v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "status",
    "no_aggregate_score",
    "constraints",
    "canonical_effect_owner",
    "effects",
    "intervention_arms",
    "strategy_fingerprint_fields",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "luminous-counterfactual-action-attribution"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_randomized_triplet_contract_not_executed"
    },
    "no_aggregate_score": {
      "const": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "randomized_assignment_required",
        "pre_treatment_state_equivalence_required",
        "isolated_disposable_environment_required",
        "external_network_access",
        "production_endpoints",
        "real_credentials_or_customer_data",
        "synthetic_canaries_only",
        "independent_effect_oracle_required"
      ],
      "properties": {
        "randomized_assignment_required": {
          "const": true
        },
        "pre_treatment_state_equivalence_required": {
          "const": true
        },
        "isolated_disposable_environment_required": {
          "const": true
        },
        "external_network_access": {
          "const": false
        },
        "production_endpoints": {
          "const": false
        },
        "real_credentials_or_customer_data": {
          "const": false
        },
        "synthetic_canaries_only": {
          "const": true
        },
        "independent_effect_oracle_required": {
          "const": true
        }
      }
    },
    "canonical_effect_owner": {
      "const": "CAPC-v0.1"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "intervention_arms": {
      "const": [
        "clean",
        "raw",
        "neutralized"
      ]
    },
    "strategy_fingerprint_fields": {
      "const": [
        "strategy_id",
        "strategy_class",
        "mechanism_class",
        "authority_substitution",
        "source_to_action_route",
        "target_effect_id",
        "causal_chain"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "owner_id",
        "tenant_id",
        "resource_id",
        "operation",
        "effect_class",
        "principal_id",
        "workload_id",
        "session_id",
        "argument_constraint_digest",
        "resource_version_precondition",
        "policy_epoch",
        "service_id",
        "credential_lineage"
      ],
      "properties": {
        "effect_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "effect_class": {
          "type": "string"
        },
        "principal_id": {
          "type": "string"
        },
        "workload_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "argument_constraint_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "resource_version_precondition": {
          "type": "string"
        },
        "policy_epoch": {
          "type": "string"
        },
        "service_id": {
          "type": "string"
        },
        "credential_lineage": {
          "type": "string"
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "strategy_class",
        "mechanism_class",
        "authority_substitution",
        "source_to_action_route",
        "target_effect_id",
        "causal_chain"
      ],
      "properties": {
        "strategy_id": {
          "type": "string"
        },
        "strategy_class": {
          "enum": [
            "attack",
            "control"
          ]
        },
        "mechanism_class": {
          "type": "string"
        },
        "authority_substitution": {
          "type": "string"
        },
        "source_to_action_route": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_effect_id": {
          "type": "string"
        },
        "causal_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "triplet_id",
        "split",
        "arm",
        "randomization",
        "environment",
        "task",
        "source",
        "strategy_candidate",
        "model_trace",
        "execution",
        "admission",
        "oracle",
        "expected",
        "group_expected"
      ],
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "triplet_id": {
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "held_out"
          ]
        },
        "arm": {
          "enum": [
            "clean",
            "raw",
            "neutralized"
          ]
        },
        "randomization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_seed",
            "assignment_order",
            "arm_position",
            "precommitted_receipt"
          ],
          "properties": {
            "assignment_seed": {
              "type": "string"
            },
            "assignment_order": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "clean",
                  "raw",
                  "neutralized"
                ]
              }
            },
            "arm_position": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "precommitted_receipt": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "model_version",
            "system_prompt_digest",
            "tool_contract_digest",
            "runtime_digest",
            "policy_epoch"
          ],
          "properties": {
            "model_id": {
              "type": "string"
            },
            "model_version": {
              "type": "string"
            },
            "system_prompt_digest": {
              "type": "string"
            },
            "tool_contract_digest": {
              "type": "string"
            },
            "runtime_digest": {
              "type": "string"
            },
            "policy_epoch": {
              "type": "string"
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "trusted_task_digest",
            "baseline_effect_id",
            "baseline_argument_digest",
            "authorized_effect_ids",
            "resource_snapshot_id",
            "resource_snapshot_digest"
          ],
          "properties": {
            "task_id": {
              "type": "string"
            },
            "trusted_task_digest": {
              "type": "string"
            },
            "baseline_effect_id": {
              "type": "string"
            },
            "baseline_argument_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "authorized_effect_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "resource_snapshot_id": {
              "type": "string"
            },
            "resource_snapshot_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_source_id",
            "treatment",
            "injection_present",
            "neutralization_applied",
            "artifact_digest",
            "model_input_capture_ref",
            "transformation_digest"
          ],
          "properties": {
            "semantic_source_id": {
              "type": "string"
            },
            "treatment": {
              "enum": [
                "clean",
                "raw",
                "neutralized"
              ]
            },
            "injection_present": {
              "type": "boolean"
            },
            "neutralization_applied": {
              "type": "boolean"
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "model_input_capture_ref": {
              "type": "string"
            },
            "transformation_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "strategy_candidate": {
          "$ref": "#/$defs/fingerprint"
        },
        "model_trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instruction_recognition",
            "evidence_ref"
          ],
          "properties": {
            "instruction_recognition": {
              "enum": [
                "recognized",
                "not_recognized",
                "not_applicable",
                "unknown"
              ]
            },
            "evidence_ref": {
              "type": "string"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted_effect_id",
            "argument_digest",
            "parameter_source",
            "evidence_ref"
          ],
          "properties": {
            "attempted_effect_id": {
              "type": "string"
            },
            "argument_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "parameter_source": {
              "enum": [
                "trusted_task",
                "untrusted_source",
                "mixed",
                "unknown"
              ]
            },
            "evidence_ref": {
              "type": "string"
            }
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "authorized_effect_ids",
            "evidence_ref"
          ],
          "properties": {
            "decision": {
              "enum": [
                "allow",
                "deny",
                "hold",
                "unknown"
              ]
            },
            "authorized_effect_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ref": {
              "type": "string"
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "observed_effect_ids",
            "complete",
            "independent",
            "evidence_ref"
          ],
          "properties": {
            "observation": {
              "enum": [
                "observed",
                "no_effect",
                "unknown",
                "incomplete"
              ]
            },
            "observed_effect_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "complete": {
              "type": "boolean"
            },
            "independent": {
              "type": "boolean"
            },
            "evidence_ref": {
              "type": "string"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_diverged_from_trusted_baseline",
            "unauthorized_effect_observed"
          ],
          "properties": {
            "action_diverged_from_trusted_baseline": {
              "type": "boolean"
            },
            "unauthorized_effect_observed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "group_expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_vs_clean_action_changed",
            "neutralized_vs_clean_action_changed",
            "raw_vs_clean_unauthorized_effect_delta",
            "neutralized_vs_clean_unauthorized_effect_delta",
            "action_causal_attribution",
            "effect_causal_attribution"
          ],
          "properties": {
            "raw_vs_clean_action_changed": {
              "type": "boolean"
            },
            "neutralized_vs_clean_action_changed": {
              "type": "boolean"
            },
            "raw_vs_clean_unauthorized_effect_delta": {
              "type": [
                "integer",
                "null"
              ],
              "enum": [
                -1,
                0,
                1,
                null
              ]
            },
            "neutralized_vs_clean_unauthorized_effect_delta": {
              "type": [
                "integer",
                "null"
              ],
              "enum": [
                -1,
                0,
                1,
                null
              ]
            },
            "action_causal_attribution": {
              "enum": [
                "attributed",
                "not_attributed",
                "indeterminate"
              ]
            },
            "effect_causal_attribution": {
              "enum": [
                "attributed",
                "not_attributed",
                "indeterminate"
              ]
            }
          }
        }
      }
    }
  }
}
