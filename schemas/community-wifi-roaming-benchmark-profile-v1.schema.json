    "explicit_non_claims": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "No claim of OpenRoaming federation membership"
          }
        },
        {
          "contains": {
            "const": "No claim of live roaming credential or identity-provider access"
          }
        },
        {
          "contains": {
            "const": "No claim that an open-source portal conveys federation eligibility"
          }
        },
        {
          "contains": {
            "const": "No claim of free upstream transit or zero-cost internet"
          }
        },
        {
          "contains": {
            "const": "No claim of global coverage or universal handset compatibility"
          }
        },
        {
          "contains": {
            "const": "No claim of seamless roaming until measured for the named flow and device"
          }
        },
        {
          "contains": {
