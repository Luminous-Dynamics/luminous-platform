{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/evidence-manifest-v0.1.schema.json",
  "title": "Luminous Evidence Manifest v0.1",
  "description": "Configuration-bound evidence metadata. Schema validation does not hash artifacts, authenticate issuers, verify signatures or qualify hardware.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_kind",
    "source_reference",
    "created_at_utc",
    "artifact_path",
    "artifact_sha256",
    "configuration_id",
    "configuration_revisions",
    "claim_ceiling",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous-evidence-manifest-v0.1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "SYNTHETIC",
        "ASSUMPTION",
        "VENDOR_REPORTED",
        "ANALYTICAL",
        "SIMULATION",
        "CORRELATED_SIMULATION",
        "HIL",
        "PHYSICAL_MEASUREMENT",
        "INDEPENDENT_LAB_TEST",
        "CERTIFICATION"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/configurationRevision"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurement_context": {
      "$ref": "#/$defs/measurementContext"
    },
    "simulation_context": {
      "$ref": "#/$defs/simulationContext"
    },
    "external_attestation": {
      "$ref": "#/$defs/externalAttestation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "PHYSICAL_MEASUREMENT"
          }
        },
        "required": ["evidence_kind"]
      },
      "then": {
        "required": ["measurement_context"]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "enum": ["SIMULATION", "CORRELATED_SIMULATION"]
          }
        },
        "required": ["evidence_kind"]
      },
      "then": {
        "required": ["simulation_context"]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "HIL"
          }
        },
        "required": ["evidence_kind"]
      },
      "then": {
        "required": ["measurement_context", "simulation_context"]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "enum": ["INDEPENDENT_LAB_TEST", "CERTIFICATION"]
          }
        },
        "required": ["evidence_kind"]
      },
      "then": {
        "required": ["external_attestation"]
      }
    }
  ],
  "$defs": {
    "configurationRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "revision", "role"],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurementContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure_revision",
        "calibration_reference",
        "instrument_ids",
        "instrument_bandwidth_hz",
        "reference_plane_id",
        "clock_domain_id",
        "clock_sync_uncertainty_ns",
        "maximum_allowed_clock_sync_uncertainty_ns"
      ],
      "properties": {
        "procedure_revision": {
          "type": "string",
          "minLength": 1
        },
        "calibration_reference": {
          "type": "string",
          "minLength": 1
        },
        "instrument_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instrument_bandwidth_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_plane_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_sync_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_allowed_clock_sync_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "deembedding_method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "simulationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "solver_id",
        "solver_version",
        "parameter_set_sha256",
        "boundary_conditions_sha256"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "solver_id": {
          "type": "string",
          "minLength": 1
        },
        "solver_version": {
          "type": "string",
          "minLength": 1
        },
        "parameter_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "boundary_conditions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "externalAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "organization", "report_reference"],
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "report_reference": {
          "type": "string",
          "minLength": 1
        },
        "credential_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}