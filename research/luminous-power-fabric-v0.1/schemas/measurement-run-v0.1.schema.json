{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/measurement-run-v0.1.schema.json",
  "title": "Luminous Power Fabric measurement run manifest",
  "description": "Input manifest binding a measurement capture to exact hardware, firmware, procedure, instruments, raw bytes and analysis tool. A valid manifest does not establish physical truth, calibration validity or conformity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_class",
    "run_id",
    "created_at",
    "device",
    "test",
    "environment",
    "instruments",
    "raw_data",
    "analysis",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_class": {
      "enum": [
        "physical_measurement",
        "synthetic_fixture"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "hardware_revision",
        "pcb_revision",
        "bom_sha256",
        "firmware_sha256"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "hardware_revision": {
          "type": "string",
          "minLength": 1
        },
        "pcb_revision": {
          "type": "string",
          "minLength": 1
        },
        "bom_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "firmware_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "power_stage_lot": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure_id",
        "procedure_revision",
        "direction",
        "mode",
        "port_a_nominal_v",
        "port_b_nominal_v",
        "rated_power_w"
      ],
      "properties": {
        "procedure_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure_revision": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "A_TO_B",
            "B_TO_A"
          ]
        },
        "mode": {
          "enum": [
            "steady_state",
            "transient",
            "fault",
            "thermal_screening"
          ]
        },
        "port_a_nominal_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "port_b_nominal_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rated_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "load_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1.5
        },
        "switching_frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "control_configuration_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-fA-F0-9]{64})?$"
        },
        "steady_state_window_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "acceptance_profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient_c",
        "cooling_mode"
      ],
      "properties": {
        "ambient_c": {
          "type": "number",
          "minimum": -40,
          "maximum": 125
        },
        "cooling_mode": {
          "enum": [
            "passive",
            "forced_air",
            "liquid",
            "other",
            "unknown"
          ]
        },
        "airflow_m_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "orientation": {
          "type": "string"
        },
        "relative_humidity_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "role",
          "manufacturer",
          "model",
          "serial_number",
          "calibration_state",
          "uncertainty_value",
          "uncertainty_unit"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "power_analyzer",
              "voltage_probe",
              "current_probe",
              "shunt",
              "temperature_sensor",
              "thermal_camera",
              "timebase",
              "synthetic_generator",
              "other"
            ]
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "serial_number": {
            "type": "string",
            "minLength": 1
          },
          "calibration_state": {
            "enum": [
              "current",
              "expired",
              "unknown",
              "not_applicable"
            ]
          },
          "calibration_certificate_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "calibration_valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "uncertainty_value": {
            "type": "number",
            "minimum": 0
          },
          "uncertainty_unit": {
            "type": "string",
            "minLength": 1
          },
          "bandwidth_hz": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "measurement_range": {
            "type": "string"
          }
        }
      }
    },
    "raw_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "media_type",
        "row_count"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "const": "text/csv"
        },
        "row_count": {
          "type": "integer",
          "minimum": 2
        },
        "header": {
          "type": "string",
          "const": "time_s,port_a_voltage_v,port_a_current_a,port_b_voltage_v,port_b_current_a,case_temp_c"
        },
        "timebase_description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "tool_revision",
        "source_sha256"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "tool_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "configuration_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([a-fA-F0-9]{64})?$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "claim_ceiling"
      ],
      "properties": {
        "status": {
          "enum": [
            "synthetic_not_evidence",
            "pending_review",
            "accepted_for_declared_scope",
            "rejected"
          ]
        },
        "claim_ceiling": {
          "enum": [
            "synthetic_only",
            "bench_measurement_pending_review",
            "bench_measurement_reviewed"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_class": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "record_class"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "const": "synthetic_not_evidence"
              },
              "claim_ceiling": {
                "const": "synthetic_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_class": {
            "const": "physical_measurement"
          }
        },
        "required": [
          "record_class"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "enum": [
                  "pending_review",
                  "accepted_for_declared_scope",
                  "rejected"
                ]
              },
              "claim_ceiling": {
                "enum": [
                  "bench_measurement_pending_review",
                  "bench_measurement_reviewed"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
