{
  "schema": "luminous-service-episode-durability-matrix",
  "version": 1,
  "benchmark": "service-episode-durability",
  "benchmark_version": "0.1",
  "status": "synthetic_evaluator_only_not_runtime_input",
  "scope": "Platform service-episode coordinator persistence and recovery; Nixward retains authoritative host transaction journal and recovery.",
  "claim_ceiling": "E0_E1_contract_and_synthetic_fault_matrix_only",
  "recovery_unit": "episode",
  "external_effect_oracle": {
    "required": true,
    "owner": "participant_owned_server_side_effect_counter_or_equivalent_authoritative_record",
    "independent_of": "coordinator_event_log_and_sut_reported_disposition",
    "purpose": "count committed business effects and reconcile exact attempt identity"
  },
  "invariants": [
    "connector_mutation_requires_durable_exact_intent_commit_ack",
    "no_automatic_external_replay_after_ambiguous_dispatch",
    "attempt_specific_participant_ledger_is_required_to_reconcile_ambiguous_effect",
    "stale_coordinator_writes_are_fenced",
    "valid_history_replay_is_deterministic",
    "corrupt_or_unknown_history_fails_closed",
    "snapshot_must_match_journal_prefix_sequence_and_digest",
    "service_resolution_requires_independent_service_postcondition",
    "compensation_is_a_separately_authorized_attempt",
    "platform_coordinator_journal_does_not_duplicate_nixward_host_journal"
  ],
  "hard_gates": {
    "max_lost_acknowledged_events": 0,
    "max_duplicate_business_effects": 0,
    "max_unauthorized_dispatches": 0,
    "max_automatic_replays_with_unknown_effect": 0,
    "max_stale_owner_commits_after_fence": 0,
    "valid_history_replay_rate_percent": 100,
    "malformed_history_fail_closed_rate_percent": 100,
    "run_binding_correlation_rate_percent": 100
  },
  "initial_targets_not_results": {
    "acknowledged_commit_rpo_events": 0,
    "same_node_restart_rto_p95_ms": 5000,
    "p95_episode_latency_overhead_percent": 10,
    "human_adjudications_per_1000_episodes_max": 1
  },
  "metrics": [
    "durable_commit_latency_ms_p50_p95_p99",
    "event_append_throughput_per_second",
    "replay_events_per_second",
    "restart_to_reconciled_state_ms_p50_p95_p99",
    "journal_bytes_per_episode",
    "snapshot_bytes_and_compaction_cost",
    "duplicate_business_effect_count",
    "lost_acknowledged_event_count",
    "unauthorized_dispatch_count",
    "unknown_attempt_count",
    "human_adjudication_count_and_active_minutes",
    "storage_cost_per_1000_verified_episodes"
  ],
  "baseline_arms": [
    {
      "id": "platform_minimal_coordinator_journal",
      "role": "candidate"
    },
    {
      "id": "temporal_event_history_replay",
      "role": "durable_execution_comparator"
    },
    {
      "id": "dbos_postgres_checkpoint_recovery",
      "role": "database_checkpoint_comparator"
    },
    {
      "id": "in_memory_reference",
      "role": "non_durable_control_only"
    }
  ],
  "comparison_rules": [
    "identical participant contracts, task plan, authority checks, failpoint schedule and independent effect oracle",
    "durability settings and storage hardware must be reported for each arm",
    "workflow history durability does not prove arbitrary external connector effect outcome",
    "no score translation across different task sets, judges, retry policies or failure schedules",
    "separate safety gates from latency, throughput and cost; do not average away a safety failure"
  ],
  "cases": [
    {
      "id": "INTENT-001",
      "family": "intent-boundary",
      "crash_point": "crash_before_intent_append",
      "intent_durability": "absent",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "safe_to_resume",
      "required_gate": "durable_commit_required",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "No external call may occur before a durable intent acknowledgement."
    },
    {
      "id": "INTENT-002",
      "family": "intent-boundary",
      "crash_point": "crash_during_partial_intent_append",
      "intent_durability": "torn",
      "participant_state": "not_sent",
      "journal_state": "torn_tail",
      "expected_recovery": "quarantined",
      "required_gate": "repair_or_restore_journal",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "A torn append is not a committed intent and cannot authorize dispatch."
    },
    {
      "id": "INTENT-003",
      "family": "intent-boundary",
      "crash_point": "commit_succeeded_but_ack_lost",
      "intent_durability": "commit_may_have_succeeded_ack_lost",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "read_durable_journal_before_progress",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Read back the exact event; never infer commit or dispatch from a timeout."
    },
    {
      "id": "DISPATCH-001",
      "family": "pre-dispatch",
      "crash_point": "crash_after_durable_intent_before_connector_call",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "attempt_ledger_then_fresh_authority",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "A durable intent without an observed attempt is not permission to replay automatically."
    },
    {
      "id": "DISPATCH-002",
      "family": "pre-dispatch",
      "crash_point": "crash_while_request_may_be_leaving_coordinator",
      "intent_durability": "committed_acknowledged",
      "participant_state": "may_be_sent",
      "journal_state": "clean",
      "expected_recovery": "outcome_unknown",
      "required_gate": "attempt_specific_ledger",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "The coordinator cannot know whether the remote admission boundary was crossed."
    },
    {
      "id": "ADMISSION-001",
      "family": "participant-admission",
      "crash_point": "participant_rejects_before_admission_reply_lost",
      "intent_durability": "committed_acknowledged",
      "participant_state": "may_be_sent",
      "journal_state": "clean",
      "expected_recovery": "outcome_unknown",
      "required_gate": "attempt_specific_ledger",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "Transport loss does not establish rejection; only participant-owned attempt evidence can."
    },
    {
      "id": "ADMISSION-002",
      "family": "participant-admission",
      "crash_point": "participant_accepts_but_effect_is_pending",
      "intent_durability": "committed_acknowledged",
      "participant_state": "accepted_pending",
      "journal_state": "clean",
      "expected_recovery": "outcome_unknown",
      "required_gate": "wait_or_reconcile_same_attempt",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "Accepted-pending is unresolved and must not be duplicated by a new attempt."
    },
    {
      "id": "ADMISSION-003",
      "family": "participant-admission",
      "crash_point": "participant_effect_commits_response_lost",
      "intent_durability": "committed_acknowledged",
      "participant_state": "effect_committed",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "attempt_ledger_and_independent_effect_oracle",
      "automatic_external_replay": false,
      "expected_effect_count": 1,
      "rationale": "Recover the original logical result; do not create a second business effect."
    },
    {
      "id": "RECEIPT-001",
      "family": "receipt-commit",
      "crash_point": "receipt_received_before_coordinator_event_commit",
      "intent_durability": "committed_acknowledged",
      "participant_state": "receipt_received",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "reconcile_original_attempt_and_commit_receipt",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "The receipt may exist only in volatile memory; fetch it from the participant by attempt identity."
    },
    {
      "id": "RECEIPT-002",
      "family": "receipt-commit",
      "crash_point": "receipt_commit_succeeded_ack_lost",
      "intent_durability": "commit_may_have_succeeded_ack_lost",
      "participant_state": "receipt_received",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "read_journal_and_participant_ledger",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "Resolve whether the receipt event is durable without replaying the operation."
    },
    {
      "id": "FENCE-001",
      "family": "coordinator-fencing",
      "crash_point": "old_owner_writes_after_fencing_token_rotates",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "ownership_changed",
      "expected_recovery": "fenced",
      "required_gate": "durable_fencing_token_or_transactional_cas",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Stale ownership must reject the old writer before it can persist or dispatch."
    },
    {
      "id": "FENCE-002",
      "family": "coordinator-fencing",
      "crash_point": "zombie_coordinator_resumes_after_partition",
      "intent_durability": "committed_acknowledged",
      "participant_state": "may_be_sent",
      "journal_state": "ownership_changed",
      "expected_recovery": "fenced",
      "required_gate": "fence_old_owner_then_reconcile_attempt",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "A live but partitioned process is not a valid owner after a newer fence."
    },
    {
      "id": "FENCE-003",
      "family": "coordinator-fencing",
      "crash_point": "two_coordinators_claim_same_episode",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "ownership_changed",
      "expected_recovery": "fenced",
      "required_gate": "single_winner_cas_and_audit_loser",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Concurrent owners must not both acquire dispatch authority."
    },
    {
      "id": "SNAPSHOT-001",
      "family": "snapshot-replay",
      "crash_point": "snapshot_is_behind_durable_event_tail",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "stale_snapshot",
      "expected_recovery": "safe_to_resume",
      "required_gate": "replay_valid_journal_suffix",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "A stale snapshot is only an optimization miss; valid journal events remain authoritative."
    },
    {
      "id": "SNAPSHOT-002",
      "family": "snapshot-replay",
      "crash_point": "snapshot_checksum_or_chain_digest_mismatch",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "corrupt",
      "expected_recovery": "quarantined",
      "required_gate": "discard_snapshot_replay_valid_log_or_quarantine",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Never apply state from a snapshot whose integrity cannot be established."
    },
    {
      "id": "SNAPSHOT-003",
      "family": "snapshot-replay",
      "crash_point": "crash_during_snapshot_publication",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "stale_snapshot",
      "expected_recovery": "safe_to_resume",
      "required_gate": "use_last_valid_snapshot_and_journal",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Snapshot temp-write/rename/metadata ordering must preserve a prior valid recovery path."
    },
    {
      "id": "SNAPSHOT-004",
      "family": "snapshot-replay",
      "crash_point": "snapshot_last_sequence_matches_but_digest_does_not",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "corrupt",
      "expected_recovery": "quarantined",
      "required_gate": "verify_prefix_digest_and_quarantine",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Sequence equality alone cannot authenticate a snapshot's journal prefix."
    },
    {
      "id": "STORE-001",
      "family": "storage-integrity",
      "crash_point": "disk_full_before_durable_intent_commit",
      "intent_durability": "absent",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "safe_to_resume",
      "required_gate": "free_capacity_then_retry_durable_append",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "No dispatch is allowed when the required intent commit fails."
    },
    {
      "id": "STORE-002",
      "family": "storage-integrity",
      "crash_point": "sync_or_database_commit_returns_error",
      "intent_durability": "commit_may_have_succeeded_ack_lost",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "read_back_transaction_commit_state",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Storage errors can be ambiguous; read back before continuing."
    },
    {
      "id": "STORE-003",
      "family": "storage-integrity",
      "crash_point": "event_digest_corruption_detected_on_replay",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "corrupt",
      "expected_recovery": "quarantined",
      "required_gate": "restore_trusted_backup_and_audit",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "A tampered/corrupt event stream cannot be repaired by guessing."
    },
    {
      "id": "STORE-004",
      "family": "storage-integrity",
      "crash_point": "event_sequence_gap_or_conflicting_duplicate",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "event_gap",
      "expected_recovery": "quarantined",
      "required_gate": "reconcile_replicas_or_operator_adjudication",
      "automatic_external_replay": false,
      "expected_effect_count": 0,
      "rationale": "Missing or conflicting sequence history invalidates deterministic replay."
    },
    {
      "id": "CANCEL-001",
      "family": "compensation-cancellation",
      "crash_point": "cancellation_commit_after_dispatch_in_flight",
      "intent_durability": "committed_acknowledged",
      "participant_state": "may_be_sent",
      "journal_state": "clean",
      "expected_recovery": "outcome_unknown",
      "required_gate": "reconcile_original_attempt_no_new_dispatch",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "Cancellation stops future undispatched work but does not erase an in-flight side effect."
    },
    {
      "id": "COMP-001",
      "family": "compensation-cancellation",
      "crash_point": "crash_after_compensation_intent_before_send",
      "intent_durability": "committed_acknowledged",
      "participant_state": "not_sent",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "verify_compensation_attempt_and_fresh_authority",
      "automatic_external_replay": false,
      "expected_effect_count": null,
      "rationale": "Compensation remains a separate operation with separate authority."
    },
    {
      "id": "COMP-002",
      "family": "compensation-cancellation",
      "crash_point": "compensation_effect_commits_response_lost",
      "intent_durability": "committed_acknowledged",
      "participant_state": "effect_committed",
      "journal_state": "clean",
      "expected_recovery": "reconcile_required",
      "required_gate": "attempt_ledger_and_compensation_postcondition",
      "automatic_external_replay": false,
      "expected_effect_count": null,
