{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/policy-evidence-closure-corpus-v0.1.schema.json",
  "title": "ATR Policy Evidence Closure and Commit-Boundary Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "luminous-policy-evidence-closure-v0.1"
    },
    "status": {
      "const": "synthetic-evidence-closure-corpus-not-runtime-qualification"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "accepted_sources",
        "max_age_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accepted_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dependencies",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "enum": [
            "allow",
            "deny",
            "unknown"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_id",
        "trust_class",
        "source_version",
        "observed_at",
        "status",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_class": {
          "enum": [
            "source_authenticated",
            "candidate",
            "untrusted"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "revoked",
            "unknown",
            "stale"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "description",
        "action",
        "policy",
        "context",
        "facts",
        "preflight",
        "commit",
        "effect",
        "llm_judge",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^PEV-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_digest",
            "actor",
            "principal",
            "tenant",
            "resource",
            "operation",
            "effect_expected"
          ],
          "properties": {
            "request_digest": {
              "type": "string",
              "minLength": 1
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "principal": {
              "type": "string",
              "minLength": 1
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "effect_expected": {
              "enum": [
                "write",
                "none"
              ]
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "policy_version",
            "dependencies",
            "predicates"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dependency"
              }
            },
            "predicates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluated_at",
            "tenant",
            "principal",
            "resource",
            "resource_version",
            "authority_epoch",
            "allowed_actors"
          ],
          "properties": {
            "evaluated_at": {
              "type": "integer"
            },
            "tenant": {
              "type": "string",
              "minLength": 1
            },
            "principal": {
              "type": "string",
              "minLength": 1
            },
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "resource_version": {
              "type": "string",
              "minLength": 1
            },
            "authority_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "allowed_actors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "request_digest",
            "evidence_bundle_digest",
            "dependency_manifest",
            "resource_version",
            "authority_epoch"
          ],
          "properties": {
            "decision": {
              "enum": [
                "allow",
                "deny",
                "indeterminate"
              ]
            },
            "request_digest": {
              "type": "string"
            },
            "evidence_bundle_digest": {
              "type": "string",
              "minLength": 1
            },
            "dependency_manifest": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resource_version": {
              "type": "string",
              "minLength": 1
            },
            "authority_epoch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempted",
            "outcome",
            "request_digest",
            "evidence_bundle_digest",
            "resource_version",
            "current_resource_version",
            "authority_epoch",
            "current_authority_epoch",
            "revalidation_status",
            "revalidated_dependencies",
            "new_attempt_while_unknown"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "outcome": {
              "enum": [
                "not_attempted",
                "committed",
                "denied",
                "unknown",
                "reconciled_absent",
                "reconciled_committed"
              ]
            },
            "request_digest": {
              "type": "string"
            },
            "evidence_bundle_digest": {
              "type": "string"
            },
            "resource_version": {
              "type": "string"
            },
            "current_resource_version": {
              "type": "string"
            },
            "authority_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "current_authority_epoch": {
              "type": "integer",
              "minimum": 0
            },
            "revalidation_status": {
              "enum": [
                "current",
                "drift",
                "unknown"
              ]
            },
            "revalidated_dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "new_attempt_while_unknown": {
              "type": "boolean"
            }
          }
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "actor",
            "tenant",
            "resource",
            "operation",
            "request_digest"
          ],
          "properties": {
            "observed": {
              "type": "boolean"
            },
            "actor": {
              "type": "string"
            },
            "tenant": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "request_digest": {
              "type": "string"
            }
          }
        },
        "llm_judge": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_correctness",
            "authorization_correctness",
            "commitment_correctness",
            "evidence_complete",
            "hard_failure",
            "outcome"
          ],
          "properties": {
            "task_correctness": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "authorization_correctness": {
              "type": "boolean"
            },
            "commitment_correctness": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "evidence_complete": {
              "type": "boolean"
            },
            "hard_failure": {
              "type": "boolean"
            },
            "outcome": {
              "enum": [
                "pass",
                "utility_failure",
                "security_failure",
                "indeterminate"
              ]
            }
          }
        }
      }
    }
  }
}
