{
  "schema_version": "luminous.lnf-multipath-fairness-profile.v1",
  "profile_id": "lnf-multipath-tenant-fairness-v1",
  "status": "draft_targets_not_results",
  "reviewed_on": "2026-11-03",
  "objective": "Measure whether multipath sessions and multi-flow tenants share a common bottleneck fairly while preserving service floors, utilization, tail latency and explicit capacity/failure dependencies.",
  "ownership_boundary": {
    "principal_identity_supplied_by_authenticated_caller": true,
    "allocator_authenticates_principals": false,
    "broker_owns_path_eligibility": true,
    "path_manager_owns_subflow_lifecycle": true,
    "session_scheduler_owns_per_session_path_choice": true,
    "tenant_allocator_owns_shared_bottleneck_rate_budget": true,
    "qdisc_owns_packet_queueing_and_aqm": true,
    "no_packet_content_inspection": true,
    "no_privileged_network_actuation": true
  },
  "domain_semantics": {
    "failure_domain": "declared_common_cause_link_or_site_failure",
    "capacity_domain": "declared_shared_hard_throughput_bottleneck",
    "fairness_principal": "caller_authenticated_tenant_or_household_identity",
    "failure_domain_and_capacity_domain_are_not_interchangeable": true,
    "unknown_capacity_relationship_must_not_be_counted_as_independent_capacity": true,
    "unknown_fairness_principal_is_not_accepted": true
  },
  "units": {
    "capacity": "bits_per_second",
    "demand": "bits_per_second",
    "minimum_service_floor": "bits_per_second",
    "tenant_weight": "positive_integer",
    "flow_weight": "positive_integer",
    "fairness_index": "parts_per_million"
  },
  "allocator": {
    "algorithm": "two_level_integer_weighted_max_min_water_filling",
    "allocation_order": [
      "tenant_principal",
      "flow_within_tenant"
    ],
    "stable_tie_break": "lexicographic_principal_and_flow_id_after_largest_remainder",
    "floors_are_hard_constraints": true,
    "floors_exceed_capacity": "explicit_error_no_partial_report",
    "unused_capacity_when_demand_satisfied": "reported_not_reallocated_beyond_demand",
    "maximum_flow_count": 512,
    "rate_conservation_required": true
  },
  "baselines": [
    "linux_fq_codel_exact_kernel",
    "openwrt_cake_besteffort_exact_kernel",
    "openwrt_cake_diffserv3_exact_kernel",
    "openwrt_cake_diffserv4_exact_kernel",
    "openwrt_cake_triple_isolate_exact_kernel",
    "naive_equal_per_flow",
    "unweighted_max_min_per_flow",
    "weighted_max_min_per_flow",
    "weighted_proportional_fair_reference",
    "lnf_tenant_first_weighted_max_min"
  ],
  "scenario_ids": [
