{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:omsi:manufacturing-benchmark-report:0.1",
  "title": "OMSI Manufacturing Benchmark Report 0.1",
  "description": "Non-gating local microbenchmark observations. This report does not constitute a performance acceptance result.",
  "type": "object",
  "required": [
    "benchmark_contract",
    "status",
    "authority",
    "validator_version",
    "platform",
    "corpus",
    "run",
    "phases",
    "limitations"
  ],
  "properties": {
    "benchmark_contract": {
      "const": "omsi-manufacturing-benchmark-report/0.1"
    },
    "status": {
      "const": "measured_no_acceptance_claim"
    },
    "authority": {
      "const": "performance_observation_only"
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "object",
      "required": ["os", "architecture"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": [
        "format",
        "format_version",
        "sha256",
        "digest_scope",
        "canonicalization",
        "case_count",
        "case_ids",
        "serialized_input_bytes_per_corpus_pass",
        "outcome_counts_per_corpus_pass"
      ],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "format_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "digest_scope": {"const": "exact_vector_document_bytes"},
        "canonicalization": {"const": "none"},
        "case_count": {"type": "integer", "minimum": 1},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "serialized_input_bytes_per_corpus_pass": {
          "type": "integer",
          "minimum": 0
        },
        "outcome_counts_per_corpus_pass": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "iterations_per_case",
        "warmup_iterations_per_case",
        "sample_count_per_phase",
        "input_bytes_per_phase"
      ],
      "properties": {
        "iterations_per_case": {"type": "integer", "minimum": 1},
        "warmup_iterations_per_case": {"type": "integer", "minimum": 1},
        "sample_count_per_phase": {"type": "integer", "minimum": 1},
        "input_bytes_per_phase": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "required": [
        "json_parse",
        "semantic_evaluation",
        "envelope_creation",
        "envelope_verification"
      ],
      "properties": {
        "json_parse": {"$ref": "#/$defs/phase"},
        "semantic_evaluation": {"$ref": "#/$defs/phase"},
        "envelope_creation": {"$ref": "#/$defs/phase"},
        "envelope_verification": {"$ref": "#/$defs/phase"}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "phase",
        "sample_count",
        "total_sampled_time_ns",
        "min_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "max_ns",
        "mean_ns",
        "observations_per_second_from_sampled_time",
        "serialized_input_mib_per_second_from_sampled_time"
      ],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "total_sampled_time_ns": {"type": "string", "pattern": "^[0-9]+$"},
        "min_ns": {"type": "integer", "minimum": 1},
        "p50_ns": {"type": "integer", "minimum": 1},
        "p95_ns": {"type": "integer", "minimum": 1},
        "p99_ns": {"type": "integer", "minimum": 1},
        "max_ns": {"type": "integer", "minimum": 1},
        "mean_ns": {"type": "number", "exclusiveMinimum": 0},
        "observations_per_second_from_sampled_time": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "serialized_input_mib_per_second_from_sampled_time": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
