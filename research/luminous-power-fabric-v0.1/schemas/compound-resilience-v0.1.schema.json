{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/compound-resilience-v0.1.schema.json",
  "title": "Matched compound cyber-physical GFM resilience factorial block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "block_id",
    "expected_physical_disturbance",
    "expected_cyber_manipulation",
    "physical_profile_reference",
    "physical_profile_sha256",
    "cyber_profile_reference",
    "cyber_profile_sha256",
    "physical_event_offset_ms",
    "cyber_event_offset_ms",
    "acceptance",
    "runs",
    "expected_interaction",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "block_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_physical_disturbance": {
      "enum": [
        "weak_grid",
        "symmetrical_fault",
        "negative_sequence_fault",
        "phase_angle_jump",
        "load_step_or_motor_start",
        "source_trip",
        "islanding_or_pcc_transition",
        "black_start"
      ]
    },
    "expected_cyber_manipulation": {
      "enum": [
        "frequency_reference_fdi",
        "voltage_reference_fdi",
        "power_feedback_fdi",
        "pcc_voltage_fdi",
        "breaker_feedback_spoof",
        "command_replay",
        "message_delay_or_reordering",
        "timebase_manipulation",
        "split_brain_leadership",
        "authority_scope_escalation",
        "denial_of_service"
      ]
    },
    "physical_profile_reference": {
      "type": "string",
      "minLength": 1
    },
    "physical_profile_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "cyber_profile_reference": {
      "type": "string",
      "minLength": 1
    },
    "cyber_profile_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "physical_event_offset_ms": {
      "type": "number"
    },
    "cyber_event_offset_ms": {
      "type": "number"
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_reference",
        "criteria_sha256",
        "maximum_unserved_critical_wh",
        "minimum_terminal_reserve_wh",
        "maximum_voltage_deviation_pu",
        "maximum_frequency_deviation_hz",
        "maximum_rocof_hz_per_s",
        "maximum_recovery_duration_ms",
        "maximum_control_deadline_misses",
        "maximum_attack_detection_latency_ms",
        "maximum_mitigation_latency_ms",
        "maximum_false_positive_alerts_per_no_attack_run",
        "maximum_positive_interaction_unserved_wh",
        "maximum_positive_interaction_voltage_pu",
        "maximum_positive_interaction_frequency_hz",
        "maximum_positive_interaction_rocof_hz_per_s",
        "maximum_positive_interaction_recovery_ms",
        "maximum_positive_interaction_reserve_deficit_wh"
      ],
      "properties": {
        "criteria_reference": {
          "type": "string",
          "minLength": 1
        },
        "criteria_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "maximum_unserved_critical_wh": {
          "type": "number",
          "minimum": 0
        },
        "minimum_terminal_reserve_wh": {
          "type": "number",
          "minimum": 0
        },
        "maximum_voltage_deviation_pu": {
          "type": "number",
          "minimum": 0
        },
        "maximum_frequency_deviation_hz": {
          "type": "number",
          "minimum": 0
        },
        "maximum_rocof_hz_per_s": {
          "type": "number",
          "minimum": 0
        },
        "maximum_recovery_duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "maximum_control_deadline_misses": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_attack_detection_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "maximum_mitigation_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "maximum_false_positive_alerts_per_no_attack_run": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_positive_interaction_unserved_wh": {
          "type": "number",
          "minimum": 0
        },
        "maximum_positive_interaction_voltage_pu": {
          "type": "number",
          "minimum": 0
        },
        "maximum_positive_interaction_frequency_hz": {
          "type": "number",
          "minimum": 0
        },
        "maximum_positive_interaction_rocof_hz_per_s": {
          "type": "number",
          "minimum": 0
        },
        "maximum_positive_interaction_recovery_ms": {
          "type": "number",
          "minimum": 0
        },
        "maximum_positive_interaction_reserve_deficit_wh": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "arm",
          "physical_disturbance",
          "cyber_manipulation",
          "physical_event_offset_ms",
          "cyber_event_offset_ms",
          "gfm_profile_id",
          "gfm_cell_id",
          "gfm_test_id",
          "model_profile_id",
          "model_validation_case_id",
          "product_configuration_sha256",
          "product_hardware_sha256",
          "firmware_sha256",
          "controller_configuration_sha256",
          "protection_configuration_sha256",
          "topology_sha256",
          "model_sha256",
          "analysis_build_sha256",
          "site_profile_sha256",
          "scenario_seed_sha256",
          "initial_state_id",
          "initial_state_epoch",
          "initial_soc_fraction",
          "timebase_reference",
          "observation_window_sha256",
          "acceptance_criteria_sha256",
          "physical_profile_sha256",
          "cyber_profile_sha256",
          "transition_ids",
          "execution_mode",
          "evidence",
          "outcome"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "arm": {
            "enum": [
              "baseline",
              "physical_only",
              "cyber_only",
              "compound"
            ]
          },
          "physical_disturbance": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "weak_grid",
              "symmetrical_fault",
              "negative_sequence_fault",
              "phase_angle_jump",
              "load_step_or_motor_start",
              "source_trip",
              "islanding_or_pcc_transition",
              "black_start",
              null
            ]
          },
          "cyber_manipulation": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "frequency_reference_fdi",
              "voltage_reference_fdi",
              "power_feedback_fdi",
              "pcc_voltage_fdi",
              "breaker_feedback_spoof",
              "command_replay",
              "message_delay_or_reordering",
              "timebase_manipulation",
              "split_brain_leadership",
              "authority_scope_escalation",
              "denial_of_service",
              null
            ]
          },
          "physical_event_offset_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "cyber_event_offset_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "gfm_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "gfm_cell_id": {
            "type": "string",
            "minLength": 1
          },
          "gfm_test_id": {
            "type": "string",
            "minLength": 1
          },
          "model_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "model_validation_case_id": {
            "type": "string",
            "minLength": 1
          },
          "product_configuration_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "product_hardware_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "firmware_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "controller_configuration_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "protection_configuration_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "topology_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "analysis_build_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "site_profile_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "scenario_seed_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "initial_state_id": {
            "type": "string",
            "minLength": 1
          },
          "initial_state_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "initial_soc_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "timebase_reference": {
            "type": "string",
            "minLength": 1
          },
          "observation_window_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "acceptance_criteria_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "physical_profile_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "cyber_profile_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "transition_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_mode": {
            "enum": [
              "emt_simulation",
              "controller_hil",
              "power_hil",
              "physical_laboratory",
              "site_commissioning",
              "field_operation"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "class",
              "dataset_sha256",
              "raw_data_sha256",
              "calibration_receipt_reference",
              "timebase_reference",
              "independent_witness_reference",
              "result_bundle_reference"
            ],
            "properties": {
              "status": {
                "enum": [
                  "current",
                  "expired",
                  "revoked",
                  "unknown"
                ]
              },
              "class": {
                "enum": [
                  "synthetic",
                  "modelled",
                  "measured",
                  "accredited"
                ]
              },
              "dataset_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "raw_data_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "calibration_receipt_reference": {
                "type": "string",
                "minLength": 1
              },
              "timebase_reference": {
                "type": "string",
                "minLength": 1
              },
              "independent_witness_reference": {
                "type": "string",
                "minLength": 1
              },
              "result_bundle_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "critical_service_unserved_wh",
              "terminal_reserve_wh",
              "maximum_abs_voltage_deviation_pu",
              "maximum_abs_frequency_deviation_hz",
              "maximum_rocof_hz_per_s",
              "recovery_duration_ms",
              "attack_detected",
              "mitigation_succeeded",
              "attack_detection_latency_ms",
              "mitigation_latency_ms",
              "false_positive_alert_count",
              "control_deadline_miss_count",
              "protection_actions_correct",
              "forbidden_transitions_observed",
              "unknown_state_mutations",
              "post_state_id",
              "post_state_evidence_sha256"
            ],
            "properties": {
              "critical_service_unserved_wh": {
                "type": "number",
                "minimum": 0
              },
              "terminal_reserve_wh": {
                "type": "number",
                "minimum": 0
              },
              "maximum_abs_voltage_deviation_pu": {
                "type": "number",
                "minimum": 0
              },
              "maximum_abs_frequency_deviation_hz": {
                "type": "number",
                "minimum": 0
              },
              "maximum_rocof_hz_per_s": {
                "type": "number",
                "minimum": 0
              },
              "recovery_duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "attack_detected": {
                "type": "boolean"
              },
              "mitigation_succeeded": {
                "type": "boolean"
              },
              "attack_detection_latency_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "mitigation_latency_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "false_positive_alert_count": {
                "type": "integer",
                "minimum": 0
              },
              "control_deadline_miss_count": {
                "type": "integer",
                "minimum": 0
              },
              "protection_actions_correct": {
                "type": "boolean"
              },
              "forbidden_transitions_observed": {
                "type": "integer",
                "minimum": 0
              },
              "unknown_state_mutations": {
                "type": "integer",
                "minimum": 0
              },
              "post_state_id": {
                "type": "string",
                "minLength": 1
              },
              "post_state_evidence_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "expected_interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unserved_critical_wh",
        "voltage_deviation_pu",
        "frequency_deviation_hz",
        "rocof_hz_per_s",
        "recovery_duration_ms",
        "terminal_reserve_deficit_wh"
      ],
      "properties": {
        "unserved_critical_wh": {
          "type": "number"
        },
        "voltage_deviation_pu": {
          "type": "number"
        },
        "frequency_deviation_hz": {
          "type": "number"
        },
        "rocof_hz_per_s": {
          "type": "number"
        },
        "recovery_duration_ms": {
          "type": "number"
        },
        "terminal_reserve_deficit_wh": {
          "type": "number"
        }
      }
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_OR_STRUCTURAL_COMPOUND_RESILIENCE_QUALIFICATION_ONLY_NOT_HIL_OR_FIELD_CLAIM"
    }
  }
}
