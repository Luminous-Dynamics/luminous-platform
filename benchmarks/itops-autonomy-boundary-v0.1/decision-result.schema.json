  "allOf": [
    {
      "if": {
        "properties": {
          "task_binding": {
            "properties": {
              "delegation_required": {
                "const": true
              }
            },
            "required": [
              "delegation_required"
            ]
          }
        },
        "required": [
          "task_binding"
        ]
      },
      "then": {
        "required": [
          "delegation"
        ]
      }
    }
  ]
