            "root_principal_ref": {
              "type": "string",
              "minLength": 1
            },
            "root_task_id": {
              "type": "string",
              "minLength": 1
            },
            "root_task_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
