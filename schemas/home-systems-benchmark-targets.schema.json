{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/home-systems-benchmark-targets.schema.json",
  "title": "Sovereign home systems benchmark target catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_ceiling",
    "benchmarks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "targets_not_results"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "benchmarks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/benchmark"
      }
    }
  },
  "$defs": {
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "operator": {
          "enum": [
            "equals",
            "at_least",
            "at_most"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "metric",
        "threshold",
        "workload",
        "method",
        "sample_plan",
        "release_gate",
        "measurement_status",
        "evidence_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "conformance",
            "safety",
            "interoperability",
            "performance",
            "resilience",
            "recovery",
            "privacy",
            "portability",
            "lifecycle"
          ]
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "sample_plan": {
          "type": "string",
          "minLength": 1
        },
        "release_gate": {
          "type": "boolean"
        },
        "measurement_status": {
          "enum": [
            "not_measured",
            "blocked_runtime_not_ready",
            "in_progress",
            "measured_pass",
            "measured_fail"
          ]
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
