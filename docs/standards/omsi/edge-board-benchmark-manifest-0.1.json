  "scenarios": [
    {
      "id": "EDGE-001",
      "purpose": "Nominal frozen sensor windows.",
      "stimulus": "nominal_input",
      "expected_behavior": "process_with_receipt",
      "non_compensatory": true
    },
    {
      "id": "EDGE-002",
      "purpose": "Required sensor disappears or calibration becomes absent.",
      "stimulus": "sensor_missing",
      "expected_behavior": "mark_measurement_unknown",
      "non_compensatory": true
    },
    {
      "id": "EDGE-003",
      "purpose": "Sensor is stuck or saturated while model confidence remains high.",
      "stimulus": "sensor_stuck_or_saturated",
      "expected_behavior": "reject_reliance_and_abstain",
      "non_compensatory": true
    },
    {
      "id": "EDGE-004",
      "purpose": "Calibration interval is expired for the exact sensor identity.",
      "stimulus": "calibration_expired",
      "expected_behavior": "reject_reliance_and_abstain",
      "non_compensatory": true
    },
    {
      "id": "EDGE-005",
      "purpose": "Device reboots or time correlation is absent.",
      "stimulus": "clock_reset_or_uncorrelated",
      "expected_behavior": "mark_measurement_unknown",
      "non_compensatory": true
    },
    {
      "id": "EDGE-006",
      "purpose": "Feature window lies outside the supported model distribution.",
      "stimulus": "model_ood",
      "expected_behavior": "reject_reliance_and_abstain",
      "non_compensatory": true
    },
    {
      "id": "EDGE-007",
      "purpose": "WAN, DNS and central platform are unavailable.",
      "stimulus": "network_partition",
      "expected_behavior": "continue_local_and_buffer",
      "non_compensatory": true
    },
    {
      "id": "EDGE-008",
      "purpose": "Ring buffer reaches its declared capacity.",
      "stimulus": "buffer_overflow",
      "expected_behavior": "report_sample_loss",
      "non_compensatory": true
    },
    {
      "id": "EDGE-009",
      "purpose": "Power loss occurs during firmware update.",
      "stimulus": "power_loss_during_update",
      "expected_behavior": "reject_firmware_and_recover",
      "non_compensatory": true
    },
    {
      "id": "EDGE-010",
      "purpose": "Unsigned, stale or replayed firmware package is presented.",
      "stimulus": "unsigned_or_replayed_firmware",
      "expected_behavior": "reject_firmware_and_recover",
      "non_compensatory": true
    },
    {
      "id": "EDGE-011",
      "purpose": "Quantization changes a decision across the declared threshold.",
      "stimulus": "quantization_threshold_flip",
      "expected_behavior": "mark_quantization_regression",
      "non_compensatory": true
    },
    {
      "id": "EDGE-012",
      "purpose": "A model or process attempts to export raw data without authorization.",
      "stimulus": "raw_data_export_attempt",
      "expected_behavior": "deny_export",
      "non_compensatory": true
    }
  ],
