{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/edge-policy-verification-challenge-v1.schema.json",
  "title": "Luminous Edge Verification Challenge v1",
  "description": "Verifier-originated one-time freshness challenge. The nonce must be generated from a cryptographically secure random source by the verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "challenge_id",
    "nonce",
    "issued_at_unix_ms",
    "expires_at_unix_ms",
    "max_receipt_age_ms",
    "policy_generation",
    "corpus_sha256",
    "approved_policy_sha256",
    "target_token"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "challenge_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "32-byte verifier-generated cryptographically random nonce, hex encoded."
    },
    "issued_at_unix_ms": { "type": "integer", "minimum": 0 },
    "expires_at_unix_ms": { "type": "integer", "minimum": 0 },
    "max_receipt_age_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "policy_generation": { "type": "integer", "minimum": 1 },
    "corpus_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approved_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_token": { "type": "string", "pattern": "^target-[a-z0-9-]{1,48}$" }
  }
}
