{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-observer-calibration-bundle-v0.1.json",
  "title": "Continuous OpsBench observer calibration evidence bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plans",
    "injections",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "const": "continuous-opsbench-observer-calibration-bundle-v0.1"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "injections": {
      "type": "array",
      "maxItems": 10000000,
      "items": {
        "$ref": "#/$defs/injection"
      }
    },
    "detections": {
      "type": "array",
      "maxItems": 10000000,
      "items": {
        "$ref": "#/$defs/detection"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "channel": {
      "enum": [
        "process_lifecycle",
        "executable_load",
        "file_object_access",
        "mount_namespace",
        "policy_denied_operation",
        "resource_control",
        "dns_egress",
        "cross_trial_state",
        "telemetry_pipeline"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "trial_id",
        "arm",
        "manifest_commitment",
        "scenario_commitment",
        "arm_identity_digest",
        "runtime_instance_digest",
        "observer_source_id",
        "observer_control_domain",
        "observer_adapter_digest",
        "challenge_authority_id",
        "challenge_authority_control_domain",
        "challenge_id_digest",
        "probe_suite_digest",
        "issued_at_ms",
        "expires_at_ms",
        "expected_probes"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-calibration-v0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trial_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm": {
          "enum": [
            "candidate",
            "baseline"
          ]
        },
        "manifest_commitment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scenario_commitment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "arm_identity_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_instance_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observer_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observer_control_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observer_adapter_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "challenge_authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "challenge_authority_control_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "challenge_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "probe_suite_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expected_probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/expected_probe"
          }
        }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "trial_id",
        "arm",
        "challenge_id_digest",
        "probe_id_digest",
        "runtime_instance_digest",
        "channel",
        "target_digest",
        "status",
        "injected_at_ms",
        "injector_clock_uncertainty_ms",
        "injection_event_commitment",
        "injector_source_id",
        "injector_control_domain"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-calibration-v0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trial_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm": {
          "enum": [
            "candidate",
            "baseline"
          ]
        },
        "challenge_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "probe_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_instance_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "channel": {
          "enum": [
            "process_lifecycle",
            "executable_load",
            "file_object_access",
            "mount_namespace",
            "policy_denied_operation",
            "resource_control",
            "dns_egress",
            "cross_trial_state",
            "telemetry_pipeline"
          ]
        },
        "target_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "injected",
            "not_injected"
          ]
        },
        "injected_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "injector_clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "injection_event_commitment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "injector_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "injector_control_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "trial_id",
        "arm",
        "challenge_id_digest",
        "probe_id_digest",
        "runtime_instance_digest",
        "observer_source_id",
        "observer_control_domain",
        "observer_adapter_digest",
        "observation"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-calibration-v0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trial_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm": {
          "enum": [
            "candidate",
            "baseline"
          ]
        },
        "challenge_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "probe_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_instance_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observer_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observer_control_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observer_adapter_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "not_detected"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "channel",
                "target_digest",
                "decision",
                "detected_at_ms",
                "event_sequence",
                "event_commitment"
              ],
              "properties": {
                "kind": {
                  "const": "detected"
                },
                "channel": {
                  "enum": [
                    "process_lifecycle",
                    "executable_load",
                    "file_object_access",
                    "mount_namespace",
                    "policy_denied_operation",
                    "resource_control",
                    "dns_egress",
                    "cross_trial_state",
                    "telemetry_pipeline"
                  ]
                },
                "target_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "decision": {
                  "enum": [
                    "allowed",
                    "forbidden",
                    "unknown"
                  ]
                },
                "detected_at_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "event_sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "event_commitment": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "expected_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id_digest",
        "channel",
        "expected_decision",
        "target_digest",
        "probe_cluster_digest",
        "maximum_detection_latency_ms"
      ],
      "properties": {
        "probe_id_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "channel": {
          "enum": [
            "process_lifecycle",
            "executable_load",
            "file_object_access",
            "mount_namespace",
            "policy_denied_operation",
            "resource_control",
            "dns_egress",
            "cross_trial_state",
            "telemetry_pipeline"
          ]
        },
        "expected_decision": {
          "enum": [
            "allowed",
            "forbidden"
          ]
        },
        "target_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "probe_cluster_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "maximum_detection_latency_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
