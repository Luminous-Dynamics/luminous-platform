{
  "schema_version": "luminous.community-wifi-roaming-benchmark-profile.v1",
  "profile_id": "community-wifi-roaming-openroaming-v1",
  "status": "draft_research_only",
  "reviewed_at": "2026-10-18",
  "authority": {
    "issue": "https://github.com/Luminous-Dynamics/luminous-platform/issues/65",
    "design_document": "docs/COMMUNITY_WIFI_ROAMING_OPENROAMING_RFC_V1.md"
  },
  "deployment_gates": {
    "federation_membership_status": "not_verified",
    "identity_provider_credentials_status": "not_obtained",
    "upstream_sharing_permission_status": "not_verified",
    "regulatory_review_status": "not_verified",
    "equipment_type_approval_status": "not_verified",
    "deployment_blocked_until_gates_verified": true,
    "local_only_access_must_not_require_wan": true,
    "payload_inspection_for_routing": false,
    "credential_validation_must_fail_closed": true
  },
  "comparison_contract": {
    "device_os_profile_and_site_scope_must_be_named": true,
    "unsupported_and_failed_attempts_remain_in_denominator": true,
    "simulation_must_not_be_reported_as_field_evidence": true,
    "raw_credentials_and_payloads_must_not_be_in_public_receipts": true,
    "targets_without_field_baselines_remain_baseline_first": true,
    "source_and_configuration_revisions_must_be_immutable": true
  },
  "benchmarks": [
    {
      "id": "WIFI_AUTH_INVALID_CERT_REJECT_001",
      "domain": "authentication_security",
      "metric": "successful_authentications_using_invalid_expired_or_untrusted_test_server_certificate",
      "operator": "==",
      "target": 0,
      "target_status": "proposed_target",
      "evidence_classes": ["unit_contract_tested", "bench_measured"],
      "negative_cases": ["expired_certificate", "untrusted_ca", "wrong_server_name", "stale_trust_store"]
    },
    {
      "id": "WIFI_AUTH_REALM_REJECT_001",
      "domain": "authentication_security",
      "metric": "successful_or_secret_disclosing_attempts_to_wrong_realm_or_unauthorized_aaa",
      "operator": "==",
      "target": 0,
      "target_status": "proposed_target",
      "evidence_classes": ["unit_contract_tested", "bench_measured"],
      "negative_cases": ["wrong_realm", "unauthorized_aaa", "unsupported_eap_method"]
    },
    {
      "id": "WIFI_SECRET_EXPOSURE_001",
      "domain": "privacy",
      "metric": "private_keys_passwords_payloads_browsing_history_or_subscriber_identifiers_in_public_receipts",
      "operator": "==",
      "target": 0,
      "target_status": "proposed_target",
      "evidence_classes": ["static_checked", "unit_contract_tested"]
    },
    {
      "id": "WIFI_TIME_TO_USABLE_IP_001",
      "domain": "roaming_performance",
      "metric": "arrival_trigger_to_authenticated_ip_and_successful_controlled_https_task_p95_ms",
      "operator": "baseline_then_set_target",
      "target": null,
      "target_status": "baseline_first",
      "evidence_classes": ["bench_measured", "field_observed"],
      "dimensions": ["median_ms", "p95_ms", "p99_ms", "eligible_attempts", "failed_attempts", "device_model", "os_build", "credential_profile"]
    },
    {
      "id": "WIFI_FIRST_ATTEMPT_AUTH_001",
      "domain": "roaming_performance",
      "metric": "eligible_full_8021x_to_usable_ip_sessions_succeeding_on_first_attempt_fraction",
