{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/preregistered-superiority-v0.1.schema.json",
  "title": "Preregistered lifecycle superiority plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "comparator_set_id",
    "reference_candidate_id",
    "candidate_ids",
    "service_boundary_id",
    "site_profile_sha256",
    "mission_set_sha256",
    "scenario_manifest_sha256",
    "initial_terminal_obligation_sha256",
    "primary_metric",
    "direction",
    "family_wise_alpha",
    "minimum_meaningful_improvement",
    "bootstrap_algorithm",
    "resampling_unit",
    "measurement_uncertainty",
    "expected_adjusted_confidence_level",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "comparator_set_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "service_boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "site_profile_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "mission_set_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "scenario_manifest_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "initial_terminal_obligation_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "primary_metric": {
      "enum": [
        "cost_per_delivered_critical_kwh",
        "unserved_critical_service_wh",
        "system_unavailable_hours"
      ]
    },
    "direction": {
      "const": "lower_is_better"
    },
    "family_wise_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.5
    },
    "minimum_meaningful_improvement": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bootstrap_algorithm": {
      "const": "PAIRED_CLUSTER_PERCENTILE_BOOTSTRAP_SPLITMIX64_V0_1"
    },
    "resampling_unit": {
      "const": "DECLARED_INDEPENDENT_MISSION_SITE_EVENT_CLUSTER"
    },
    "measurement_uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "metric",
          "absolute_bound",
          "bound_kind",
          "evidence_status",
          "evidence_class",
          "method_reference",
          "evidence_reference"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "enum": [
              "cost_per_delivered_critical_kwh",
              "unserved_critical_service_wh",
              "system_unavailable_hours"
            ]
          },
          "absolute_bound": {
            "type": "number",
            "minimum": 0
          },
          "bound_kind": {
            "const": "conservative_absolute_bound"
          },
          "evidence_status": {
            "const": "current"
          },
          "evidence_class": {
            "enum": [
              "independent_physical_measurement",
              "analytical_model"
            ]
          },
          "method_reference": {
            "type": "string",
            "minLength": 1
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_adjusted_confidence_level": {
      "type": "number",
      "exclusiveMinimum": 0.5,
      "exclusiveMaximum": 1
    },
    "claim_ceiling": {
      "const": "PREREGISTERED_SUPERIORITY_SCREEN_ONLY_NOT_FIELD_SUPERIORITY_OR_EQUIVALENCE"
    }
  }
}
