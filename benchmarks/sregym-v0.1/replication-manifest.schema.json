                "pattern": "^[0-9a-f]{64}$"
              },
              "scanned_at": {
                "type": "string",
                "format": "date"
              },
              "examined_sources": {
                "minItems": 8
              }
            }
          },
          "upstream": {
            "properties": {
              "tree_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "image_lock": {
            "properties": {
              "external_reference_scan_state": {
                "const": "passed"
              },
              "external_reference_scan_report_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "digest_pinned_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scenario_inventory": {
                  "properties": {
                    "suite": {
                      "const": "full"
                    }
                  },
                  "required": [
                    "suite"
                  ]
                }
              },
              "required": [
                "scenario_inventory"
              ]
            },
            "then": {
              "properties": {
                "runtime": {
                  "properties": {
                    "cluster_profile": {
                      "const": "self_managed_linux"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
