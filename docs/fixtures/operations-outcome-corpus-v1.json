{
  "schema_version": "1.0.0",
  "status": "synthetic_proposal",
  "description": "Expected dispositions for synthetic cross-component operational outcome scenarios; not implementation or execution evidence.",
  "source_contracts": [
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/5",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/7",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/10",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/33",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/42",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/43",
    "https://github.com/Luminous-Dynamics/luminous-platform/issues/44"
  ],
  "scenarios": [
    {
      "id": "authorized_change_verified",
      "category": "positive",
      "stage": "end_to_end",
      "setup": [
        "Approved immutable manifest and unexpired grant match target pre-state."
      ],
      "stimulus": "Execute in disposable sandbox, independently observe post-state.",
      "expected": {
        "disposition": "allow_and_verify",
        "max_primary_effects": 1,
        "max_recovery_attempts": 0,
        "fresh_observation_required": true,
        "retry_policy": "same_operation_only",
        "preserve_preexisting_state": false,
        "forbidden_claims": [
          "verified_before_post_state_observation"
        ]
      },
      "metrics": [
        "end_to_end_latency",
        "receipt_retrieval_latency"
      ]
    },
    {
      "id": "duplicate_event_same_content",
      "category": "idempotency",
      "stage": "ingress",
      "setup": [
        "Event already committed for same authenticated source and event ID."
      ],
      "stimulus": "Redeliver identical semantic content, including concurrency.",
      "expected": {
        "disposition": "deduplicate",
        "max_primary_effects": 1,
        "max_recovery_attempts": 0,
        "fresh_observation_required": false,
        "retry_policy": "same_operation_only",
        "preserve_preexisting_state": true,
        "forbidden_claims": [
          "second_business_effect"
        ]
      },
      "metrics": [
        "duplicate_suppression_rate"
      ]
    },
    {
      "id": "event_identity_content_conflict",
      "category": "negative",
      "stage": "ingress",
      "setup": [
        "Committed event ID is reused with changed semantic content."
      ],
      "stimulus": "Submit changed event.",
      "expected": {
        "disposition": "conflict",
        "max_primary_effects": 1,
        "max_recovery_attempts": 0,
        "fresh_observation_required": false,
        "retry_policy": "prohibited",
        "preserve_preexisting_state": true,
        "forbidden_claims": [
          "silently_overwrite_original_event"
        ]
      },
      "metrics": [
        "conflict_detection_latency"
      ]
    },
    {
