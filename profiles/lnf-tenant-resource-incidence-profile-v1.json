  "issue": 247,
  "parent_issue": 226,
  "parent_resource_allocator_pr": 230,
  "objective": "Allocate shared multi-resource capacity fairly by authenticated tenant principal, then by flow weight, then by path split weight, while respecting every shared resource ceiling and per-tenant minimum service floor.",
  "ownership_boundary": "Pure Rust deterministic planning model. Tenant authentication, resource discovery, evidence collection and router/transport actuation remain external. Reuses the evidence-bound resource inventory validator; this module does not implement another inventory source.",
  "algorithm": {
    "name": "tenant_first_weighted_progressive_filling_with_normalized_flow_and_path_weights",
    "hierarchy": [
      "tenant_principal",
      "flow_within_tenant",
      "path_within_flow"
    ],
    "numeric_representation": "checked_u128_fixed_point_then_integer_bps_largest_remainder",
    "weight_scale": 1000000000000,
    "rate_denominator": 1000000000000000000,
    "max_tenants": 64,
    "max_flows": 256,
    "max_paths": 64,
    "max_paths_per_flow": 8,
    "max_resources": 64,
    "max_capacity_domains_per_path": 32,
    "max_tenant_weight": 1000000,
    "max_flow_weight": 1000,
    "max_path_split_weight": 1000,
    "path_ceiling_is_hard": true,
    "flow_demand_is_hard": true,
    "resource_capacity_is_one_shared_aggregate_constraint": true,
    "tenant_weight_normalization": "For each tenant, the sum of effective path weights over its active flows and paths is exactly tenant_weight * weight_scale; flow and path multiplicity cannot increase the tenant's aggregate entitlement.",
    "progressive_filling": "All eligible active tenants first progress toward declared minimum service floors. Tenants whose floors are met leave the floor phase. Then the same tenant-normalized weights govern the remaining weighted max-min allocation. Path, flow and resource bottlenecks freeze only affected path variables; surviving variables are renormalized deterministically.",
    "residual_capacity_formula": "declared_capacity_bps - measured_background_load_bps - committed_reservations_bps - safety_margin_bps",
    "floor_policy": "Minimum service floors are aggregate per tenant, may not exceed aggregate demand, and must be met or the solve returns explicit infeasible.",
    "objective": "tenant_weighted_max_min_then_flow_weighted_max_min_over_shared_resource_incidence_not_global_sum_rate_optimum",
    "exact_reference": "Independent integer exhaustive enumeration for frozen small-topology oracle fixtures only; not a general production LP solver."
  },
  "evidence_contract": {
    "reuse_existing_resource_evidence_validator": true,
    "resource_validator_source": "tools/connectivity-multipath-policy-core/src/resource.rs::validate_resource_inventory",
    "topology_digest_must_match_request": true,
    "inventory_digest_sha256_required": true,
    "completeness_required": true,
    "confidence_floor_required": true,
    "validity_window_required": true,
    "resource_residual_must_be_nonnegative": true,
    "unknown_or_invalid_resource_excludes_dependent_paths": true,
    "tenant_principal_id_required": true,
    "tenant_identity_authenticated_by_this_module": false,
    "caller_must_bind_principal_to_authenticated_identity": true,
    "duplicate_tenant_flow_path_resource_ids_rejected": true,
    "resource_snapshot_digest": "caller_computed_digest_echoed_in_report_not_independently_authenticated_or_recomputed",
    "unknown_tenant_or_flow_reference": "hard_error",
    "unknown_resource_reference": "dependent_path_exclusion",
    "infeasible_minimum_floors": "explicit_infeasible",
    "bounded_iteration_exhaustion": "fail_closed_internal_invariant",
    "no_floating_point_in_allocation": true,
    "deterministic_order_permutation_required": true
  },
