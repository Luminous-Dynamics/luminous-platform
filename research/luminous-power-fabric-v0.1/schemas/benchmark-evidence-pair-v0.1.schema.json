{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/benchmark-evidence-pair-v0.1.schema.json",
  "title": "Luminous Power Fabric matched benchmark evidence pair",
  "description": "A proof-carrying pairwise comparison manifest. Eligibility is not superiority, conformity or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_class",
    "evaluation_time_epoch_s",
    "reference",
    "candidate",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_class": {
      "const": "synthetic_fixture"
    },
    "evaluation_time_epoch_s": {
      "type": "integer",
      "minimum": 0
    },
    "reference": {
      "$ref": "#/$defs/benchmarkRun"
    },
    "candidate": {
      "$ref": "#/$defs/benchmarkRun"
    },
    "claim_ceiling": {
      "const": "MATCHED_BENCHMARK_ELIGIBILITY_ONLY_NOT_SUPERIORITY_OR_CONFORMITY"
    }
  },
  "$defs": {
    "sha256OrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "evidenceStatus": {
      "enum": [
        "current",
        "missing",
        "expired",
        "invalid",
        "unverified"
      ]
    },
    "benchmarkRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "evidence_class",
        "run_mode",
        "product_configuration_sha256",
        "evidence_bundle_sha256",
        "test_protocol_sha256",
        "primary_poc_sha256",
        "auxiliary_poc_sha256",
        "service_boundary_sha256",
        "service_profile_sha256",
        "event_schedule_sha256",
        "environment_profile_sha256",
        "source_fuel_condition_sha256",
        "initial_storage_condition_sha256",
        "reserve_policy_sha256",
        "data_treatment_policy_sha256",
        "sample_selection_policy_sha256",
        "time_series_preprocessing_sha256",
        "mission_duration_s",
        "reporting_window_start_s",
        "reporting_window_end_s",
        "sample_coverage_fraction",
        "minimum_required_sample_coverage_fraction",
        "sample_event_count",
        "minimum_required_sample_event_count",
        "missing_sample_count",
        "maximum_missing_sample_count",
        "raw_data_sha256",
        "fault_log_sha256",
        "maintenance_log_sha256",
        "dispatch_log_sha256",
        "timebase_method_sha256",
        "timebase_status",
        "timebase_valid_until_epoch_s",
        "timebase_evidence_reference",
        "instruments",
        "metrics",
        "independent_assessment_reference",
        "data_rights_reference"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_class": {
          "enum": [
            "vendor_assertion",
            "synthetic",
            "modelled",
            "measured",
            "independently_witnessed",
            "accredited"
          ]
        },
        "run_mode": {
          "enum": [
            "controlled_laboratory",
            "production_acceptance",
            "site_operational_assessment",
            "field_mission",
            "simulation",
            "synthetic",
            "vendor_published_specification"
          ]
        },
        "product_configuration_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "evidence_bundle_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "test_protocol_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "primary_poc_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "auxiliary_poc_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "service_boundary_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "service_profile_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "event_schedule_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "environment_profile_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "source_fuel_condition_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "initial_storage_condition_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "reserve_policy_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "data_treatment_policy_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "sample_selection_policy_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "time_series_preprocessing_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "mission_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reporting_window_start_s": {
          "type": "number",
          "minimum": 0
        },
        "reporting_window_end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_coverage_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_required_sample_coverage_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "sample_event_count": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_required_sample_event_count": {
          "type": "integer",
          "minimum": 1
        },
        "missing_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_missing_sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_data_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "fault_log_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "maintenance_log_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "dispatch_log_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "timebase_method_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "timebase_status": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "timebase_valid_until_epoch_s": {
          "type": "integer",
          "minimum": 0
        },
        "timebase_evidence_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instrument_id",
              "calibration_scope_sha256",
              "calibration_method_sha256",
              "calibration_status",
              "calibration_valid_until_epoch_s",
              "calibration_evidence_reference"
            ],
            "properties": {
              "instrument_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "calibration_scope_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "calibration_method_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "calibration_status": {
                "$ref": "#/$defs/evidenceStatus"
              },
              "calibration_valid_until_epoch_s": {
                "type": "integer",
                "minimum": 0
              },
              "calibration_evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric_id",
              "unit",
              "value",
              "absolute_uncertainty_bound",
              "measurement_method_sha256",
              "measurand_scope_sha256",
              "instrument_ids",
              "evidence_status",
              "evidence_reference"
            ],
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "value": {
                "type": "number"
              },
              "absolute_uncertainty_bound": {
                "type": "number",
                "minimum": 0
              },
              "measurement_method_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "measurand_scope_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "instrument_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "evidence_status": {
                "$ref": "#/$defs/evidenceStatus"
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "independent_assessment_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "data_rights_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "enum": [
                  "measured",
                  "independently_witnessed",
                  "accredited"
                ]
              },
              "run_mode": {
                "enum": [
                  "controlled_laboratory",
                  "production_acceptance",
                  "site_operational_assessment",
                  "field_mission"
                ]
              }
            },
            "required": [
              "evidence_class",
              "run_mode"
            ]
          },
          "then": {
            "properties": {
              "raw_data_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_mode": {
                "const": "site_operational_assessment"
              }
            },
            "required": [
              "run_mode"
            ]
          },
          "then": {
            "properties": {
              "minimum_required_sample_event_count": {
                "type": "integer",
                "minimum": 3
              },
              "fault_log_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "maintenance_log_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence_class"
            ],
            "properties": {
              "evidence_class": {
                "const": "vendor_assertion"
              }
            }
          },
          "then": {
            "properties": {
              "run_mode": {
                "const": "vendor_published_specification"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence_class"
            ],
            "properties": {
              "evidence_class": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "run_mode": {
                "const": "synthetic"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence_class"
            ],
            "properties": {
              "evidence_class": {
                "const": "modelled"
              }
            }
          },
          "then": {
            "properties": {
              "run_mode": {
                "const": "simulation"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence_class"
            ],
            "properties": {
              "evidence_class": {
                "enum": [
                  "measured",
                  "independently_witnessed",
                  "accredited"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "run_mode": {
                "enum": [
                  "controlled_laboratory",
                  "production_acceptance",
                  "site_operational_assessment",
                  "field_mission"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
