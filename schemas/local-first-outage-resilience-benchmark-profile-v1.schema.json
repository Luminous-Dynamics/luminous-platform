{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/local-first-outage-resilience-benchmark-profile-v1.schema.json",
  "title": "Local-First Outage Resilience Benchmark Profile v1",
  "description": "Strict draft contract for bounded store-and-forward and local continuity benchmark targets. Passing validation does not prove message security, delivery, or deployment authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "reviewed_at",
    "authority",
    "deployment_gates",
    "comparison_contract",
    "benchmarks",
    "explicit_non_claims",
    "next_required_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.local-first-outage-resilience-benchmark-profile.v1"
    },
    "profile_id": {
      "const": "local-first-outage-resilience-v1"
    },
    "status": {
      "const": "draft_targets_not_results"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "design_document",
        "measurement_receipt_contract"
      ],
      "properties": {
        "issue": {
          "const": "https://github.com/Luminous-Dynamics/luminous-platform/issues/67"
        },
        "design_document": {
          "const": "docs/LOCAL_FIRST_OUTAGE_RESILIENCE_V1.md"
        },
        "measurement_receipt_contract": {
          "const": "schemas/local-first-measurement-receipt-v1.schema.json"
        }
      }
    },
    "deployment_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpv7_implementation_status",
        "bpsec_security_context_status",
        "end_to_end_crypto_adapter_status",
        "durable_queue_adapter_status",
        "upstream_relay_permission_status",
        "regulatory_review_status",
        "local_continuity_measured",
        "deployment_blocked_until_gates_verified",
        "local_service_must_not_require_wan",
        "payload_inspection_for_routing",
        "sensitive_admission_must_require_trusted_protection_verification"
      ],
      "properties": {
        "bpv7_implementation_status": {
          "const": "not_selected"
        },
        "bpsec_security_context_status": {
          "const": "not_selected"
        },
        "end_to_end_crypto_adapter_status": {
          "const": "not_implemented"
        },
        "durable_queue_adapter_status": {
          "const": "not_implemented"
        },
        "upstream_relay_permission_status": {
          "const": "not_verified"
        },
        "regulatory_review_status": {
          "const": "not_verified"
        },
        "local_continuity_measured": {
          "const": false
        },
        "deployment_blocked_until_gates_verified": {
          "const": true
        },
        "local_service_must_not_require_wan": {
          "const": true
        },
        "payload_inspection_for_routing": {
          "const": false
        },
        "sensitive_admission_must_require_trusted_protection_verification": {
          "const": true
        }
      }
    },
    "comparison_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_code_and_config_revisions_must_be_immutable",
        "raw_trial_denominators_must_be_published",
        "failed_and_expired_messages_must_remain_in_denominator",
        "simulation_must_not_be_reported_as_field_evidence",
        "no_exactly_once_transport_claim",
        "cryptography_must_not_be_implemented_by_metadata_model",
        "costs_must_include_hardware_energy_maintenance_and_labor"
      ],
      "properties": {
        "source_code_and_config_revisions_must_be_immutable": {
          "const": true
        },
        "raw_trial_denominators_must_be_published": {
          "const": true
        },
        "failed_and_expired_messages_must_remain_in_denominator": {
          "const": true
        },
        "simulation_must_not_be_reported_as_field_evidence": {
          "const": true
        },
        "no_exactly_once_transport_claim": {
