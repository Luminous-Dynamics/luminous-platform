{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:security:effect-bound-capability-contract:0.1",
  "title": "Luminous Effect-Bound Capability Contract v0.1",
  "type": "object",
  "required": [
    "profile",
    "version",
    "status",
    "canonical_owner",
    "composition_rule",
    "evidence_is_authority",
    "capabilities",
    "permit",
    "request",
    "effect",
    "claim_ceiling"
  ],
  "properties": {
    "profile": {
      "const": "luminous-effect-bound-capability-contract"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "enum": [
        "template_only",
        "synthetic_fixture",
        "qualified_component"
      ]
    },
    "canonical_owner": {
      "const": "Luminous-Dynamics/mycelix AGENT"
    },
    "composition_rule": {
      "const": "intersection"
    },
    "evidence_is_authority": {
      "const": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "permit": {
      "$ref": "#/$defs/permit"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "effect": {
      "$ref": "#/$defs/effect"
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "capability": {
      "type": "object",
      "required": [
        "grant_id",
        "principal_id",
        "issuer_id",
        "subject_id",
        "parent_grant_id",
        "target_refs",
        "operations",
        "argument_digest",
        "policy_epoch",
        "not_before",
        "expires_at",
        "revocation_state",
        "may_delegate",
        "max_delegation_depth"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 2
        },
        "principal_id": {
          "type": "string",
          "minLength": 2
        },
        "issuer_id": {
          "type": "string",
          "minLength": 2
        },
        "subject_id": {
          "type": "string",
          "minLength": 2
        },
        "parent_grant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "argument_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_epoch": {
          "type": "string",
          "minLength": 2
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revocation_state": {
          "enum": [
            "current",
            "revoked",
            "unknown"
          ]
        },
        "may_delegate": {
          "type": "boolean"
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "principal_id",
        "actor_id",
        "target_ref",
        "operation",
        "argument_digest",
        "policy_epoch",
        "attempt_id",
        "admission_time"
      ],
      "properties": {
        "principal_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "argument_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_epoch": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "admission_time": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "permit": {
      "type": "object",
      "required": [
        "permit_id",
        "actor_id",
        "participant_id",
        "target_ref",
        "operation",
        "argument_digest",
        "policy_epoch",
        "attempt_id",
        "not_before",
        "expires_at",
        "nonce_id",
        "consume_count"
      ],
      "properties": {
        "permit_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "participant_id": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "argument_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_epoch": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce_id": {
          "type": "string"
        },
        "consume_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "effect_id",
        "state",
        "participant_id",
        "attempt_id",
        "postcondition"
      ],
      "properties": {
        "effect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "none",
            "committed",
            "partially_committed",
            "unknown"
          ]
        },
        "participant_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "postcondition": {
          "enum": [
            "matches",
            "mismatch",
            "not_observed",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
