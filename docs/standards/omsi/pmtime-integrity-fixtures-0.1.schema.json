{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:omsi:pmtime-integrity-fixtures:0.1",
  "title": "OMSI PMTime integrity synthetic fixtures 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "state",
    "standard",
    "required_dependency_domains",
    "profile_policy",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "omsi.pmtime.integrity.fixture-pack"
    },
    "version": {
      "const": "0.1.0"
    },
    "state": {
      "const": "SYNTHETIC_CONFORMANCE_FIXTURES"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation",
        "edition",
        "annex",
        "note",
        "amendment_2026_08"
      ],
      "properties": {
        "recommendation": {
          "const": "ITU-T G.8275"
        },
        "edition": {
          "const": "01/2026"
        },
        "annex": {
          "const": "F"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "amendment_2026_08": {
          "const": "NOT_APPLIED"
        }
      }
    },
    "required_dependency_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "clock",
          "oscillator",
          "gnss_reference",
          "power",
          "network",
          "correction_provider",
          "firmware_lineage",
          "collector",
          "data_pipeline",
          "antenna_site"
        ]
      }
    },
    "profile_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "max_uncertainty_ns",
        "units",
        "interval_semantics"
      ],
      "properties": {
        "profile_id": {
          "const": "omsi.pmtime-reference-integrity/0.1"
        },
        "max_uncertainty_ns": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "const": "TAI nanoseconds"
        },
        "interval_semantics": {
          "const": "half_open"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "certificate_sha256",
        "valid_from_tai_ns",
        "valid_until_tai_ns",
        "traceability_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "current",
            "expired",
            "revoked",
            "conflicted",
            "unknown"
          ]
        },
        "certificate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "valid_from_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "traceability_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_index",
        "pmtime_tai_ns",
        "period_start_tai_ns",
        "period_end_tai_ns",
        "timestamp_source_id",
        "ptp_clock_instance_id",
        "time_scale",
        "timestamp_method",
        "configuration_revision",
        "configuration_change_receipt_sha256",
        "timestamp_uncertainty_ns",
        "signature_status",
        "calibration"
      ],
      "properties": {
        "record_index": {
          "type": "integer",
          "minimum": 1
        },
        "pmtime_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "period_start_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "period_end_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_source_id": {
          "type": "string",
          "minLength": 1
        },
        "ptp_clock_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "time_scale": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_method": {
          "type": "string",
          "minLength": 1
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration_change_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "signature_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibration": {
          "$ref": "#/$defs/calibration"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_contract",
        "status",
        "authority",
        "checks",
        "limitations"
      ],
      "properties": {
        "verifier_contract": {
          "const": "emsr-dependency-hypergraph-reference-verifier/0.1"
        },
        "status": {
          "enum": [
            "verified",
            "rejected"
          ]
        },
        "authority": {
          "const": "independent_reference_algorithm_agreement_only"
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "result"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencyReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_contract",
        "disposition",
        "authority",
        "input_sha256",
        "snapshot_id",
        "evidence_frontier",
        "event_time",
        "domain",
        "source_ids",
        "source_ancestors",
        "common_dependency_ids",
        "reason_codes",
        "claim_ceiling"
      ],
      "properties": {
        "report_contract": {
          "const": "emsr-dependency-hypergraph-report/0.1"
        },
        "disposition": {
          "enum": [
            "SHARED_DEPENDENCY",
            "UNKNOWN_DEPENDENCY",
            "NO_DECLARED_COMMON_DOMAIN"
          ]
        },
        "authority": {
          "const": "declared_dependency_assessment_only"
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frontier": {
          "type": "integer",
          "minimum": 0
        },
        "event_time": {
          "type": "integer",
          "minimum": 0
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_ancestors": {
          "type": "object"
        },
        "common_dependency_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "source_ids",
        "event_time_tai_ns",
        "snapshot_id",
        "evidence_frontier_tai_ns",
        "input_sha256",
        "dependency_report_artifact_sha256",
        "verification_report_artifact_sha256",
        "disposition",
        "dependency_report",
        "reference_verification"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_time_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frontier_tai_ns": {
          "type": "integer",
          "minimum": 0
        },
        "input_sha256": {
          "$ref": "#/$defs/digest"
        },
        "dependency_report_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "verification_report_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "disposition": {
          "enum": [
            "SHARED_DEPENDENCY",
            "UNKNOWN_DEPENDENCY",
            "NO_DECLARED_COMMON_DOMAIN"
          ]
        },
        "dependency_report": {
          "$ref": "#/$defs/dependencyReport"
        },
        "reference_verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "expected",
        "records",
        "dependency_assessments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "enum": [
            "TIMESTAMP_QUALIFIED_FOR_DECLARED_SCOPE",
            "TIMESTAMP_SHARED_FAILURE_DOMAIN",
            "TIMESTAMP_INDETERMINATE",
            "TIMESTAMP_INVALID"
          ]
        },
        "max_uncertainty_ns": {
          "type": "integer",
          "minimum": 1
        },
        "required_dependency_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "dependency_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assessment"
          }
        }
      }
    }
  }
}
