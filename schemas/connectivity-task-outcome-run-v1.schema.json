{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/connectivity-task-outcome-run-v1.schema.json",
  "title": "Connectivity Task Outcome Benchmark Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source", "evidence_class", "currency", "environment", "trials"],
  "properties": {
    "schema_version": { "const": "luminous.connectivity-task-outcome-run.v1" },
    "run_id": { "$ref": "#/$defs/token" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_sha256"],
      "properties": {
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "run_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "scenario_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_class": { "enum": ["synthetic_simulation", "bench_measured", "field_observed"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway_model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "hardware_revision": { "type": "string", "minLength": 1, "maxLength": 160 },
        "firmware_image_sha256": { "$ref": "#/$defs/sha256" },
        "measurement_method": { "type": "string", "minLength": 1, "maxLength": 240 },
        "power_meter_token": { "$ref": "#/$defs/token" },
        "site_token": { "$ref": "#/$defs/token" },
        "consent_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "pair_id", "scenario_id", "arm", "priority", "mode", "outcome", "elapsed_ms", "bytes_tx", "bytes_rx", "energy_millijoules", "charge_minor"],
        "properties": {
          "trial_id": { "$ref": "#/$defs/token" },
          "pair_id": { "$ref": "#/$defs/token" },
          "scenario_id": { "$ref": "#/$defs/token" },
          "arm": { "enum": ["baseline", "candidate"] },
          "priority": { "enum": ["essential", "interactive", "bulk"] },
          "mode": { "enum": ["online", "wan_partition", "route_recovery"] },
          "outcome": { "enum": ["succeeded", "failed", "inconclusive"] },
          "elapsed_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 31536000000 },
          "bytes_tx": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "bytes_rx": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
          "energy_millijoules": { "type": ["integer", "null"], "minimum": 0, "maximum": 18446744073709551615 },
          "charge_minor": { "type": ["integer", "null"], "minimum": 0, "maximum": 18446744073709551615 }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_class": { "enum": ["bench_measured", "field_observed"] } }, "required": ["evidence_class"] },
      "then": {
        "properties": {
          "environment": { "required": ["gateway_model", "hardware_revision", "firmware_image_sha256", "measurement_method", "power_meter_token"] }
        }
      }
    },
    {
      "if": { "properties": { "evidence_class": { "const": "field_observed" } }, "required": ["evidence_class"] },
      "then": {
        "properties": {
          "environment": { "required": ["site_token", "consent_record_sha256"] }
        }
      }
    }
  ]
}
