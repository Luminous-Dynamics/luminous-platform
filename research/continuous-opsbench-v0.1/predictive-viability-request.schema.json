{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/predictive-viability-request-v0.1.schema.json",
  "title": "Predictive Viability Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "state_space_digest",
    "fallback_actions_digest",
    "state_space",
    "fallback_actions",
    "horizon"
  ],
  "properties": {
    "base": {
      "$ref": "predictive-safety-filter-request.schema.json#/properties/filter_input"
    },
    "state_space_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fallback_actions_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_space": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "predictive-safety-filter-request.schema.json#/$defs/state"
      }
    },
    "fallback_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "predictive-safety-filter-request.schema.json#/$defs/candidate_operation"
      }
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  }
}
