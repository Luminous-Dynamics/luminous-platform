{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:evidence-claim-qualification:0.1",
  "title": "Evidence Claim Qualification Benchmark v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "version",
    "status",
    "no_aggregate_score",
    "constraints",
    "profile_requirements",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "luminous-evidence-claim-qualification"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_claim_interpretation_contract_not_cryptographically_verified"
    },
    "no_aggregate_score": {
      "const": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_fixtures_only",
        "no_signature_crypto_verification",
        "no_live_api_or_effect_lookup",
        "no_production_assurance_claims",
        "exact_subject_binding_required",
        "claim_gap_is_set_valued"
      ],
      "properties": {
        "synthetic_fixtures_only": {
          "const": true
        },
        "no_signature_crypto_verification": {
          "const": true
        },
        "no_live_api_or_effect_lookup": {
          "const": true
        },
        "no_production_assurance_claims": {
          "const": true
        },
        "exact_subject_binding_required": {
          "const": true
        },
        "claim_gap_is_set_valued": {
          "const": true
        }
      }
    },
    "profile_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_contract",
        "exact_head_hosted",
        "isolated_runtime",
        "independent_effect_observation",
        "bounded_edit_contract"
      ],
      "properties": {
        "synthetic_contract": {
          "const": [
            "checker",
            "mutations"
          ]
        },
        "exact_head_hosted": {
          "const": [
            "checker",
            "mutations",
            "workflow"
          ]
        },
        "isolated_runtime": {
          "const": [
            "checker",
            "mutations",
            "workflow",
            "attestation",
            "runtime",
            "currentness"
          ]
        },
        "independent_effect_observation": {
          "const": [
            "checker",
            "mutations",
            "workflow",
            "attestation",
            "runtime",
            "currentness",
            "observer_fault",
            "target_effect",
            "timebase"
          ]
        },
        "bounded_edit_contract": {
          "const": [
            "checker",
            "mutations",
            "continuation"
          ]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "requested_profile",
        "assertion",
        "subject_repository",
        "subject_commit",
        "subject_digest",
        "subject_domain_id",
        "current_policy_revision",
        "current_descriptor_digest",
        "trusted_attesters",
        "required_checks",
        "scope",
        "effect_expectation",
        "expected_effect_id",
        "bundle_sealed",
        "bundle_digest"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "requested_profile": {
          "enum": [
            "synthetic_contract",
            "exact_head_hosted",
            "isolated_runtime",
            "independent_effect_observation",
            "bounded_edit_contract"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "subject_repository": {
          "type": "string"
        },
        "subject_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "subject_domain_id": {
          "type": "string"
        },
        "current_policy_revision": {
          "type": "string"
        },
        "current_descriptor_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "trusted_attesters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource_ids",
            "operations"
          ],
          "properties": {
            "resource_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "effect_expectation": {
          "enum": [
            "observed",
            "no_effect",
            null
          ]
        },
        "expected_effect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundle_sealed": {
          "type": "boolean"
        },
        "bundle_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "category",
        "mandatory",
        "evidence_ids"
      ],
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "checker",
            "mutations",
            "workflow",
            "attestation",
            "runtime",
            "currentness",
            "observer_fault",
            "target_effect",
            "timebase",
            "continuation"
          ]
        },
        "mandatory": {
          "const": true
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "status",
        "source_kind",
        "subject_commit",
        "subject_digest",
        "run_id",
        "run_status",
        "run_conclusion",
        "run_head_sha",
        "passed_checks",
        "attester_id",
        "signature_verified",
        "attestation_subject_digest",
        "runtime_id",
        "model_id",
        "environment_id",
        "tool_descriptor_digest",
        "disposable",
        "currentness_state",
        "policy_revision",
        "descriptor_digest",
        "superseded_by",
        "observer_identity",
        "observer_domain_id",
        "observer_independent",
        "observer_fault_qualified",
        "fault_campaign_executed",
        "observer_fault_domain_id",
        "target_observation_state",
        "target_observation_complete",
        "effect_id",
        "resource_ids",
        "operations",
        "timebase_state",
        "timebase_id",
        "proof_complete",
        "witness_complete",
        "replay_free",
        "continuation_outcome"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "checker",
            "mutations",
            "workflow",
            "attestation",
            "runtime",
            "currentness",
            "observer_fault",
            "target_effect",
            "timebase",
            "continuation"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "failed",
            "unknown"
          ]
        },
        "source_kind": {
          "type": "string"
        },
        "subject_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_conclusion": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "passed_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attester_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attestation_subject_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_descriptor_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "currentness_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptor_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "observer_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "observer_domain_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observer_independent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observer_fault_qualified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fault_campaign_executed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observer_fault_domain_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_observation_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_observation_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timebase_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "timebase_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "proof_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "witness_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "replay_free": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "continuation_outcome": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_status",
        "discharged_obligation_ids",
        "residual_obligation_ids",
        "invalid_evidence_ids",
        "supported_profiles",
        "claim_state"
      ],
      "properties": {
        "obligation_status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "missing",
              "discharged",
              "failed",
              "missing_or_unknown"
            ]
          }
        },
        "discharged_obligation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual_obligation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalid_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_state": {
          "enum": [
            "qualified",
            "failed",
            "indeterminate"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "control_class",
        "claim",
        "obligations",
        "evidence",
        "expected"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^ECQ-[0-9]{3}$"
        },
        "control_class": {
          "enum": [
            "positive_control",
            "negative_control",
            "indeterminate_control"
          ]
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
