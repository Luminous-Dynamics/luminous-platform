    "benchmarks": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "metric",
          "operator",
          "target",
          "target_status",
          "evidence_classes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,90}$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "==",
              ">=",
              "within_threshold_success_ratio",
              "baseline_then_set_target",
              "baseline_then_minimize"
            ]
          },
          "target": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "minProperties": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "target_status": {
            "enum": [
              "proposed_target",
              "baseline_first"
            ]
          },
          "evidence_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "static_checked",
                "unit_contract_tested",
                "bench_measured",
                "field_observed",
                "independently_reviewed_qualified"
              ]
            }
          },
          "negative_cases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "LOCAL_CONTINUITY_001"
              },
              "operator": {
                "const": ">="
              },
              "target": {
                "const": 24
              },
              "target_status": {
                "const": "proposed_target"
              }
            },
            "required": [
              "id",
              "operator",
              "target",
              "target_status"
            ]
