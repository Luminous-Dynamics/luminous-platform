{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMSI ITOPS profile conformance vectors 0.1",
  "type": "object",
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "status",
    "purpose",
    "common_rules",
    "vectors",
    "visibility",
    "upstream_crosswalk"
  ],
  "properties": {
    "schema": {
      "const": "omsi-itops-conformance-vectors"
    },
    "profile_id": {
      "const": "omsi:technology-services-operations:0.1-incubation"
    },
    "profile_version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_research_fixture_not_normative_wire_schema"
    },
    "purpose": {
      "type": "string",
      "minLength": 30
    },
    "common_rules": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "classification",
          "maps_to",
          "input",
          "expected",
          "forbidden_claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ITOPS-[A-Z0-9]+-[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "minLength": 3
          },
          "classification": {
            "enum": [
              "negative_control",
              "positive_with_gate"
            ]
          },
          "maps_to": {
            "type": "object",
            "required": [
              "opsbench_case",
              "saga_fault"
            ],
            "properties": {
              "opsbench_case": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "saga_fault": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "input": {
            "type": "object",
            "minProperties": 1
          },
          "expected": {
            "type": "object",
            "required": [
              "profile_disposition",
              "action_authority",
              "assertions"
            ],
            "properties": {
              "profile_disposition": {
                "type": "string",
                "minLength": 3
              },
              "action_authority": {
                "type": "string",
                "minLength": 3
              },
              "assertions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "evidence_class": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "forbidden_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "additionalProperties": false
      }
    },
    "visibility": {
      "const": "profile_evaluator_only_not_sut_input"
    },
    "upstream_crosswalk": {
      "const": "upstream-crosswalk.json"
    }
  },
  "additionalProperties": false
}
