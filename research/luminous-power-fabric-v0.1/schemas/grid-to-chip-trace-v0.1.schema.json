{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/grid-to-chip-trace-v0.1.schema.json",
  "title": "Luminous Grid-to-Chip Time-Aligned Power Trace v0.1",
  "description": "Evidence-bearing sampled measurements or model outputs from a declared source boundary to a processor rail. Schema validation does not verify timing monotonicity, channel synchronization, calibration authenticity, or physical correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "architecture_id",
    "workload_id",
    "capture_kind",
    "source_boundary",
    "load_boundary",
    "clock",
    "channels",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": "grid-to-chip-trace-v0.1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "architecture_id": {
      "type": "string",
      "minLength": 1
    },
    "workload_id": {
      "type": "string",
      "minLength": 1
    },
    "capture_kind": {
      "type": "string",
      "enum": ["MEASURED", "SIMULATED", "VENDOR_REPORTED", "SYNTHETIC_EXAMPLE"]
    },
    "source_boundary": {
      "$ref": "#/$defs/boundary"
    },
    "load_boundary": {
      "$ref": "#/$defs/boundary"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_domain_id",
        "timestamp_unit",
        "nominal_sample_interval_ns",
        "synchronization_uncertainty_ns"
      ],
      "properties": {
        "clock_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_unit": {
          "const": "ns"
        },
        "nominal_sample_interval_ns": {
          "type": "integer",
          "minimum": 1
        },
        "synchronization_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "clock_source": {
          "type": "string",
          "enum": ["DAQ_MASTER", "PTP", "GNSS", "INSTRUMENT_LOCAL", "SIMULATOR", "UNKNOWN"]
        },
        "timestamp_semantics": {
          "type": "string",
          "enum": ["SAMPLE_INSTANT", "WINDOW_START", "WINDOW_CENTER", "WINDOW_END"]
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "capture_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "procedure_revision": {
          "type": "string",
          "minLength": 1
        },
        "instrument_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "calibration_record_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "solver_revision": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "description"],
      "properties": {
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "nominal_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "polarity_reference": {
          "type": "string",
          "enum": ["POSITIVE_TO_RETURN", "POSITIVE_TO_EARTH", "BIPOLAR", "NOT_APPLICABLE", "UNKNOWN"]
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "quantity",
        "unit",
        "boundary_id",
        "positive_direction",
        "evidence_kind",
        "source_reference",
        "standard_uncertainty"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "enum": [
            "source_bus_voltage_v",
            "source_bus_current_a",
            "processor_rail_voltage_v",
            "processor_rail_current_a",
            "ambient_temperature_c",
            "coolant_inlet_temperature_c",
            "coolant_flow_lpm"
          ]
        },
        "quantity": {
          "type": "string",
          "enum": ["VOLTAGE", "CURRENT", "TEMPERATURE", "VOLUME_FLOW"]
        },
        "unit": {
          "type": "string",
          "enum": ["V", "A", "degC", "L/min"]
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "positive_direction": {
          "type": "string",
          "enum": [
            "INTO_CONVERSION_SYSTEM",
            "DELIVERED_TO_PROCESSOR",
            "AMBIENT_REFERENCE",
            "INTO_COOLING_SYSTEM",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_kind": {
          "type": "string",
          "enum": ["PHYSICAL_MEASUREMENT", "SIMULATION", "VENDOR_SPECIFICATION", "ASSUMPTION"]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "standard_uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "calibration_reference": {
          "type": "string",
          "minLength": 1
        },
        "bandwidth_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "PHYSICAL_MEASUREMENT"
              }
            }
          },
          "then": {
            "required": ["calibration_reference", "bandwidth_hz"]
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_ns",
        "workload_state",
        "source_bus_voltage_v",
        "source_bus_current_a",
        "processor_rail_voltage_v",
        "processor_rail_current_a",
        "quality_flags"
      ],
      "properties": {
        "timestamp_ns": {
          "type": "integer",
          "minimum": 0
        },
        "workload_state": {
          "type": "string",
          "enum": ["IDLE", "STEADY", "BURST", "TRANSITION", "RECOVERY", "UNKNOWN"]
        },
        "source_bus_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_bus_current_a": {
          "type": "number",
          "minimum": 0
        },
        "processor_rail_voltage_v": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "processor_rail_current_a": {
          "type": "number",
          "minimum": 0
        },
        "ambient_temperature_c": {
          "type": "number"
        },
        "coolant_inlet_temperature_c": {
          "type": "number"
        },
        "coolant_flow_lpm": {
          "type": "number",
          "minimum": 0
        },
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "VALID",
              "SATURATED",
              "DROPPED_SAMPLE",
              "CLOCK_UNCERTAIN",
              "MISSING_CALIBRATION",
              "CHANNEL_UNAVAILABLE",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}