{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/energy-chain-v0.1.schema.json",
  "title": "Luminous Power Fabric conversion-chain scenario",
  "description": "Piecewise annual load-profile representation of serial conversion stages. Inputs and results are model-based, not site measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_class",
    "id",
    "name",
    "currency_code",
    "electricity_price_per_kwh",
    "electricity_price_reference",
    "grid_carbon_kg_per_kwh",
    "grid_carbon_reference",
    "stages",
    "segments",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_class": {
      "enum": [
        "synthetic_fixture",
        "engineering_model",
        "physical_measurement"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "currency_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "electricity_price_per_kwh": {
      "type": "number",
      "minimum": 0
    },
    "electricity_price_reference": {
      "type": "string",
      "minLength": 1
    },
    "grid_carbon_kg_per_kwh": {
      "type": "number",
      "minimum": 0
    },
    "grid_carbon_reference": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "hours_per_year",
          "delivered_load_power_w",
          "stage_operating_points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hours_per_year": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 8760
          },
          "delivered_load_power_w": {
            "type": "number",
            "minimum": 0
          },
          "stage_operating_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "efficiency_fraction",
                "standby_input_power_w",
                "efficiency_evidence",
                "efficiency_reference",
                "standby_evidence",
                "standby_reference"
              ],
              "properties": {
                "efficiency_fraction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "standby_input_power_w": {
                  "type": "number",
                  "minimum": 0
                },
                "efficiency_evidence": {
                  "enum": [
                    "physical_measurement",
                    "vendor_specification",
                    "analytical_model",
                    "assumption"
                  ]
                },
                "efficiency_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "standby_evidence": {
                  "enum": [
                    "physical_measurement",
                    "vendor_specification",
                    "analytical_model",
                    "assumption"
                  ]
                },
                "standby_reference": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "PARAMETERIZED_CONVERSION_CHAIN_ENERGY_ACCOUNTING_ONLY_NOT_SITE_MEASUREMENT_OR_EFFICIENCY_CLAIM"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_class": {
            "const": "synthetic_fixture"
          }
        },
        "required": [
          "record_class"
        ]
      },
      "then": {
        "properties": {
          "electricity_price_reference": {
            "pattern": "^synthetic:"
          },
          "grid_carbon_reference": {
            "pattern": "^synthetic:"
          },
          "segments": {
            "items": {
              "properties": {
                "stage_operating_points": {
                  "items": {
                    "properties": {
                      "efficiency_evidence": {
                        "const": "assumption"
                      },
                      "standby_evidence": {
                        "const": "assumption"
                      },
                      "efficiency_reference": {
                        "pattern": "^synthetic:"
                      },
                      "standby_reference": {
                        "pattern": "^synthetic:"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
