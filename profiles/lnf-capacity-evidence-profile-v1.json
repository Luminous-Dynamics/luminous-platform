  "reviewed_on": "2026-11-04",
  "parent_issue": 233,
  "execution_stage": "semantic_verifier_boundary_with_injected_trust_adapter",
  "objective": "Verify issuer-attested capacity dependency statements with authority scope, canonical digest binding, validity, replay, optional SCITT transparency and calibration checks while keeping inventory correctness separate from signature validity.",
  "standards_basis": [
    "RFC 9943",
    "OpenConfig gNMI"
  ],
  "trust_semantics": {
    "signature_proves": "issuer_signed_exact_canonical_statement_bytes",
    "authority_policy_proves": "issuer_is_authorized_for_declared_topology_scope_and_resource_claims",
    "scitt_receipt_proves": "statement_digest_was_registered_with_transparency_service",
    "scitt_receipt_does_not_prove": "resource_inventory_claims_are_correct",
    "gNMI_does_not_prove": "global_physical_or_provider_topology_is_complete",
    "initial_verified_maturity": "issuer_attested",
    "confidence_usable_for_ranking_only_when_calibration_profile_is_verified": true
  },
  "verifier_boundary": {
    "cryptography_implemented_in_core": false,
    "signature_and_trust_root_delegated": true,
    "issuer_scope_authorization_delegated": true,
    "replay_state_delegated": true,
    "scitt_receipt_verification_delegated": true,
    "calibration_profile_verification_delegated": true,
    "canonical_statement_digest_recomputation_required": true,
    "private_verified_inventory_constructor": true
  },
  "evidence_states": [
    "unverified",
    "issuer_attested",
    "corroborated",
    "measured",
    "contradicted",
    "expired_or_revoked"
  ],
  "scenarios": [
