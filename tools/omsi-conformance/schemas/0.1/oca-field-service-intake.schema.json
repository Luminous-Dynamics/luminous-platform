{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsi.example/spec/0.1/oca-field-service-intake.schema.json",
  "title": "OMSI Field Service Intake Projection 0.1 (not a qualified work record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tenant_id",
    "source",
    "service_case",
    "work_order",
    "source_claims",
    "assurance",
    "privacy"
  ],
  "properties": {
    "schema": {
      "const": "org.omsi.field-service-intake/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "instance_namespace",
        "model",
        "record_id",
        "display_name",
        "revision",
        "repository_commit",
        "core_addon_version",
        "core_addon_license",
        "company_id",
        "binding_id"
      ],
      "properties": {
        "system": {
          "const": "OCA/field-service"
        },
        "instance_namespace": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "const": "fsm.order"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "format": "date-time"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "core_addon_version": {
          "type": "string",
          "minLength": 1
        },
        "core_addon_license": {
          "const": "AGPL-3"
        },
        "company_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_stage_id",
        "source_stage_name",
        "source_stage_type",
        "source_is_closed",
        "normalized_status",
        "mapping_profile",
        "mapping_losses",
        "mapping_conflicts",
        "mapping_loss_disclosed"
      ],
      "properties": {
        "source_stage_id": {
          "type": "string",
          "minLength": 1
        },
        "source_stage_name": {
          "type": "string",
          "minLength": 1
        },
        "source_stage_type": {
          "enum": [
            "order",
            "equipment",
            "location",
            "worker"
          ]
        },
        "source_is_closed": {
          "type": "boolean"
        },
        "normalized_status": {
          "enum": [
            "requested",
            "assessed",
            "awaiting_approval",
            "approved",
            "scheduled",
            "dispatched",
            "on_site",
            "diagnosed",
            "in_progress",
            "quality_checked",
            "handed_over",
            "invoiced",
            "closed",
            "disputed",
            "blocked",
            "return_visit_required",
            "unmapped"
          ]
        },
        "mapping_profile": {
          "type": "string",
          "minLength": 1
        },
        "mapping_losses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapping_conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapping_loss_disclosed": {
          "const": true
        }
      }
    },
    "work_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_order_id",
        "location_ref",
        "worker_refs",
        "team_ref",
        "equipment_refs",
        "priority_source_value",
        "request_window",
        "scheduled_window",
        "actual_interval"
      ],
      "properties": {
        "source_order_id": {
          "type": "string",
          "minLength": 1
        },
        "location_ref": {
          "type": "string",
          "minLength": 1
        },
        "worker_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "team_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "equipment_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority_source_value": {
          "enum": [
            "0",
            "1",
            "2",
            "3"
          ]
        },
        "request_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "earliest",
            "latest"
          ],
          "properties": {
            "earliest": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latest": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "scheduled_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "actual_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "source_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_says_closed",
        "resolution_present",
        "customer_signature_present",
        "customer_signature_timestamp",
        "required_activities_state",
        "activity_addon_state",
        "invoice_link_state",
        "invoice_refs"
      ],
      "properties": {
        "stage_says_closed": {
          "type": "boolean"
        },
        "resolution_present": {
          "type": "boolean"
        },
        "customer_signature_present": {
          "type": "boolean"
        },
        "customer_signature_timestamp": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_activities_state": {
          "enum": [
            "all_complete",
            "required_activity_incomplete",
            "none_reported",
            "addon_unavailable",
            "addon_not_installed"
          ]
        },
        "activity_addon_state": {
          "enum": [
            "not_installed",
            "exported",
            "unavailable"
          ]
        },
        "invoice_link_state": {
          "enum": [
            "not_installed",
            "unavailable",
            "linked_references_present",
            "no_invoice_references"
          ]
        },
        "invoice_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_scope_approval",
        "practitioner_credential_status",
        "authorized_operation",
        "independent_verification",
        "workmanship_quality",
        "invoice_payment"
      ],
      "properties": {
        "customer_scope_approval": {
          "const": "not_provided_by_source"
        },
        "practitioner_credential_status": {
          "const": "not_provided_by_source"
        },
        "authorized_operation": {
          "const": "not_provided_by_source"
        },
        "independent_verification": {
          "const": "not_provided_by_source"
        },
        "workmanship_quality": {
          "const": "not_verified"
        },
        "invoice_payment": {
          "const": "not_established"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_signature_exported",
        "raw_html_exported",
        "precise_contact_exported"
      ],
      "properties": {
        "raw_signature_exported": {
          "const": false
        },
        "raw_html_exported": {
          "const": false
        },
        "precise_contact_exported": {
          "const": false
        }
      }
    }
  }
}
