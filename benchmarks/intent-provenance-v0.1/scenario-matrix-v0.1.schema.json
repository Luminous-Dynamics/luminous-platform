{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:web4:intent-provenance-benchmark:0.1",
  "title": "Intent Provenance Adaptive Benchmark Scenario Matrix v0.1",
  "type": "object",
  "required": [
    "benchmark",
    "version",
    "status",
    "scope",
    "scenarios",
    "claim_ceiling"
  ],
  "properties": {
    "benchmark": {
      "const": "luminous-intent-provenance-adaptive-benchmark"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_design_not_executed"
    },
    "scope": {
      "type": "object",
      "required": [
        "task_precision_classes",
        "trajectory_unit",
        "effect_scope",
        "native_benchmark_policy"
      ],
      "properties": {
        "task_precision_classes": {
          "const": [
            "fully_specified",
            "parameter_open",
            "action_open"
          ]
        },
        "trajectory_unit": {
          "const": "one principal task episode from intent through observed participant outcome"
        },
        "effect_scope": {
          "const": "isolated synthetic participants; no production credentials or physical actuation"
        },
        "native_benchmark_policy": {
          "const": "preserve native tasks, labels, graders and denominators; report extensions separately"
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "claim_ceiling": {
      "const": "protocol_and_synthetic_scenario_design_only"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "name",
        "control_class",
        "precision_class",
        "attack_family",
        "delivery_channel",
        "adaptive",
        "transform_depth",
        "delegation_hops",
        "expected",
        "required_oracles"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^IPAB-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "control_class": {
          "enum": [
            "positive_control",
            "negative_control",
            "indeterminate_control"
          ]
        },
        "precision_class": {
          "enum": [
            "fully_specified",
            "parameter_open",
            "action_open"
          ]
        },
        "attack_family": {
          "enum": [
            "none",
            "bounded_source_selection",
            "named_source_malicious_instruction",
            "ambiguous_intent",
            "indirect_instruction",
            "parameter_substitution",
            "target_substitution",
            "action_selection_hijack",
            "paraphrase_laundering",
            "summary_laundering",
            "child_agent_laundering",
            "mixed_origin",
            "stale_source_evidence",
            "self_attestation",
            "adaptive_action_selection_hijack",
            "adaptive_parameter_substitution",
            "ancestor_revocation_race",
            "stale_authority_cache",
            "session_composition",
            "alternate_route_bypass",
            "response_loss_after_commit",
            "concurrent_replay",
            "control_plane_partition",
            "alternate_credential",
            "participant_safety_interlock",
            "adaptive_multihop_provenance_laundering"
          ]
        },
        "delivery_channel": {
          "enum": [
            "principal_request",
            "allowlisted_connector",
            "user_named_document",
            "principal_clarification",
            "web_content",
            "tool_output",
            "memory",
            "child_agent",
            "multiple_sources",
            "model_generated",
            "multiple_tools",
            "direct_api",
            "participant_api",
            "local_host",
            "physical_participant",
            "tool_discovery"
          ]
        },
        "adaptive": {
          "type": "boolean"
        },
        "transform_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "delegation_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "expected": {
          "type": "object",
          "required": [
            "origin_decision",
            "intent_alignment",
            "authority_state",
            "dispatch",
            "participant_effect",
            "effect_authorization_relation",
            "task_utility"
          ],
          "properties": {
            "origin_decision": {
              "enum": [
                "eligible",
                "denied",
                "clarification_required",
                "indeterminate"
              ]
            },
            "intent_alignment": {
              "enum": [
                "aligned",
                "misaligned",
                "ambiguous"
              ]
            },
            "authority_state": {
              "enum": [
                "current",
                "revoked",
                "stale",
                "denied",
                "indeterminate"
              ]
            },
            "dispatch": {
              "enum": [
                "allowed",
                "no_dispatch",
                "attempt_blocked"
              ]
            },
            "participant_effect": {
              "enum": [
                "committed",
                "rejected",
                "no_effect",
                "outcome_unknown",
                "reconciled_original"
              ]
            },
            "effect_authorization_relation": {
              "enum": [
                "authorized",
                "unauthorized",
                "authorized_but_safety_rejected",
                "not_applicable",
                "unknown"
              ]
            },
            "task_utility": {
              "enum": [
                "success",
                "clarified_success",
                "clarification_required",
                "safe_incomplete",
                "blocked_by_policy",
                "reconciliation_required",
                "safe_local_continuity",
                "failure"
              ]
            }
          },
          "additionalProperties": false
        },
        "required_oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "intent",
              "source_lineage",
              "field_delegation",
              "authority",
              "dispatch",
              "participant_effect",
              "task_postcondition",
              "human_effort",
              "attack_failure_mode",
              "delegation",
              "session_state",
              "route_inventory",
              "reconciliation",
              "linearizability",
              "availability",
              "safe_state",
              "physical_safety",
              "credential_inventory"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
