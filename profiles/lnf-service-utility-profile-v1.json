      "topology": "unpinned_external_binary_or_unknown_controller",
      "purpose": "implementation provenance must be exact"
    },
    {
      "id": "UTL-13",
      "topology": "paired_task_seed_qdisc_resource_or_impairment_identity_mismatch",
