{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/srq/comparison-run-v1.schema.json",
  "title": "SRQ matched baseline comparison run v1",
  "description": "A digest-bound declaration that baseline and SRQ trial artifacts are paired on the same locked inputs. Structural comparability is not a performance, safety, or qualification result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "fixture", "run_challenge", "comparison_lock", "source", "environment", "pairing", "artifacts", "non_claims"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "SRQ-MATCHED-COMPARISON-RUN-V1"},
    "fixture": {"type": "boolean"},
    "run_challenge": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "comparison_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "lock_sha256"],
      "properties": {
        "baseline_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,80}$"},
        "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_srq_source_sha", "actual_srq_checkout_sha", "baseline_source"],
      "properties": {
        "expected_srq_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "actual_srq_checkout_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "baseline_source": {
          "type": "object", "additionalProperties": false,
          "required": ["resolved_commit_sha", "archive_sha3_256", "sqlite_source_id"],
          "properties": {
            "resolved_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "archive_sha3_256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "sqlite_source_id": {"type": ["string", "null"], "minLength": 1}
          }
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["os_image", "architecture", "kernel", "filesystem", "storage_class", "runner_class"],
      "properties": {
        "os_image": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "filesystem": {"type": "string", "minLength": 1},
        "storage_class": {"type": "string", "minLength": 1},
        "runner_class": {"type": "string", "minLength": 1}
      }
    },
    "pairing": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "minimum_paired_trials", "order_policy", "order_seed"],
      "properties": {
        "protocol": {"const": "paired_fault_trials_v1"},
        "minimum_paired_trials": {"type": "integer", "minimum": 5},
        "order_policy": {"const": "randomized_per_pair"},
        "order_seed": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_trials", "srq_trials", "fault_schedule", "baseline_events", "srq_events", "baseline_observations", "srq_observations"],
      "properties": {
        "baseline_trials": {"$ref": "#/$defs/evidence_artifact"},
        "srq_trials": {"$ref": "#/$defs/evidence_artifact"},
        "fault_schedule": {"$ref": "#/$defs/evidence_artifact"},
        "baseline_events": {"$ref": "#/$defs/evidence_artifact"},
        "srq_events": {"$ref": "#/$defs/evidence_artifact"},
        "baseline_observations": {"$ref": "#/$defs/evidence_artifact"},
        "srq_observations": {"$ref": "#/$defs/evidence_artifact"}
      }
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "evidence_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
