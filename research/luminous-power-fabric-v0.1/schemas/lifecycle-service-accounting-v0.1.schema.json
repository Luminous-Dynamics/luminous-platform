{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/lifecycle-service-accounting-v0.1.schema.json",
  "title": "Power Fabric matched lifecycle service accounting",
  "description": "Nominal cost/service accounting and observed component-health evidence. Does not predict battery lifetime or remaining useful life.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparator_set_id",
    "reference",
    "candidate",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "comparator_set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reference": {
      "$ref": "#/$defs/scenario"
    },
    "candidate": {
      "$ref": "#/$defs/scenario"
    },
    "claim_ceiling": {
      "const": "MATCHED_LIFECYCLE_ACCOUNTING_ONLY_NOT_LIFETIME_FORECAST_OR_SOTA_CLAIM"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "current",
        "missing",
        "expired",
        "invalid",
        "unverified"
      ]
    },
    "evidence": {
      "enum": [
        "independent_physical_measurement",
        "invoice_or_receipt",
        "utility_bill",
        "payroll_or_work_order",
        "vendor_report",
        "supplier_quote",
        "analytical_model",
        "synthetic_fixture",
        "assumption"
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "comparator_set_id",
        "service_boundary_id",
        "site_profile_sha256",
        "qualified_configuration_sha256",
        "observed_configuration_sha256",
        "qualification_valid_until_epoch_s",
        "evaluation_time_epoch_s",
        "currency_code",
        "minor_unit_scale",
        "study_start_epoch_s",
        "study_end_epoch_s",
        "operating_window_s",
        "storage_in_scope",
        "mission_records",
        "cost_entries",
        "repair_history_complete",
        "repair_history_evidence_status",
        "repair_history_evidence_class",
        "repair_history_evidence_reference",
        "repair_events",
        "storage_health_observations"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "comparator_set_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "service_boundary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "site_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "qualified_configuration_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observed_configuration_sha256": {
          "$ref": "#/$defs/digest"
        },
        "qualification_valid_until_epoch_s": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_time_epoch_s": {
          "type": "integer",
          "minimum": 0
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_unit_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "study_start_epoch_s": {
          "type": "integer",
          "minimum": 0
        },
        "study_end_epoch_s": {
          "type": "integer",
          "minimum": 0
        },
        "operating_window_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "storage_in_scope": {
          "type": "boolean"
        },
        "mission_records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mission_id",
              "mission_profile_sha256",
              "terminal_state_obligation_sha256",
              "qualified_configuration_sha256",
              "observed_configuration_sha256",
              "qualification_valid_until_epoch_s",
              "start_s",
              "duration_s",
              "required_critical_service_wh",
              "delivered_critical_service_wh",
              "maximum_unserved_critical_energy_wh",
              "energy_screen_pass",
              "event_screen_pass",
              "terminal_state_pass",
              "evidence_status",
              "evidence_class",
              "evidence_reference"
            ],
            "properties": {
              "mission_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "mission_profile_sha256": {
                "$ref": "#/$defs/digest"
              },
              "terminal_state_obligation_sha256": {
                "$ref": "#/$defs/digest"
              },
              "qualified_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "observed_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "qualification_valid_until_epoch_s": {
                "type": "integer",
                "minimum": 0
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "required_critical_service_wh": {
                "type": "number",
                "minimum": 0
              },
              "delivered_critical_service_wh": {
                "type": "number",
                "minimum": 0
              },
              "maximum_unserved_critical_energy_wh": {
                "type": "number",
                "minimum": 0
              },
              "energy_screen_pass": {
                "type": "boolean"
              },
              "event_screen_pass": {
                "type": "boolean"
              },
              "terminal_state_pass": {
                "type": "boolean"
              },
              "evidence_status": {
                "$ref": "#/$defs/status"
              },
              "evidence_class": {
                "$ref": "#/$defs/evidence"
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "cost_entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_id",
              "economic_event_id",
              "category",
              "amount_minor_units",
              "incurred_at_epoch_s",
              "evidence_status",
              "evidence_class",
              "evidence_reference"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "economic_event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "category": {
                "enum": [
                  "initial_capital",
                  "fuel",
                  "purchased_energy",
                  "cooling_and_auxiliaries",
                  "maintenance_parts",
                  "maintenance_labor",
                  "replacements",
                  "service_logistics",
                  "disposal",
                  "other"
                ]
              },
              "amount_minor_units": {
                "type": "integer",
                "minimum": 0
              },
              "incurred_at_epoch_s": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_status": {
                "$ref": "#/$defs/status"
              },
              "evidence_class": {
                "$ref": "#/$defs/evidence"
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "repair_history_complete": {
          "type": "boolean"
        },
        "repair_history_evidence_status": {
          "$ref": "#/$defs/status"
        },
        "repair_history_evidence_class": {
          "$ref": "#/$defs/evidence"
        },
        "repair_history_evidence_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "repair_events": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repair_id",
              "component_id",
              "replacement_component_id",
              "pre_repair_configuration_sha256",
              "post_repair_configuration_sha256",
              "start_s",
              "system_unavailable_duration_s",
              "repair_labor_hours",
              "requalification_hours",
              "replacement_required",
              "evidence_status",
              "evidence_class",
              "evidence_reference"
            ],
            "properties": {
              "repair_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "component_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "replacement_component_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "pre_repair_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "post_repair_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "system_unavailable_duration_s": {
                "type": "number",
                "minimum": 0
              },
              "repair_labor_hours": {
                "type": "number",
                "minimum": 0
              },
              "requalification_hours": {
                "type": "number",
                "minimum": 0
              },
              "replacement_required": {
                "type": "boolean"
              },
              "evidence_status": {
                "$ref": "#/$defs/status"
              },
              "evidence_class": {
                "$ref": "#/$defs/evidence"
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "storage_health_observations": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "component_id",
              "observed_at_epoch_s",
              "qualified_configuration_sha256",
              "observed_configuration_sha256",
              "usable_capacity_wh",
              "capacity_uncertainty_bound_wh",
              "maximum_discharge_power_w",
              "power_uncertainty_bound_w",
              "cumulative_energy_throughput_wh",
              "calendar_age_hours",
              "equivalent_full_cycles",
              "state_of_charge_fraction",
              "state_of_health_fraction",
              "temperature_c",
              "evidence_status",
              "calibration_status",
              "sensor_status",
              "evidence_class",
              "operating_condition_reference",
              "timebase_reference",
              "evidence_reference"
            ],
            "properties": {
              "observation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "component_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "observed_at_epoch_s": {
                "type": "integer",
                "minimum": 0
              },
              "qualified_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "observed_configuration_sha256": {
                "$ref": "#/$defs/digest"
              },
              "usable_capacity_wh": {
                "type": "number",
                "minimum": 0
              },
              "capacity_uncertainty_bound_wh": {
                "type": "number",
                "minimum": 0
              },
              "maximum_discharge_power_w": {
                "type": "number",
                "minimum": 0
              },
              "power_uncertainty_bound_w": {
                "type": "number",
                "minimum": 0
              },
              "cumulative_energy_throughput_wh": {
                "type": "number",
                "minimum": 0
              },
              "calendar_age_hours": {
                "type": "number",
                "minimum": 0
              },
              "equivalent_full_cycles": {
                "type": "number",
                "minimum": 0
              },
              "state_of_charge_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "state_of_health_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "temperature_c": {
                "type": "number"
              },
              "evidence_status": {
                "$ref": "#/$defs/status"
              },
              "calibration_status": {
                "$ref": "#/$defs/status"
              },
              "sensor_status": {
                "$ref": "#/$defs/status"
              },
              "evidence_class": {
                "$ref": "#/$defs/evidence"
              },
              "operating_condition_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "timebase_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "evidence_reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    }
  }
}
