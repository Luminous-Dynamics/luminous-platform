{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/mission-profile-corpus-v0.1.schema.json",
  "title": "Power Fabric rights-aware industrial mission profile corpus index",
  "description": "Index of separately versioned field-mission-profile records. Each profile file must independently validate against field-mission-profile-v0.1.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "record_class",
    "profiles",
    "rights_policy",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "corpus_id": {
      "const": "PF-MISSION-PROFILE-CORPUS-SYNTH-0.1"
    },
    "record_class": {
      "const": "synthetic_fixture"
    },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "profile_file",
          "application_family",
          "evidence_class",
          "suggested_holdout_group",
          "coverage_tags"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_file": {
            "type": "string",
            "pattern": "^schemas/.+\\.synthetic\\.json$"
          },
          "application_family": {
            "enum": [
              "construction_site",
              "industrial_maintenance",
              "plant_auxiliary",
              "remote_operations",
              "emergency_response",
              "other"
            ]
          },
          "evidence_class": {
            "const": "synthetic"
          },
          "suggested_holdout_group": {
            "type": "string",
            "minLength": 1
          },
          "coverage_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rights_policy": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_MISSION_PROFILE_CORPUS_ONLY_NOT_MEASURED_DUTY_OR_POWER_SYSTEM_QUALIFICATION"
    }
  }
}
