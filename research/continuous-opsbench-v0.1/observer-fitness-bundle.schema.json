{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-observer-fitness-bundle-v0.1.json",
  "title": "Continuous OpsBench known-answer observer fitness bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "batches"
  ],
  "properties": {
    "schema": {
      "const": "continuous-opsbench-observer-fitness-bundle-v0.1"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/batch"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "positive": {
      "type": "integer",
      "minimum": 0
    },
    "surface": {
      "enum": [
        "process_exec",
        "file_read",
        "object_read",
        "oracle_access",
        "network_connect",
        "dns_lookup",
        "namespace_change",
        "cgroup_membership",
        "observer_heartbeat",
        "event_stream_loss"
      ]
    },
    "expectation": {
      "enum": [
        "must_observe",
        "must_not_observe",
        "must_detect_loss"
      ]
    },
    "operation": {
      "enum": [
        "allowed_operation",
        "denied_operation",
        "negative_control",
        "induced_event_loss"
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown",
        "tampered"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "run_id",
        "manifest_commitment",
        "plan_digest",
        "created_at_ms",
        "runtime_observer_source_id",
        "runtime_observer_control_domain",
        "runtime_observer_adapter_digest",
        "runtime_kernel_profile_digest",
        "execution_environment_digest",
        "state_isolation_policy_digest",
        "artifact_access_policy_digest",
        "network_egress_policy_digest",
        "probe_injector_id",
        "probe_injector_control_domain",
        "fitness_verifier_id",
        "fitness_verifier_control_domain",
        "probes"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-fitness-plan-v0.1"
        },
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "manifest_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "created_at_ms": {
          "$ref": "#/$defs/time"
        },
        "runtime_observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_kernel_profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/sha256"
        },
        "state_isolation_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_access_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "network_egress_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "probe_injector_id": {
          "$ref": "#/$defs/id"
        },
        "probe_injector_control_domain": {
          "$ref": "#/$defs/id"
        },
        "fitness_verifier_id": {
          "$ref": "#/$defs/id"
        },
        "fitness_verifier_control_domain": {
          "$ref": "#/$defs/id"
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/probe_definition"
          }
        }
      }
    },
    "probe_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "surface",
        "expectation",
        "expected_event_class",
        "maximum_detection_latency_ms"
      ],
      "properties": {
        "probe_id": {
          "$ref": "#/$defs/id"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "expectation": {
          "$ref": "#/$defs/expectation"
        },
        "expected_event_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maximum_detection_latency_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "probe_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "batch_id",
        "plan_digest",
        "probe_id",
        "marker_digest",
        "surface",
        "expectation",
        "operation",
        "calibration_runtime_digest",
        "calibration_namespace_digest",
        "issued_at_ms",
        "executed_at_ms",
        "completed_at_ms",
        "injector_id",
        "injector_control_domain",
        "sequence"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-probe-injection-v0.1"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "probe_id": {
          "$ref": "#/$defs/id"
        },
        "marker_digest": {
          "$ref": "#/$defs/sha256"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "expectation": {
          "$ref": "#/$defs/expectation"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "calibration_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_namespace_digest": {
          "$ref": "#/$defs/sha256"
        },
        "issued_at_ms": {
          "$ref": "#/$defs/time"
        },
        "executed_at_ms": {
          "$ref": "#/$defs/time"
        },
        "completed_at_ms": {
          "$ref": "#/$defs/time"
        },
        "injector_id": {
          "$ref": "#/$defs/id"
        },
        "injector_control_domain": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observed_probe_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "probe_id",
        "marker_digest",
        "surface",
        "event_class",
        "calibration_runtime_digest",
        "observed_at_ms",
        "observer_source_id",
        "observer_control_domain",
        "sequence"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "probe_id": {
          "$ref": "#/$defs/id"
        },
        "marker_digest": {
          "$ref": "#/$defs/sha256"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "event_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "calibration_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at_ms": {
          "$ref": "#/$defs/time"
        },
        "observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observed_probe_loss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "probe_id",
        "marker_digest",
        "calibration_runtime_digest",
        "observed_at_ms",
        "dropped_event_count",
        "sequence_gap_count",
        "observer_source_id",
        "observer_control_domain",
        "sequence"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "probe_id": {
          "$ref": "#/$defs/id"
        },
        "marker_digest": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at_ms": {
          "$ref": "#/$defs/time"
        },
        "dropped_event_count": {
          "$ref": "#/$defs/positive"
        },
        "sequence_gap_count": {
          "$ref": "#/$defs/positive"
        },
        "observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fitness_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_digest",
        "batch_nonce_digest",
        "batch_id",
        "run_id",
        "manifest_commitment",
        "plan_digest",
        "runtime_observer_source_id",
        "runtime_observer_control_domain",
        "runtime_observer_adapter_digest",
        "runtime_kernel_profile_digest",
        "execution_environment_digest",
        "state_isolation_policy_digest",
        "artifact_access_policy_digest",
        "network_egress_policy_digest",
        "probe_injector_id",
        "probe_injector_control_domain",
        "fitness_verifier_id",
        "fitness_verifier_control_domain",
        "calibration_runtime_digest",
        "calibration_namespace_digest",
        "measurement_start_ms",
        "measurement_end_ms",
        "issued_at_ms",
        "valid_from_ms",
        "expires_at_ms",
        "clock_uncertainty_ms",
        "coverage",
        "unexplained_drop_count",
        "unexplained_sequence_gap_count",
        "injection_bundle_digest",
        "observation_bundle_digest",
        "loss_bundle_digest"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-observer-fitness-receipt-v0.1"
        },
        "receipt_digest": {
          "$ref": "#/$defs/sha256"
        },
        "batch_nonce_digest": {
          "$ref": "#/$defs/sha256"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "manifest_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "plan_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "runtime_observer_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_kernel_profile_digest": {
          "$ref": "#/$defs/sha256"
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/sha256"
        },
        "state_isolation_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_access_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "network_egress_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "probe_injector_id": {
          "$ref": "#/$defs/id"
        },
        "probe_injector_control_domain": {
          "$ref": "#/$defs/id"
        },
        "fitness_verifier_id": {
          "$ref": "#/$defs/id"
        },
        "fitness_verifier_control_domain": {
          "$ref": "#/$defs/id"
        },
        "calibration_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_namespace_digest": {
          "$ref": "#/$defs/sha256"
        },
        "measurement_start_ms": {
          "$ref": "#/$defs/time"
        },
        "measurement_end_ms": {
          "$ref": "#/$defs/time"
        },
        "issued_at_ms": {
          "$ref": "#/$defs/time"
        },
        "valid_from_ms": {
          "$ref": "#/$defs/time"
        },
        "expires_at_ms": {
          "$ref": "#/$defs/time"
        },
        "clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "unexplained_drop_count": {
          "$ref": "#/$defs/positive"
        },
        "unexplained_sequence_gap_count": {
          "$ref": "#/$defs/positive"
        },
        "injection_bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "observation_bundle_digest": {
          "$ref": "#/$defs/sha256"
        },
        "loss_bundle_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "injections",
        "observations",
        "loss_observations"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/fitness_receipt"
        },
        "injections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/probe_injection"
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/observed_probe_event"
          }
        },
        "loss_observations": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/observed_probe_loss"
          }
        }
      }
    }
  }
}
