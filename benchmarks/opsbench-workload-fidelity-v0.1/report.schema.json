{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://luminousdynamics.io/schemas/opsbench-workload-fidelity-report-v0.1.json",
 "title":"OpsBench workload-fidelity report v0.1",
 "type":"object","additionalProperties":false,
 "required":["schema","version","status","computed_disposition","study_id","run_id","episode_id","profile_sha256","phase_schedule_sha256","load_generator_receipts_sha256","service_observations_sha256","fault_controller_receipts_sha256","overall_aggregate_response_success_ratio","total_offered_requests","total_successful_responses","total_response_errors","total_response_timeouts","total_response_drops","total_server_rejections","total_server_retry_attempts","critical_class_failure_count","per_class","windows","publisher_authenticity_verified","population_capacity_claim_permitted","automatic_execution_authorized","claim_ceiling","report_sha256"],
 "properties":{
  "schema":{"const":"luminous-opsbench-workload-fidelity-report-v0.1"},
  "version":{"const":1},
  "status":{"enum":["example_only","qualified","fail","indeterminate"]},
  "computed_disposition":{"enum":["qualified","fail","indeterminate"]},
  "study_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"episode_id":{"type":"string","minLength":1},
  "profile_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "phase_schedule_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "load_generator_receipts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "service_observations_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "fault_controller_receipts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "overall_aggregate_response_success_ratio":{"type":"number","minimum":0,"maximum":1},
  "total_offered_requests":{"type":"integer","minimum":1},
  "total_successful_responses":{"type":"integer","minimum":0},
  "total_response_errors":{"type":"integer","minimum":0},
  "total_response_timeouts":{"type":"integer","minimum":0},
  "total_response_drops":{"type":"integer","minimum":0},
  "total_server_rejections":{"type":"integer","minimum":0},
  "total_server_retry_attempts":{"type":"integer","minimum":0},
  "critical_class_failure_count":{"type":"integer","minimum":0},
  "per_class":{
   "type":"object","minProperties":2,"additionalProperties":{
    "type":"object","additionalProperties":false,
    "required":["critical","offered_count","success_count","window_count","failed_window_count","indeterminate_window_count","response_error_count","response_timeout_count","response_drop_count","server_rejected_count","server_retry_attempt_count","response_success_ratio","response_error_ratio","response_timeout_ratio","response_drop_ratio","server_rejected_ratio","disposition"],
    "properties":{
     "critical":{"type":"boolean"},
     "offered_count":{"type":"integer","minimum":1},"success_count":{"type":"integer","minimum":0},
     "window_count":{"type":"integer","minimum":1},"failed_window_count":{"type":"integer","minimum":0},
     "indeterminate_window_count":{"type":"integer","minimum":0},
     "response_error_count":{"type":"integer","minimum":0},"response_timeout_count":{"type":"integer","minimum":0},
     "response_drop_count":{"type":"integer","minimum":0},"server_rejected_count":{"type":"integer","minimum":0},
     "server_retry_attempt_count":{"type":"integer","minimum":0},
     "response_success_ratio":{"type":"number","minimum":0,"maximum":1},
     "response_error_ratio":{"type":"number","minimum":0,"maximum":1},
     "response_timeout_ratio":{"type":"number","minimum":0,"maximum":1},
     "response_drop_ratio":{"type":"number","minimum":0,"maximum":1},
     "server_rejected_ratio":{"type":"number","minimum":0,"maximum":1},
     "disposition":{"enum":["pass","fail","indeterminate"]}
    }
   }
  },
  "windows":{"type":"array","minItems":1,"items":{
   "type":"object","additionalProperties":false,
   "required":["window_id","phase_id","phase_kind","class_id","offered_count","response_success_count","response_error_count","response_timeout_count","response_drop_count","observed_server_received_count","observed_server_rejected_count","observed_response_success_count","success_ratio","ingress_ratio","business_correctness_ratio","server_retry_attempts_per_100_offered","p95_latency_upper_bound_seconds","load_fidelity_reasons","disposition","reasons"],
   "properties":{
    "window_id":{"type":"string","minLength":1},"phase_id":{"type":"string","minLength":1},
    "phase_kind":{"enum":["nominal","burst","dependency_degradation","retry_pressure","recovery_hold"]},
    "class_id":{"type":"string","minLength":1},
    "offered_count":{"type":"integer","minimum":1},
    "response_success_count":{"type":"integer","minimum":0},"response_error_count":{"type":"integer","minimum":0},
    "response_timeout_count":{"type":"integer","minimum":0},"response_drop_count":{"type":"integer","minimum":0},
    "observed_server_received_count":{"type":"integer","minimum":0},"observed_server_rejected_count":{"type":"integer","minimum":0},
    "observed_response_success_count":{"type":"integer","minimum":0},
    "success_ratio":{"type":"number","minimum":0,"maximum":1},"ingress_ratio":{"type":"number","minimum":0,"maximum":1},
    "business_correctness_ratio":{"type":["number","null"],"minimum":0,"maximum":1},
    "server_retry_attempts_per_100_offered":{"type":"number","minimum":0},
    "p95_latency_upper_bound_seconds":{"type":["number","null"],"minimum":0},
    "load_fidelity_reasons":{"type":"array","items":{"type":"string"}},
    "disposition":{"enum":["pass","fail","indeterminate"]},
    "reasons":{"type":"array","items":{"type":"string"}}
   }
  }},
  "publisher_authenticity_verified":{"const":false},
  "population_capacity_claim_permitted":{"const":false},
  "automatic_execution_authorized":{"const":false},
  "claim_ceiling":{"type":"string","minLength":60},
  "report_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
 }
}