{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/benchmarks/technology-services-ops-v0.1/economic-cost.schema.json",
  "title": "Technology-Services OpsBench evaluator-owned economic cost sidecar",
  "description": "An optional per-episode cost ledger. It adds fully loaded cost without changing the v0.1 episode-result envelope. Unknown costs are null and never zero.",
  "type": "object",
  "required": ["schema", "version", "binding", "components"],
  "properties": {
    "schema": {"const": "luminous-technology-services-opsbench-economic-cost-v0.1"},
    "version": {"const": 1},
    "binding": {
      "type": "object",
      "required": ["run_id", "arm_id", "episode_id", "currency", "rate_card_digest", "allocation_policy_digest"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "arm_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "currency": {"const": "USD"},
        "rate_card_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "allocation_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["category", "status", "amount_microusd", "evidence_record_digest"],
        "properties": {
          "category": {"enum": ["model_runtime", "connector_api", "compute_infrastructure", "human_labor", "escalation_rework", "integration_support_amortization"]},
          "status": {"enum": ["measured", "allocated", "estimated", "not_applicable", "unknown"]},
          "amount_microusd": {
            "oneOf": [
              {"type": "integer", "minimum": 0},
              {"type": "null"}
            ]
          },
          "evidence_record_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
            "then": {"properties": {"amount_microusd": {"type": "null"}}}
          },
          {
            "if": {"properties": {"status": {"const": "not_applicable"}}, "required": ["status"]},
            "then": {"properties": {"amount_microusd": {"const": 0}}}
          },
          {
            "if": {"properties": {"status": {"enum": ["measured", "allocated", "estimated"]}}, "required": ["status"]},
            "then": {"properties": {"amount_microusd": {"type": "integer", "minimum": 0}}}
          }
        ],
        "additionalProperties": false
      },
      "allOf": [
        {"contains": {"properties": {"category": {"const": "model_runtime"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"category": {"const": "connector_api"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"category": {"const": "compute_infrastructure"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"category": {"const": "human_labor"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"category": {"const": "escalation_rework"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"category": {"const": "integration_support_amortization"}}, "required": ["category"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "additionalProperties": false
}
