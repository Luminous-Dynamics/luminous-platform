{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/opsbench-workload-phase-schedule-v0.1.json",
  "title": "OpsBench workload phase schedule v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "study_id",
    "profile_id",
    "window_seconds",
    "phases"
  ],
  "properties": {
    "schema": {
      "const": "luminous-opsbench-workload-phase-schedule-v0.1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "example_only",
        "registered_schedule"
      ]
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "window_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase_id",
          "kind",
          "started_at",
          "ended_at",
          "rate_multiplier_min",
          "rate_multiplier_max",
          "fault_id",
          "fault_action_sha256"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "nominal",
              "burst",
              "dependency_degradation",
              "retry_pressure",
              "recovery_hold"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "rate_multiplier_min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rate_multiplier_max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fault_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "fault_action_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
