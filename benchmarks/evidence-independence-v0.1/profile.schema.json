{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/evidence-independence-profile/0.1.0/schema.json",
  "title": "Luminous Evidence Independence Profile",
  "description": "A declaration of component identities, control domains, dependencies, and claim-specific independence requirements. This schema does not authenticate the declarations or prove that a domain identity is truthful.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "declared_at",
    "subject",
    "components",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_revision",
            "artifact_digest",
            "workload_identity",
            "service_identity",
            "fixture_identity"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "kind",
        "identity"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "domain_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "domain_ids",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "domain_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque_id"
          }
        },
        "evidence_refs": {
          "description": "References to evidence that establishes the declared domain membership. A reference is not itself verified by this schema.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "domain_ids": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "domain_ids": {
                "maxItems": 0
              },
              "evidence_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "relation"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "relation": {
          "enum": [
            "administered_by",
            "authorized_by",
            "built_by",
            "clocked_by",
            "communicates_through",
            "controls",
            "observes_input_from",
            "recovers_from",
            "replicates_to",
            "routes_through",
            "signs_with",
            "stores_in",
            "supervised_by",
            "verifies_with"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "role",
        "identity",
        "control_domains",
        "depends_on"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "control_domains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution",
            "administration",
            "authority",
            "state",
            "communication",
            "time",
            "construction",
            "observation"
          ],
          "properties": {
            "execution": {
              "$ref": "#/$defs/domain_binding"
            },
            "administration": {
              "$ref": "#/$defs/domain_binding"
            },
            "authority": {
              "$ref": "#/$defs/domain_binding"
            },
            "state": {
              "$ref": "#/$defs/domain_binding"
            },
            "communication": {
              "$ref": "#/$defs/domain_binding"
            },
            "time": {
              "$ref": "#/$defs/domain_binding"
            },
            "construction": {
              "$ref": "#/$defs/domain_binding"
            },
            "observation": {
              "$ref": "#/$defs/domain_binding"
            }
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "evidence_source_component_id",
        "independent_of_component_ids",
        "required_dimensions",
        "shared_domain_policy",
        "unknown_policy"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "evidence_source_component_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "independent_of_component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque_id"
          }
        },
        "required_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "execution",
              "administration",
              "authority",
              "state",
              "communication",
              "time",
              "construction",
              "observation"
            ]
          }
        },
        "shared_domain_policy": {
          "const": "fail"
        },
        "unknown_policy": {
          "const": "indeterminate"
        }
      }
    }
  }
}