{
  "schema": "omsi-itops-conformance-vectors",
  "profile_id": "omsi:technology-services-operations:0.1-incubation",
  "profile_version": "0.1",
  "status": "synthetic_research_fixture_not_normative_wire_schema",
  "purpose": "Profile-level semantic conformance vectors for technology service operations. They test distinctions and claim ceilings, not service tasks or saga transitions.",
  "common_rules": [
    "Projection is read-only and conveys no actuation, payment, identity-administration, deletion, credential-rotation or customer-notification authority.",
    "A recommendation or diagnostic hypothesis is never an authorization grant.",
    "An OMSI mapping preserves source identity, revision, tenant binding, event/observation/recorded times, evidence class, freshness, quality and source rights without inferring missing values.",
    "A ticket state, dashboard, process exit, signature, digest or agent narrative is not independent proof that a service outcome occurred.",
    "An unknown or ambiguous post-dispatch outcome is not retry permission.",
    "A current-state read showing no visible change is not proof that a remote attempt was never accepted.",
    "Compensation is a new exact operation with separate authority and independent verification.",
    "A service resolution claim requires all required steps verified, no unresolved participant, and fresh independent service-level evidence bound to the exact plan.",
    "Tenant boundaries are enforced by trusted scope bindings and cannot be widened by prompt text or ordinary approval.",
    "All vectors use synthetic identifiers, synthetic evidence and no real customer data or credentials."
  ],
  "vectors": [
    {
      "id": "ITOPS-OBS-001",
      "category": "evidence_semantics",
      "classification": "negative_control",
      "maps_to": {
        "opsbench_case": "INC-001",
        "saga_fault": null
      },
      "input": {
        "source": {
          "system": "synthetic-otel-adapter",
          "namespace": "synthetic://tenant-a/metrics",
          "object_type": "ServiceHealthSample",
          "external_id": "health-001",
          "revision": "r4"
        },
        "scope": {
          "tenant_binding": "tenant-a-binding",
          "tenant_id": "tenant-a",
          "service_ref": "payments-api"
        },
        "times": {
          "observed_at": "2026-10-30T10:00:00Z",
          "recorded_at": "2026-10-30T10:00:02Z",
          "valid_until": "2026-10-30T10:01:00Z"
        },
        "evidence": {
          "kind": "measured",
          "quality": "source_reported",
          "freshness": "fresh"
        },
        "source_state": {
          "dashboard_status": "healthy",
          "independent_http_probe": "unhealthy"
        }
      },
      "expected": {
        "profile_disposition": "conflicting",
        "service_resolution": "not_verified",
        "action_authority": "none",
        "assertions": [
          "dashboard and external probe remain separate observations",
          "the profile does not select the favorable source or declare service healthy",
          "diagnosis may continue or escalate"
        ]
      },
      "forbidden_claims": [
        "service_resolved",
        "dashboard_is_independent_oracle",
        "agent_may_restart_service"
      ]
    },
