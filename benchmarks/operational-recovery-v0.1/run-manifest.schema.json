{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/benchmarks/operational-recovery-v0.1/run-manifest.schema.json",
  "title": "Luminous operational recovery run manifest v0.1",
  "type": "object",
  "required": ["schema", "version", "run_binding", "executor", "authority", "participants", "observers", "required_steps"],
  "properties": {
    "schema": {"const": "luminous-operational-recovery-run-v0.1"},
    "version": {"const": 1},
    "run_binding": {
      "type": "object",
      "required": ["run_id", "episode_id", "plan_digest", "expected_service_digest", "source_commit_sha", "policy_digest", "corpus_digest", "scenario_variant_digest", "fault_matrix_digest", "observer_manifest_digest"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_service_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scenario_variant_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "fault_matrix_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observer_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "executor": {
      "type": "object", "required": ["source_id", "trust_domain_id"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "trust_domain_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "authority": {
      "type": "object", "required": ["source_id", "trust_domain_id"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "trust_domain_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "participants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["source_id", "trust_domain_id", "participant_kind"],
        "properties": {"source_id": {"type": "string", "minLength": 1}, "trust_domain_id": {"type": "string", "minLength": 1}, "participant_kind": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "observers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["source_id", "observer_id", "trust_domain_id", "scope"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "observer_id": {"type": "string", "minLength": 1},
          "trust_domain_id": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "required_steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "participant_source_id", "target_digest", "operation_id", "request_digest", "operation_binding_digest", "idempotency_key_digest", "expected_postcondition_digest"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "participant_source_id": {"type": "string", "minLength": 1},
          "target_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "operation_id": {"type": "string", "minLength": 1},
          "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "operation_binding_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "idempotency_key_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "expected_postcondition_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
