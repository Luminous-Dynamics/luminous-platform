      "allOf": [
        {
          "contains": {
            "const": "No claim of guaranteed delivery or exactly-once network transport"
          }
        },
        {
          "contains": {
            "const": "No claim that metadata validates payload encryption or authenticity"
          }
        },
        {
          "contains": {
            "const": "No claim of BPv7/BPSec interoperability before a named implementation is tested"
          }
        },
        {
          "contains": {
            "const": "No claim that a mesh provides global Internet without authorized upstream backhaul"
          }
        },
        {
          "contains": {
            "const": "No claim of safe public relay, lawful resale or spectrum authorization"
          }
        },
        {
          "contains": {
            "const": "No claim of emergency-grade telephony or emergency service"
          }
        },
        {
          "contains": {
            "const": "No claim of field performance from schemas, unit tests, simulation or queued CI"
          }
        },
        {
          "contains": {
            "const": "No claim of verified cache contents without source integrity evidence"
          }
        }
