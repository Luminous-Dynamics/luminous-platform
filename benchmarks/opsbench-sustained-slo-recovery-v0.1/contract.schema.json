{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-service-objective-contract-v0.1.json",
  "title":"OpsBench service objective contract v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","study_id","episode_id","run_id","service_id","service_digest","executor","observer","business_oracle","timeline","required_slis"],
  "properties":{
    "schema":{"const":"luminous-opsbench-service-objective-contract-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","preregistered"]},
    "study_id":{"type":"string","minLength":1},
    "episode_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "service_id":{"type":"string","minLength":1},
    "service_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "executor":{"type":"object","additionalProperties":false,"required":["source_id","trust_domain_id"],"properties":{"source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1}}},
    "observer":{"type":"object","additionalProperties":false,"required":["source_id","trust_domain_id"],"properties":{"source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1}}},
    "business_oracle":{"type":"object","additionalProperties":false,"required":["source_id","trust_domain_id"],"properties":{"source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1}}},
    "timeline":{
      "type":"object","additionalProperties":false,
      "required":["incident_started_at","evaluation_started_at","evaluation_ended_at","window_seconds","hold_window_count","minimum_request_count","minimum_synthetic_probe_count","minimum_business_check_count","maximum_gap_seconds"],
      "properties":{
        "incident_started_at":{"type":"string","format":"date-time"},
        "evaluation_started_at":{"type":"string","format":"date-time"},
        "evaluation_ended_at":{"type":"string","format":"date-time"},
        "window_seconds":{"type":"integer","minimum":1},
        "hold_window_count":{"type":"integer","minimum":2,"maximum":1000},
        "minimum_request_count":{"type":"integer","minimum":1},
        "minimum_synthetic_probe_count":{"type":"integer","minimum":1},
        "minimum_business_check_count":{"type":"integer","minimum":1},
        "maximum_gap_seconds":{"const":0}
      }
    },
    "required_slis":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "oneOf":[
          {
            "type":"object","additionalProperties":false,
            "required":["sli_id","kind","minimum_ratio"],
            "properties":{"sli_id":{"type":"string","minLength":1},"kind":{"const":"request_success_ratio"},"minimum_ratio":{"type":"number","minimum":0,"maximum":1}}
          },
          {
            "type":"object","additionalProperties":false,
            "required":["sli_id","kind","minimum_ratio"],
            "properties":{"sli_id":{"type":"string","minLength":1},"kind":{"const":"business_correctness_ratio"},"minimum_ratio":{"type":"number","minimum":0,"maximum":1}}
          },
          {
            "type":"object","additionalProperties":false,
            "required":["sli_id","kind","quantile","maximum_seconds"],
            "properties":{"sli_id":{"type":"string","minLength":1},"kind":{"const":"latency_quantile"},"quantile":{"type":"number","exclusiveMinimum":0,"maximum":1},"maximum_seconds":{"type":"number","exclusiveMinimum":0}}
          },
          {
            "type":"object","additionalProperties":false,
            "required":["sli_id","kind","minimum_units_per_second"],
            "properties":{"sli_id":{"type":"string","minLength":1},"kind":{"const":"goodput_minimum"},"minimum_units_per_second":{"type":"number","exclusiveMinimum":0}}
          },
          {
            "type":"object","additionalProperties":false,
            "required":["sli_id","kind","maximum_ratio"],
            "properties":{"sli_id":{"type":"string","minLength":1},"kind":{"const":"saturation_maximum"},"maximum_ratio":{"type":"number","minimum":0,"maximum":1}}
          }
        ]
      }
    }
  }
}