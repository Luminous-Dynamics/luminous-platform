{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-trust-policy-snapshot-v0.1.json",
  "title": "Continuous OpsBench offline verifier trust-policy snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_digest",
    "trust_roots_digest",
    "revocation_policy_digest",
    "verifier_id",
    "verifier_version",
    "verifier_digest",
    "verifier_control_domain",
    "valid_from_ms",
    "valid_until_ms",
    "maximum_artifact_bytes",
    "trusted_publishers"
  ],
  "properties": {
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "trust_roots_digest": {
      "$ref": "#/$defs/sha256"
    },
    "revocation_policy_digest": {
      "$ref": "#/$defs/sha256"
    },
    "verifier_id": {
      "$ref": "#/$defs/id"
    },
    "verifier_version": {
      "$ref": "#/$defs/id"
    },
    "verifier_digest": {
      "$ref": "#/$defs/sha256"
    },
    "verifier_control_domain": {
      "$ref": "#/$defs/id"
    },
    "valid_from_ms": {
      "type": "integer",
      "minimum": 0
    },
    "valid_until_ms": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "trusted_publishers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisher_id",
          "key_id",
          "key_digest",
          "control_domain",
          "source_id",
          "valid_from_ms",
          "valid_until_ms"
        ],
        "properties": {
          "publisher_id": {
            "$ref": "#/$defs/id"
          },
          "key_id": {
            "$ref": "#/$defs/id"
          },
          "key_digest": {
            "$ref": "#/$defs/sha256"
          },
          "control_domain": {
            "$ref": "#/$defs/id"
          },
          "source_id": {
            "$ref": "#/$defs/id"
          },
          "valid_from_ms": {
            "type": "integer",
            "minimum": 0
          },
          "valid_until_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
