{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:security:adaptive-authorization-evolution:0.1",
  "title": "Luminous Adaptive Authorization Assurance Protocol v0.1",
  "type": "object",
  "required": [
    "profile",
    "version",
    "status",
    "frozen_inputs",
    "mutation_boundary",
    "promotion_rule",
    "objective_dimensions",
    "search_budget",
    "isolation",
    "evaluation",
    "claim_ceiling"
  ],
  "properties": {
    "profile": {
      "const": "luminous-adaptive-authorization-evolution"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "enum": [
        "template_only",
        "synthetic_protocol_record",
        "qualified_experiment"
      ]
    },
    "frozen_inputs": {
