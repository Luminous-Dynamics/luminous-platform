{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-paired-power-plan-v0.1.json",
  "title":"OpsBench paired scenario-cluster power plan v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","study_id","preregistration_sha256","pilot_started_at","baseline_arm_id","candidate_arm_id","pilot_scenario_ids","pilot_clusters","planning_parameters"],
  "properties":{
    "schema":{"const":"luminous-opsbench-paired-power-plan-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","screening_pilot"]},
    "study_id":{"type":"string","minLength":1},
    "preregistration_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "pilot_started_at":{"type":"string","format":"date-time"},
    "baseline_arm_id":{"type":"string","minLength":1},
    "candidate_arm_id":{"type":"string","minLength":1},
    "pilot_scenario_ids":{"type":"array","minItems":5,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "pilot_clusters":{
      "type":"array","minItems":5,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["scenario_id","seed_count","baseline_success_rate","candidate_success_rate"],
        "properties":{
          "scenario_id":{"type":"string","minLength":1},
          "seed_count":{"type":"integer","minimum":1},
          "baseline_success_rate":{"type":["number","null"],"minimum":0,"maximum":1},
          "candidate_success_rate":{"type":["number","null"],"minimum":0,"maximum":1}
        }
      }
    },
    "planning_parameters":{
      "type":"object","additionalProperties":false,
      "required":["target_effect","target_power","familywise_alpha","candidate_comparison_count","variance_floor","safety_margin_fraction","minimum_confirmatory_scenarios","simulation_replicates","simulation_seed","sensitivity_effects","sensitivity_powers","sensitivity_comparison_counts"],
      "properties":{
        "target_effect":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "target_power":{"type":"number","exclusiveMinimum":0.5,"exclusiveMaximum":1},
        "familywise_alpha":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":0.5},
        "candidate_comparison_count":{"type":"integer","minimum":1,"maximum":100},
        "variance_floor":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "safety_margin_fraction":{"type":"number","minimum":0,"maximum":2},
        "minimum_confirmatory_scenarios":{"type":"integer","minimum":100},
        "simulation_replicates":{"type":"integer","minimum":100,"maximum":100000},
        "simulation_seed":{"type":"integer","minimum":0,"maximum":4294967295},
        "sensitivity_effects":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"number","exclusiveMinimum":0,"maximum":1}},
        "sensitivity_powers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"number","exclusiveMinimum":0.5,"exclusiveMaximum":1}},
        "sensitivity_comparison_counts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":100}}
      }
    }
  }
}