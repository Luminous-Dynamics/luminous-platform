      "topology": "both_paths_meet_deadline_but_one_is_more_expensive",
      "purpose": "measure cost efficiency without deadline regression"
    },
    {
      "id": "UTL-05",
      "topology": "all_paths_deadline_infeasible",
      "purpose": "prevent resource waste on infeasible tasks"
    },
    {
      "id": "UTL-06",
      "topology": "partial_useful_delivery_with_late_remaining_payload",
      "purpose": "late bytes are separated from timely bytes"
    },
    {
      "id": "UTL-07",
      "topology": "high_throughput_high_rtt_vs_lower_throughput_low_tail_latency",
      "purpose": "capture application completion and latency tails"
    },
    {
      "id": "UTL-08",
      "topology": "redundant_transmission_improves_success_but_consumes_shared_backhaul",
      "purpose": "enforce resource-incidence residual capacity"
    },
    {
      "id": "UTL-09",
      "topology": "raw_throughput_increases_while_companion_tcp_or_quic_is_starved",
      "purpose": "reject network-wide fairness regression"
    },
    {
      "id": "UTL-10",
      "topology": "congestion_burst_after_scheduler_learning",
      "purpose": "measure recovery and regret without assuming an adaptive scheduler"
    },
    {
      "id": "UTL-11",
      "topology": "deadline_or_cost_metadata_missing_stale_or_inconsistent",
