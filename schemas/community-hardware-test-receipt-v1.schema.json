{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/community-hardware-test-receipt-v1.schema.json",
  "title": "Luminous Community Hardware Test Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "receipt_id",
    "generated_at",
    "subject",
    "campaign",
    "environment",
    "results",
    "overall_disposition",
    "evidence_class",
    "limitations",
    "evidence_artifacts",
    "review_refs",
    "deployment_authorization",
    "maturity_promotion"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.hardware-test-receipt.v1"
    },
    "record_status": {
      "enum": [
        "synthetic_example",
        "community_submission"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9:_./-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "campaign": {
      "$ref": "#/$defs/campaign"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test_result"
      }
    },
    "overall_disposition": {
      "enum": [
        "pass",
        "fail",
        "incomplete",
        "indeterminate",
        "unsafe_to_continue"
      ]
    },
    "evidence_class": {
      "enum": [
        "designed",
        "static_checked",
        "unit_contract_tested",
        "vm_simulated",
        "bench_measured",
        "field_observed",
        "independently_reviewed_qualified"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "uniqueItems": true
    },
    "deployment_authorization": {
      "const": "not_conveyed"
    },
    "maturity_promotion": {
      "const": "none"
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableUri": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_item_id",
        "manufacturer",
        "model",
        "hardware_revision",
        "unit_ref",
        "unit_identity_method",
        "firmware_components",
        "source_manifest_digest"
      ],
      "properties": {
        "portfolio_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 2
        },
        "model": {
          "type": "string",
          "minLength": 2
        },
        "hardware_revision": {
          "type": "string",
          "minLength": 2
        },
        "unit_ref": {
          "type": "string",
          "minLength": 6,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:_./-]+$"
        },
        "unit_identity_method": {
          "enum": [
            "synthetic_fixture",
            "label_and_visual_inspection",
            "software_inventory",
            "cryptographic_device_identity",
            "serial_retained_privately",
            "unknown"
          ]
        },
        "firmware_components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/firmware_component"
          }
        },
        "source_manifest_digest": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "firmware_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "digest_sha256",
        "source_url",
        "openness"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "digest_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "source_url": {
          "$ref": "#/$defs/nullableUri"
        },
        "openness": {
          "enum": [
            "source_available_license_reviewed",
            "source_available_license_unreviewed",
            "binary_only",
            "mixed_open_and_closed",
            "unknown",
            "not_applicable"
          ]
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "suite_id",
        "suite_version",
        "suite_source_revision",
        "suite_sha256",
        "runner_source_revision",
        "runner_sha256",
        "profile_id",
        "diagnostic_output_format",
        "diagnostic_format_revision",
        "parameters_sha256"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 4
        },
        "suite_id": {
          "type": "string",
          "minLength": 3
        },
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "suite_source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 7
        },
        "suite_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 7
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_id": {
          "type": "string",
          "minLength": 3
        },
        "diagnostic_output_format": {
          "enum": [
            "ocpdiag_jsonl_v2",
            "junit_xml",
            "json",
            "other_versioned"
          ]
        },
        "diagnostic_format_revision": {
          "type": "string",
          "minLength": 1
        },
        "parameters_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "host_os",
        "kernel_or_runtime",
        "architecture",
        "deployment_lock_sha256",
        "network_isolated",
        "operator_ref",
        "location_class",
        "instrumentation",
        "conditions"
      ],
      "properties": {
        "execution_mode": {
          "enum": [
            "static",
            "unit_test",
            "vm_simulated",
            "physical_bench",
            "field_observation",
            "independent_lab"
          ]
        },
        "host_os": {
          "type": "string",
          "minLength": 2
        },
        "kernel_or_runtime": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 3
        },
        "deployment_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "network_isolated": {
          "type": "boolean"
        },
        "operator_ref": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:_./@-]+$"
        },
        "location_class": {
          "enum": [
            "vm_or_simulator",
            "home_lab",
            "makerspace",
            "repair_shop",
            "university_lab",
            "commercial_lab",
            "customer_site_redacted",
            "unknown"
          ]
        },
        "instrumentation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instrument"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_ref",
        "instrument_type",
        "calibration_state",
        "calibration_evidence_digest"
      ],
      "properties": {
        "instrument_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "instrument_type": {
          "type": "string",
          "minLength": 2
        },
        "calibration_state": {
          "enum": [
            "current",
            "expired",
            "not_required",
            "unknown"
          ]
        },
        "calibration_evidence_digest": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "test_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "test_version",
        "status",
        "expected",
        "observed_summary",
        "measurements",
        "evidence_refs"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "test_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped",
            "not_run",
            "indeterminate",
            "unsafe_to_continue"
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 5
        },
        "observed_summary": {
          "type": "string",
          "minLength": 5
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value",
        "unit",
        "sample_count",
        "instrument_ref",
        "calibration_state"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 2
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "instrument_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "calibration_state": {
          "enum": [
            "current",
            "expired",
            "not_required",
            "unknown"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_sha256",
        "media_type",
        "purpose",
        "visibility",
        "redaction_state"
      ],
      "properties": {
        "digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 3
        },
        "visibility": {
          "enum": [
            "public",
            "restricted",
            "withheld"
          ]
        },
        "redaction_state": {
          "enum": [
            "reviewed_redacted",
            "not_sensitive",
            "not_reviewed_do_not_publish",
            "redaction_incomplete"
          ]
        },
        "retrieval_uri": {
          "$ref": "#/$defs/nullableUri"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_ref",
        "key_ref",
        "algorithm",
        "signed_payload_sha256",
        "signature_artifact_sha256"
      ],
      "properties": {
        "issuer_ref": {
          "type": "string",
          "minLength": 3
        },
        "key_ref": {
          "type": "string",
          "minLength": 3
        },
        "algorithm": {
          "enum": [
            "ed25519",
            "ecdsa_p256_sha256",
            "rsa_pss_sha256",
            "other_documented"
          ]
        },
        "signed_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
