              "root_grant_ref": {
                "type": "string",
                "minLength": 1
              },
              "leaf_grant_ref": {
                "type": "string",
                "minLength": 1
              },
              "root_task_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "leaf_task_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "leaf_plan_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "request_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "target_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
