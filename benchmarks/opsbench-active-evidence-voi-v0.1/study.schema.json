{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://luminousdynamics.io/schemas/opsbench-active-evidence-study-v0.1.json",
 "title":"OpsBench active evidence acquisition study v0.1",
 "type":"object","additionalProperties":false,
 "required":["schema","version","status","study_id","scope_id","hypotheses","actions","probes","authorized_probe_sources","policy","fixed_runbook_order","scenarios"],
 "properties":{
  "schema":{"const":"luminous-opsbench-active-evidence-study-v0.1"},
  "version":{"const":1},"status":{"enum":["example_only","registered_study"]},
  "study_id":{"type":"string","minLength":1},"scope_id":{"type":"string","minLength":1},
  "hypotheses":{"type":"array","minItems":2,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["hypothesis_id","family"],"properties":{"hypothesis_id":{"type":"string","minLength":1},"family":{"type":"string","minLength":1}}}},
  "actions":{"type":"array","minItems":2,"maxItems":64,"items":{
   "type":"object","additionalProperties":false,
   "required":["action_id","target_hypothesis","mutating","loss_by_hypothesis"],
   "properties":{
    "action_id":{"type":"string","minLength":1},
    "target_hypothesis":{"type":["string","null"]},
    "mutating":{"type":"boolean"},
    "loss_by_hypothesis":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":1}}
   }
  }},
  "probes":{"type":"array","minItems":2,"maxItems":128,"items":{
   "type":"object","additionalProperties":false,
   "required":["probe_id","source_id","trust_domain_id","correlation_group","read_only","scope_id","freshness_ttl_seconds","cost_units","latency_ms","privacy_penalty_units","human_seconds","likelihoods"],
   "properties":{
    "probe_id":{"type":"string","minLength":1},
    "source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1},
    "correlation_group":{"type":"string","minLength":1},
    "read_only":{"const":true},"scope_id":{"type":"string","minLength":1},
    "freshness_ttl_seconds":{"type":"integer","minimum":1},
    "cost_units":{"type":"number","minimum":0},"latency_ms":{"type":"integer","minimum":0},
    "privacy_penalty_units":{"type":"number","minimum":0},"human_seconds":{"type":"number","minimum":0},
    "likelihoods":{"type":"object","minProperties":2,"additionalProperties":{
     "type":"object","additionalProperties":false,"required":["signal","clear"],
     "properties":{"signal":{"type":"number","minimum":0,"maximum":1},"clear":{"type":"number","minimum":0,"maximum":1}}
    }}
   }
  }},
  "authorized_probe_sources":{"type":"array","minItems":2,"uniqueItems":true,"items":{
   "type":"object","additionalProperties":false,"required":["source_id","trust_domain_id","scope_id"],
   "properties":{"source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1},"scope_id":{"type":"string","minLength":1}}
  }},
  "policy":{"type":"object","additionalProperties":false,"required":["max_action_risk","max_cost_units","max_latency_ms","max_privacy_penalty_units","max_human_seconds","max_probes","random_seed"],"properties":{
   "max_action_risk":{"type":"number","minimum":0,"maximum":1},"max_cost_units":{"type":"number","minimum":0},
   "max_latency_ms":{"type":"integer","minimum":0},"max_privacy_penalty_units":{"type":"number","minimum":0},
   "max_human_seconds":{"type":"number","minimum":0},"max_probes":{"type":"integer","minimum":1,"maximum":128},
   "random_seed":{"type":"integer","minimum":0,"maximum":4294967295}
  }},
  "fixed_runbook_order":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
  "scenarios":{"type":"array","minItems":2,"maxItems":10000,"items":{
   "type":"object","additionalProperties":false,"required":["scenario_id","truth_hypothesis","prior","outcome_deck"],
   "properties":{
    "scenario_id":{"type":"string","minLength":1},"truth_hypothesis":{"type":"string","minLength":1},
    "prior":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "outcome_deck":{"type":"array","minItems":2,"maxItems":128,"items":{
     "type":"object","additionalProperties":false,"required":["probe_id","evidence_id","source_id","trust_domain_id","outcome","age_seconds"],
     "properties":{
      "probe_id":{"type":"string","minLength":1},"evidence_id":{"type":"string","minLength":1},
      "source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1},
      "outcome":{"enum":["signal","clear"]},"age_seconds":{"type":"integer","minimum":0}
     }
    }}
   }
  }}
 }
}