{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-monitoring-evaluator-truth-v0.1.json",
  "title": "Continuous OpsBench evaluator-only hidden monitoring event truth v0.1",
  "description": "Evaluator-only data. Never mount, serialize into prompts, or expose to agent tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "task_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "continuous-opsbench-monitoring-truth-v0.1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "scenario_id",
        "task_id",
        "condition_digest",
        "required_action_digest",
        "starts_at_ms",
        "expires_at_ms",
        "requires_action"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "condition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_action_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "starts_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requires_action": {
          "type": "boolean"
        }
      }
    }
  }
}
