{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-service-observation-windows-v0.1.json",
  "title":"OpsBench service observation windows v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","contract_sha256","study_id","episode_id","run_id","windows"],
  "properties":{
    "schema":{"const":"luminous-opsbench-service-observation-windows-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","captured"]},
    "contract_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "study_id":{"type":"string","minLength":1},
    "episode_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "windows":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["window_id","started_at","ended_at","observer_source_id","observer_trust_domain_id","business_oracle_source_id","business_oracle_trust_domain_id","request_count","successful_request_count","synthetic_probe_count","successful_synthetic_probe_count","business_check_count","correct_business_check_count","latency_histogram","goodput_units","saturation_ratio"],
        "properties":{
          "window_id":{"type":"string","minLength":1},
          "started_at":{"type":"string","format":"date-time"},
          "ended_at":{"type":"string","format":"date-time"},
          "observer_source_id":{"type":"string","minLength":1},
          "observer_trust_domain_id":{"type":"string","minLength":1},
          "business_oracle_source_id":{"type":"string","minLength":1},
          "business_oracle_trust_domain_id":{"type":"string","minLength":1},
          "request_count":{"type":"integer","minimum":0},
          "successful_request_count":{"type":"integer","minimum":0},
          "synthetic_probe_count":{"type":"integer","minimum":0},
          "successful_synthetic_probe_count":{"type":"integer","minimum":0},
          "business_check_count":{"type":"integer","minimum":0},
          "correct_business_check_count":{"type":"integer","minimum":0},
          "latency_histogram":{
            "type":["object","null"],"additionalProperties":false,
            "required":["unit","buckets"],
            "properties":{
              "unit":{"const":"s"},
              "buckets":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["upper_bound_seconds","count"],"properties":{"upper_bound_seconds":{"type":["number","null"],"exclusiveMinimum":0},"count":{"type":"integer","minimum":0}}}}
            }
          },
          "goodput_units":{"type":["number","null"],"minimum":0},
          "saturation_ratio":{"type":["number","null"],"minimum":0,"maximum":1}
        }
      }
    }
  }
}