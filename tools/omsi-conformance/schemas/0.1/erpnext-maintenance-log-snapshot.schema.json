{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERPNext v16.51.0 Asset Maintenance Log snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "exported_at",
    "plan",
    "task",
    "log"
  ],
  "properties": {
    "schema": {
      "const": "org.omsi.erpnext-maintenance-log-snapshot/0.1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "instance_namespace",
        "release_tag",
        "repository_commit",
        "license"
      ],
      "properties": {
        "system": {
          "const": "ERPNext"
        },
        "instance_namespace": {
          "type": "string",
          "minLength": 1
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "repository_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "company_id",
        "asset_name",
        "task_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "company_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_name": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "maintenance_type",
        "periodicity",
        "certificate_required",
        "assigned_user_present",
        "next_due_date",
        "last_completion_date"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "maintenance_type": {
          "enum": [
            "Preventive Maintenance",
            "Calibration"
          ]
        },
        "periodicity": {
          "enum": [
            "Daily",
            "Weekly",
            "Monthly",
            "Quarterly",
            "Half-yearly",
            "Yearly",
            "2 Yearly",
            "3 Yearly"
          ]
        },
        "certificate_required": {
          "type": "boolean"
        },
        "assigned_user_present": {
          "type": "boolean"
        },
        "next_due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_completion_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "docstatus",
        "asset_maintenance_id",
        "task_id",
        "maintenance_status",
        "due_date",
        "completion_date",
        "has_certificate",
        "certificate_attachment_present",
        "actions_performed_present",
        "amended_from"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "docstatus": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "asset_maintenance_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "maintenance_status": {
          "enum": [
            "Planned",
            "Completed",
            "Cancelled",
            "Overdue"
          ]
        },
        "due_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_certificate": {
          "type": "boolean"
        },
        "certificate_attachment_present": {
          "type": "boolean"
        },
        "actions_performed_present": {
          "type": "boolean"
        },
        "amended_from": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
