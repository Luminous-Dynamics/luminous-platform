{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/operational-evidence-publisher-policy-v0.1.json",
  "title":"Operational evidence publisher policy v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","policy_id","payload_type","statement_type","predicate_type","trusted_oidc_issuers","trusted_spiffe_trust_domains","verification_requirements","publishers"],
  "properties":{
    "schema":{"const":"luminous-operational-evidence-publisher-policy-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","research_policy"]},
    "policy_id":{"type":"string","minLength":1},
    "payload_type":{"const":"application/vnd.in-toto+json"},
    "statement_type":{"const":"https://in-toto.io/Statement/v1"},
    "predicate_type":{"const":"https://luminousdynamics.io/attestations/operational-recovery/v0.1"},
    "trusted_oidc_issuers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","format":"uri","pattern":"^https://"}},
    "trusted_spiffe_trust_domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*$"}},
    "verification_requirements":{
      "type":"object","additionalProperties":false,
      "required":["require_signature","require_exact_identity","require_trusted_issuer","require_certificate_valid_at_signing_time","revocation_unavailable_result","require_transparency_inclusion","require_transparency_checkpoint_consistency"],
      "properties":{
        "require_signature":{"const":true},
        "require_exact_identity":{"const":true},
        "require_trusted_issuer":{"const":true},
        "require_certificate_valid_at_signing_time":{"const":true},
        "revocation_unavailable_result":{"const":"indeterminate"},
        "require_transparency_inclusion":{"const":true},
        "require_transparency_checkpoint_consistency":{"const":true}
      }
    },
    "publishers":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["source_id","source_kind","trust_domain_id","identity_profile_id","identity","allowed_event_types","transparency"],
        "properties":{
          "source_id":{"type":"string","minLength":1},
          "source_kind":{"enum":["coordinator","authority_adapter","participant","participant_ledger","independent_observer","evaluator"]},
          "trust_domain_id":{"type":"string","minLength":1},
          "identity_profile_id":{"type":"string","minLength":1},
          "identity":{
            "oneOf":[
              {
                "type":"object","additionalProperties":false,
                "required":["profile","oidc_issuer","oidc_subject"],
                "properties":{
                  "profile":{"const":"sigstore_oidc"},
                  "oidc_issuer":{"type":"string","format":"uri","pattern":"^https://","minLength":1},
                  "oidc_subject":{"type":"string","minLength":1}
                }
              },
              {
                "type":"object","additionalProperties":false,
                "required":["profile","spiffe_id","spiffe_trust_domain","trust_bundle_sha256"],
                "properties":{
                  "profile":{"const":"spiffe_x509_svid"},
                  "spiffe_id":{"type":"string","pattern":"^spiffe://[^/]+/.+$"},
                  "spiffe_trust_domain":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*$"},
                  "trust_bundle_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
                }
              }
            ]
          },
          "allowed_event_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "transparency":{
            "type":"object","additionalProperties":false,
            "required":["mode","failure_action","log_policy_id"],
            "properties":{
              "mode":{"const":"required"},
              "failure_action":{"const":"reject"},
              "log_policy_id":{"type":"string","minLength":1}
            }
          }
        }
      }
    }
  }
}