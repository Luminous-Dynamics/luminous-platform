{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/continuous-opsbench-access-audit-v0.1.json",
  "title": "Continuous OpsBench runtime access audit v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "coverage",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "continuous-opsbench-access-audit-v0.1"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 2000000,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "arm": {
      "enum": [
        "candidate",
        "baseline"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "trial_id",
        "arm",
        "manifest_commitment",
        "observer_source_id",
        "observer_control_domain",
        "observer_adapter_digest",
        "monitor_session_digest",
        "state_isolation_policy_digest",
        "artifact_access_policy_digest",
        "network_egress_policy_digest",
        "measurement_start_ms",
        "measurement_end_ms",
        "clock_uncertainty_ms",
        "first_sequence",
        "last_sequence",
        "event_count",
        "heartbeat_count",
        "dropped_event_count",
        "sequence_gap_count",
        "complete",
        "event_stream_commitment"
      ],
      "properties": {
        "schema": {
          "const": "continuous-opsbench-access-audit-v0.1"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "arm": {
          "$ref": "#/$defs/arm"
        },
        "manifest_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "observer_adapter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "monitor_session_digest": {
          "$ref": "#/$defs/sha256"
        },
        "state_isolation_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_access_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "network_egress_policy_digest": {
          "$ref": "#/$defs/sha256"
        },
        "measurement_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "first_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "heartbeat_count": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "event_stream_commitment": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trial_id",
        "arm",
        "manifest_commitment",
        "monitor_session_digest",
        "sequence",
        "observed_at_ms",
        "clock_uncertainty_ms",
        "observer_source_id",
        "observer_control_domain",
        "operation",
        "resource_class",
        "resource_token_digest",
        "content_digest",
        "destination_digest",
        "allowlist_entry_digest",
        "state_namespace_digest",
        "decision",
        "bytes_requested",
        "bytes_returned"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "trial_id": {
          "$ref": "#/$defs/id"
        },
        "arm": {
          "$ref": "#/$defs/arm"
        },
        "manifest_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "monitor_session_digest": {
          "$ref": "#/$defs/sha256"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "observer_source_id": {
          "$ref": "#/$defs/id"
        },
        "observer_control_domain": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "enum": [
            "artifact_read",
            "artifact_write",
            "workspace_read",
            "workspace_write",
            "cache_read",
            "cache_write",
            "dns_lookup",
            "network_connect",
            "network_request",
            "network_response"
          ]
        },
        "resource_class": {
          "enum": [
            "case_payload",
            "public_evidence",
            "private_oracle",
            "grader",
            "secret",
            "workspace",
            "cache",
            "toolchain",
            "network_endpoint",
            "unknown"
          ]
        },
        "resource_token_digest": {
          "$ref": "#/$defs/sha256"
        },
        "content_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowlist_entry_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_namespace_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "enum": [
            "allowed",
            "denied"
          ]
        },
        "bytes_requested": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_returned": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
