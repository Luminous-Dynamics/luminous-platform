{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/edge-policy-observation-receipt-v1.schema.json",
  "title": "Luminous Edge Policy Observation Receipt v1",
  "description": "Bounded observation input for deterministic conformance reconciliation. This is not authenticated evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "evidence_class",
    "corpus_sha256",
    "approved_policy_sha256",
    "effective_config_sha256",
    "target_token",
    "time_basis",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "synthetic_fixture",
        "lab_observation_claim",
        "namespace_lab_observation"
      ]
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "effective_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_token": {
      "type": "string",
      "pattern": "^target-[a-z0-9-]{1,48}$"
    },
    "time_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clock_id",
        "wall_anchor_unix_ms",
        "monotonic_origin_ms"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "synthetic",
            "monotonic_with_wall_anchor"
          ]
        },
        "clock_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
        },
        "wall_anchor_unix_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "monotonic_origin_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "case_id",
          "observed_outcome",
          "evidence_source",
          "observed_at_unix_ms",
          "monotonic_elapsed_ms",
          "duration_ms",
          "evidence_sha256",
          "effective_policy_sha256"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^OBS-[A-Za-z0-9-]{1,96}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^EPC-[0-9]{3,5}$"
          },
          "observed_outcome": {
            "type": "string",
            "enum": [
              "permitted",
              "blocked",
              "inconclusive",
              "not_run"
            ]
          },
          "evidence_source": {
            "type": "string",
            "enum": [
              "independent_dataplane_probe",
              "control_plane_ack",
              "simulator_prediction",
              "policy_match_prediction",
              "synthetic_fixture"
            ]
          },
          "observed_at_unix_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "monotonic_elapsed_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_policy_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
