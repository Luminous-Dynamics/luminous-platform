{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:omsi:syncaas-annex-g-fixtures:0.1",
  "title": "OMSI ITU-T G.8275 Annex G SyncaaS fixture pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "state",
    "standard",
    "default_window_seconds",
    "semantics",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "omsi.syncaas.annex-g-fixture-pack"
    },
    "version": {
      "const": "0.1.0-draft"
    },
    "state": {
      "const": "SYNTHETIC_INPUT_FIXTURES_EXECUTABLE"
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation",
        "edition",
        "annex",
        "optional",
        "dataset_name",
        "record_name"
      ],
      "properties": {
        "recommendation": {
          "const": "ITU-T G.8275"
        },
        "edition": {
          "const": "01/2026"
        },
        "annex": {
          "const": "G"
        },
        "optional": {
          "const": true
        },
        "dataset_name": {
          "const": "ptpServiceAvailabilityPerformanceMetricsDS"
        },
        "record_name": {
          "const": "ptpServiceAvailabilityPerformanceMetricsDataRecord"
        }
      }
    },
    "default_window_seconds": {
      "const": 10
    },
    "semantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataset",
          "profile",
          "criterion",
          "window_seconds",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SVC-[A-Z0-9-]+$"
          },
          "dataset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "supported",
              "enable"
            ],
            "properties": {
              "supported": {
                "type": "boolean"
              },
              "enable": {
                "type": "boolean"
              }
            }
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itu_t_profile",
              "edition"
            ],
            "properties": {
              "itu_t_profile": {
                "enum": [
                  "G.8275.1",
                  "G.8275.2"
                ]
              },
              "edition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "criterion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "threshold_ref",
              "classification_source_ref"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1
              },
              "threshold_ref": {
                "type": "string",
                "minLength": 1
              },
              "classification_source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "window_seconds": {
            "const": 10
          },
          "pm_periods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "wall_seconds",
                "maintenance_paused_seconds"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "wall_seconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "maintenance_paused_seconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sequence",
                "period_id",
                "criterion_state",
                "maintenance_window"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "period_id": {
                  "type": "string"
                },
                "criterion_state": {
                  "enum": [
                    "N1S",
                    "D1S",
                    "UNOBSERVED"
                  ]
                },
                "maintenance_window": {
                  "type": "boolean"
                }
              }
            }
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "period_id",
                "index",
                "measurementValid",
                "periodComplete",
                "PMTime",
                "AS",
                "UAS"
              ],
              "properties": {
                "period_id": {
                  "type": "string"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "measurementValid": {
                  "type": "boolean"
                },
                "periodComplete": {
                  "type": "boolean"
                },
                "PMTime": {
                  "type": "string",
                  "minLength": 1
                },
                "AS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "UAS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "final_state",
              "reason_codes",
              "AS_by_period",
              "UAS_by_period"
            ],
            "properties": {
              "status": {
                "enum": [
                  "QUALIFIED",
                  "NOT_SUPPORTED",
                  "DISABLED",
                  "INDETERMINATE",
                  "COUNTER_MISMATCH",
                  "INVALID_INPUT",
                  "NOT_COMPARABLE",
                  "REFERENCE_DISAGREEMENT"
                ]
              },
              "final_state": {
                "enum": [
                  "AVAILABLE",
                  "UNAVAILABLE",
                  "UNKNOWN"
                ]
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "AS_by_period": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "UAS_by_period": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
