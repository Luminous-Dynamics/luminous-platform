{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/mission-energy-envelope-v0.1.schema.json",
  "title": "Luminous Power Fabric mission energy envelope",
  "description": "A time-indexed, evidence-bearing interval-energy accounting contract. It is not dispatch control or physical qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "qualified_configuration_sha256",
    "observed_configuration_sha256",
    "evaluation_time_epoch_s",
    "qualification_valid_until_epoch_s",
    "maximum_unserved_energy_wh",
    "segments",
    "storage",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "mission_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "qualified_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "observed_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "evaluation_time_epoch_s": { "type": "integer", "minimum": 0 },
    "qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
    "maximum_unserved_energy_wh": { "type": "number", "minimum": 0 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "start_s",
          "duration_s",
          "required_service_power_w",
          "maximum_unserved_energy_wh",
          "qualified_source_average_power_w",
          "source_measurement_uncertainty_bound_w",
          "source_model_uncertainty_bound_w",
          "qualified_source_configuration_sha256",
          "observed_source_configuration_sha256",
          "source_qualification_valid_until_epoch_s",
          "source_evidence_status",
          "source_evidence_reference"
        ],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "start_s": { "type": "number", "minimum": 0 },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "required_service_power_w": { "type": "number", "minimum": 0 },
          "maximum_unserved_energy_wh": { "type": "number", "minimum": 0 },
          "qualified_source_average_power_w": { "type": "number", "minimum": 0 },
          "source_measurement_uncertainty_bound_w": { "type": "number", "minimum": 0 },
          "source_model_uncertainty_bound_w": { "type": "number", "minimum": 0 },
          "qualified_source_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "observed_source_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "source_qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
          "source_evidence_status": {
            "enum": ["current", "missing", "expired", "invalid", "unverified"]
          },
          "source_evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "storage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "storage_id",
        "qualified_configuration_sha256",
        "observed_configuration_sha256",
        "qualification_valid_until_epoch_s",
        "capability_status",
        "calibration_status",
        "sensor_status",
        "protection_status",
        "capacity_wh",
        "capacity_uncertainty_bound_wh",
        "initial_soc_fraction",
        "initial_soc_uncertainty_fraction",
        "minimum_soc_fraction",
        "maximum_soc_fraction",
        "end_of_mission_minimum_soc_fraction",
        "maximum_charge_power_w",
        "maximum_discharge_power_w",
        "charge_efficiency",
        "discharge_efficiency",
        "evidence_reference"
      ],
      "properties": {
        "storage_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "qualified_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "observed_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
        "capability_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
        "calibration_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
        "sensor_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
        "protection_status": { "enum": ["ready", "tripped", "faulted", "bypassed", "unknown"] },
        "capacity_wh": { "type": "number", "exclusiveMinimum": 0 },
        "capacity_uncertainty_bound_wh": { "type": "number", "minimum": 0 },
        "initial_soc_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "initial_soc_uncertainty_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_soc_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_soc_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "end_of_mission_minimum_soc_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_charge_power_w": { "type": "number", "minimum": 0 },
        "maximum_discharge_power_w": { "type": "number", "minimum": 0 },
        "charge_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "discharge_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "claim_ceiling": {
      "const": "MISSION_ENERGY_ACCOUNTING_SCREEN_ONLY_NOT_DISPATCH_CONTROL_OR_PHYSICAL_QUALIFICATION"
    }
  }
}