  "execution_stage": "deterministic_paired_trial_evaluator_only",
  "objective": "Compare deadline-qualified useful application work, task value, cost, energy, redundancy and companion-flow retention across matched network protocol/scheduler trials without implementing packet scheduling or network actuation.",
  "optimization_contract": {
    "primary_objective": "maximize_on_time_useful_task_value",
    "secondary_dimensions": [
