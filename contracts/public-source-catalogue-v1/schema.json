{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/public-source-catalogue-v1.json",
  "title": "Luminous Public Source Catalogue V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_revision",
    "reviewed_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "public-source-catalogue-v1"
    },
    "catalogue_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "display_name",
        "jurisdiction",
        "publisher",
        "source_url",
        "documentation_url",
        "source_type",
        "access",
        "terms",
        "data_scope",
        "known_limitations",
        "ingestion"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "jurisdiction": {
          "type": "string",
          "enum": [
            "ZA",
            "ZA-GP-JHB"
          ]
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "url": {
              "$ref": "#/$defs/httpsUri"
            }
          }
        },
        "source_url": {
          "$ref": "#/$defs/httpsUri"
        },
        "documentation_url": {
          "$ref": "#/$defs/httpsUri"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "municipal_finance_api",
            "procurement_open_data",
            "public_service_information"
          ]
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "documented_methods",
            "transport_policy",
            "transport_verification"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "public_api",
                "public_bulk_download",
                "manual_publication_review"
              ]
            },
            "documented_methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "GET",
                  "manual_review"
                ]
              }
            },
            "transport_policy": {
              "const": "https_only"
            },
            "transport_verification": {
              "type": "string",
              "enum": [
                "not_tested",
                "https_confirmed",
                "blocked_pending_source_confirmation"
              ]
            },
            "pagination_note": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_url",
            "reuse_status",
            "must_recheck_before_ingestion"
          ],
          "properties": {
            "policy_url": {
              "$ref": "#/$defs/httpsUri"
            },
            "reuse_status": {
              "type": "string",
              "enum": [
                "terms_review_required",
                "cc-by-4.0_documented",
                "not_assessed"
              ]
            },
            "must_recheck_before_ingestion": {
              "type": "boolean"
            },
            "notes": {
              "type": "string",
              "maxLength": 1500
            }
          }
        },
        "data_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "granularity",
            "personal_data_expectation",
            "datasets_or_content",
            "collection_policy"
          ],
          "properties": {
            "granularity": {
              "type": "string",
              "enum": [
                "aggregate_financial",
                "procurement_records",
                "public_service_pages"
              ]
            },
            "personal_data_expectation": {
              "type": "string",
              "enum": [
                "aggregate_no_personal_data_expected",
                "public_pages_may_include_contact_details",
                "unknown"
              ]
            },
            "datasets_or_content": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "collection_policy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "known_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "ingestion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "enabled",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "catalogue_only"
            },
            "enabled": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
