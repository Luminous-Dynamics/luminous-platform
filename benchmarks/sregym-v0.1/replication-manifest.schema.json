              "docker": {
                "type": "string",
                "minLength": 1
              },
              "kubectl": {
                "type": "string",
                "minLength": 1
              },
              "helm": {
                "type": "string",
                "minLength": 1
              },
              "kubernetes": {
                "type": "string",
                "minLength": 1
              },
