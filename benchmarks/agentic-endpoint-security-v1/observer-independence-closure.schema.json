{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous:observer-independence-closure:0.1",
  "title": "Observer Independence Closure v0.1",
  "type": "object",
  "required": [
    "profile",
    "version",
    "status",
    "no_aggregate_score",
    "claim_profiles",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "luminous-observer-independence-closure"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "synthetic_fixture_suite_not_executed"
    },
    "no_aggregate_score": {
      "const": true
    },
    "claim_profiles": {
      "type": "object",
      "required": [
        "critical_effect_truth_v0"
      ],
      "properties": {
        "critical_effect_truth_v0": {
          "type": "object",
          "required": [
            "profile_id",
            "required_disjoint_domains",
            "minimum_independent_witnesses"
          ],
          "properties": {
            "profile_id": {
              "const": "critical_effect_truth_v0"
            },
            "required_disjoint_domains": {
              "const": [
                "process_runtime",
                "event_stream",
                "signing_root",
                "credential_root",
                "clock_authority",
                "storage_backend",
                "control_plane"
              ]
            },
            "minimum_independent_witnesses": {
              "const": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "domains": {
      "type": "object",
      "required": [
        "process_runtime",
        "event_stream",
        "signing_root",
        "credential_root",
        "clock_authority",
        "storage_backend",
        "control_plane",
        "operator",
        "provider"
      ],
      "properties": {
        "process_runtime": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_stream": {
          "type": [
            "string",
            "null"
          ]
        },
        "signing_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "clock_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "storage_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "control_plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "witness": {
      "type": "object",
      "required": [
        "witness_id",
        "role",
        "domains",
        "observation",
        "evidence_ref",
        "attestation_ref"
      ],
      "properties": {
        "witness_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "resource_observer",
            "host_observer",
            "independent_oracle",
            "supervisor",
            "source_inventory"
          ]
        },
        "domains": {
          "$ref": "#/$defs/domains"
        },
        "observation": {
          "enum": [
            "effect",
            "no_effect",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "required": [
        "left",
        "right",
        "shared_domains"
      ],
      "properties": {
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "shared_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": [
        "witness_count",
        "known_domain_witnesses",
        "unknown_domain_witnesses",
        "subject_correlated_witnesses",
        "correlated_pair_count",
        "correlated_pairs",
        "maximum_independent_witnesses",
        "maximum_independent_sets",
        "quorum",
        "observation_agreement",
        "final_disposition"
      ],
      "properties": {
        "witness_count": {
          "type": "integer",
          "minimum": 0
        },
        "known_domain_witnesses": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_domain_witnesses": {
          "type": "integer",
          "minimum": 0
        },
        "subject_correlated_witnesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correlated_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "correlated_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "maximum_independent_witnesses": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_independent_sets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        },
        "observation_agreement": {
          "enum": [
            "effect",
            "no_effect",
            "conflict",
            "unknown",
            "none"
          ]
        },
        "final_disposition": {
          "enum": [
            "qualified_effect",
            "qualified_no_effect",
            "unqualified",
            "indeterminate"
          ]
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "scenario_id",
        "control_class",
        "claim_profile_id",
        "subject_domains",
        "witnesses",
        "expected"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^OIC-[0-9]{3}$"
        },
        "control_class": {
          "enum": [
            "positive_control",
            "negative_control",
            "indeterminate_control"
          ]
        },
        "claim_profile_id": {
          "const": "critical_effect_truth_v0"
        },
        "subject_domains": {
          "$ref": "#/$defs/domains"
        },
        "witnesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/witness"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      },
      "additionalProperties": false
    }
  }
}
