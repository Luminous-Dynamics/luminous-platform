{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/research/luminous-power-fabric-v0.1/schemas/power-event-envelope-v0.1.schema.json",
  "title": "Power Fabric power-duration event envelope",
  "description": "Evidence-bound support capability for a non-overlapping mission event. Not waveform or protection qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "qualified_configuration_sha256",
    "observed_configuration_sha256",
    "evaluation_time_epoch_s",
    "qualification_valid_until_epoch_s",
    "mission_duration_s",
    "events",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "mission_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "qualified_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "observed_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "evaluation_time_epoch_s": { "type": "integer", "minimum": 0 },
    "qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
    "mission_duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "start_s",
          "duration_s",
          "required_peak_power_w",
          "maximum_unserved_energy_wh",
          "qualified_source_minimum_power_w",
          "source_measurement_uncertainty_bound_w",
          "source_model_uncertainty_bound_w",
          "qualified_common_path_power_w",
          "common_path_uncertainty_bound_w",
          "qualified_common_path_configuration_sha256",
          "observed_common_path_configuration_sha256",
          "common_path_qualification_valid_until_epoch_s",
          "common_path_evidence_status",
          "common_path_evidence_reference",
          "qualified_source_configuration_sha256",
          "observed_source_configuration_sha256",
          "source_qualification_valid_until_epoch_s",
          "source_evidence_status",
          "source_evidence_reference",
          "storage_support"
        ],
        "properties": {
          "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "start_s": { "type": "number", "minimum": 0 },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "required_peak_power_w": { "type": "number", "minimum": 0 },
          "maximum_unserved_energy_wh": { "type": "number", "minimum": 0 },
          "qualified_source_minimum_power_w": { "type": "number", "minimum": 0 },
          "source_measurement_uncertainty_bound_w": { "type": "number", "minimum": 0 },
          "source_model_uncertainty_bound_w": { "type": "number", "minimum": 0 },
          "qualified_common_path_power_w": { "type": "number", "minimum": 0 },
          "common_path_uncertainty_bound_w": { "type": "number", "minimum": 0 },
          "qualified_common_path_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "observed_common_path_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "common_path_qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
          "common_path_evidence_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
          "common_path_evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "qualified_source_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "observed_source_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "source_qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
          "source_evidence_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
          "source_evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "storage_support": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "storage_id",
              "qualified_configuration_sha256",
              "observed_configuration_sha256",
              "qualification_valid_until_epoch_s",
              "capability_status",
              "calibration_status",
              "sensor_status",
              "protection_status",
              "maximum_event_discharge_power_w",
              "max_supported_duration_s",
              "usable_energy_wh_at_event",
              "usable_energy_uncertainty_bound_wh",
              "discharge_efficiency",
              "state_of_charge_fraction",
              "state_of_health_fraction",
              "temperature_c",
              "operating_condition_reference",
              "evidence_reference"
            ],
            "properties": {
              "storage_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "qualified_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "observed_configuration_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "qualification_valid_until_epoch_s": { "type": "integer", "minimum": 0 },
              "capability_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
              "calibration_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
              "sensor_status": { "enum": ["current", "missing", "expired", "invalid", "unverified"] },
              "protection_status": { "enum": ["ready", "tripped", "faulted", "bypassed", "unknown"] },
              "maximum_event_discharge_power_w": { "type": "number", "minimum": 0 },
              "max_supported_duration_s": { "type": "number", "exclusiveMinimum": 0 },
              "usable_energy_wh_at_event": { "type": "number", "minimum": 0 },
              "usable_energy_uncertainty_bound_wh": { "type": "number", "minimum": 0 },
              "discharge_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "state_of_charge_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "state_of_health_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "temperature_c": { "type": "number" },
              "operating_condition_reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "evidence_reference": { "type": "string", "minLength": 1, "maxLength": 2048 }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "POWER_DURATION_EVENT_SCREEN_ONLY_NOT_WAVEFORM_OR_PROTECTION_QUALIFICATION"
    }
  }
}