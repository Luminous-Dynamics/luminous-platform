      "stimulus": "Submit cross-tenant operation.",
      "expected": {
        "disposition": "deny",
        "max_primary_effects": 0,
        "max_recovery_attempts": 0,
        "fresh_observation_required": false,
        "retry_policy": "new_authorization_required",
