      "purpose": "L4S architecture"
    },
    {
      "id": "RFC 9331",
      "status": "experimental",
      "purpose": "L4S ECN protocol semantics"
    },
    {
      "id": "RFC 9332",
      "status": "experimental",
      "purpose": "DualQ Coupled AQM"
    },
    {
      "id": "RFC 9438",
      "status": "standards_track",
      "purpose": "Classic TCP CUBIC reference"
    },
    {
      "id": "RFC 8290",
      "status": "experimental",
      "purpose": "FQ-CoDel queue-management comparator"
    }
  ],
