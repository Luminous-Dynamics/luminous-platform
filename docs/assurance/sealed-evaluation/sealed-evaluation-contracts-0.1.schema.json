{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/luminous-platform/blob/main/docs/assurance/sealed-evaluation/sealed-evaluation-contracts-0.1.schema.json",
  "title": "Sealed assurance evaluation contracts 0.1",
  "oneOf": [
    {
      "title": "Commitment receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "suite_id",
        "protocol_version",
        "public_input_manifest_sha256",
        "scoring_policy_sha256",
        "evaluator_build_sha256",
        "commitment_sha256",
        "commitment_sequence",
        "custody_receipt_sha256"
      ],
      "properties": {
        "schema": {
          "const": "luminous.sealed-challenge-commitment/0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "public_input_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scoring_policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evaluator_build_sha256": {
          "$ref": "#/$defs/digest"
        },
        "commitment_sha256": {
          "$ref": "#/$defs/digest"
        },
        "commitment_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "custody_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "title": "Reveal receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "suite_id",
        "protocol_version",
        "public_input_manifest_sha256",
        "scoring_policy_sha256",
        "evaluator_build_sha256",
        "private_bundle_sha256",
        "private_bundle_length",
        "salt_hex",
        "candidate_output_bundle_sha256",
        "reveal_sequence"
      ],
      "properties": {
        "schema": {
          "const": "luminous.sealed-challenge-reveal/0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "public_input_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scoring_policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evaluator_build_sha256": {
          "$ref": "#/$defs/digest"
        },
        "private_bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "private_bundle_length": {
          "type": "integer",
          "minimum": 0
        },
        "salt_hex": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_output_bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "reveal_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "Order receipt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "monitor_source_id",
        "monitor_control_domain",
        "monitor_receipt_sha256",
        "custody_receipt_sha256",
        "commitment_sequence",
        "first_execution_sequence",
        "last_execution_sequence",
        "output_lock_sequence",
        "candidate_output_bundle_sha256",
        "coverage_complete",
        "sequence_gap_count",
        "dropped_event_count",
        "private_access_attempts",
        "private_access_successes",
        "grader_access_attempts",
        "grader_access_successes"
      ],
      "properties": {
        "schema": {
          "const": "luminous.sealed-challenge-order-receipt/0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "monitor_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "monitor_control_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "monitor_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "custody_receipt_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "commitment_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "first_execution_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "last_execution_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "output_lock_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_output_bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "sequence_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "private_access_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "private_access_successes": {
          "type": "integer",
          "minimum": 0
        },
        "grader_access_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "grader_access_successes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "SUT-visible public manifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "suite_id",
        "protocol_version",
        "public_input_manifest_sha256",
        "scoring_policy_sha256",
        "candidate_visible_bundle_sha256",
        "allowed_resource_classes",
        "claim_ceiling"
      ],
      "properties": {
        "schema": {
          "const": "luminous.sealed-challenge-public-manifest/0.1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "public_input_manifest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scoring_policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "candidate_visible_bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "allowed_resource_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
