        "task_model_version",
        "tool_bundle_digest",
        "environment_digest",
        "benchmark_suite_digest",
        "task_split_digest",
        "policy_semantics_digest",
        "authorization_oracle_digest",
        "participant_oracle_digest",
        "effect_observer_digest",
        "evaluator_digest",
        "base_harness_digest"
      ],
      "properties": {
        "task_model_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "task_model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_bundle_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "environment_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "benchmark_suite_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "task_split_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "policy_semantics_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "authorization_oracle_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "participant_oracle_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "effect_observer_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "evaluator_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "base_harness_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "mutation_boundary": {
      "type": "object",
      "required": [
        "harness_mutable",
        "stressor_mutable",
        "task_model_mutable",
        "tool_bundle_mutable",
        "environment_mutable",
        "benchmark_semantics_mutable",
        "policy_semantics_mutable",
        "authorization_oracle_mutable",
        "participant_oracle_mutable",
        "effect_observer_mutable",
        "evaluator_mutable"
      ],
      "properties": {
        "harness_mutable": {
          "const": true
        },
        "stressor_mutable": {
          "const": true
        },
        "task_model_mutable": {
          "const": false
        },
        "tool_bundle_mutable": {
          "const": false
        },
        "environment_mutable": {
          "const": false
        },
        "benchmark_semantics_mutable": {
          "const": false
        },
        "policy_semantics_mutable": {
          "const": false
        },
        "authorization_oracle_mutable": {
          "const": false
        },
        "participant_oracle_mutable": {
          "const": false
        },
        "effect_observer_mutable": {
          "const": false
        },
        "evaluator_mutable": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "promotion_rule": {
      "type": "object",
      "required": [
        "stressor_requires_task_preservation",
        "stressor_requires_attack_objective_success",
        "attack_objective_must_use_frozen_oracle",
        "incomplete_execution_promotable",
        "oracle_change_invalidates_run"
      ],
      "properties": {
        "stressor_requires_task_preservation": {
          "const": true
        },
        "stressor_requires_attack_objective_success": {
          "const": true
        },
        "attack_objective_must_use_frozen_oracle": {
          "const": true
        },
        "incomplete_execution_promotable": {
          "const": false
        },
        "oracle_change_invalidates_run": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "objective_dimensions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "clean_task_success",
          "attacked_task_success",
          "benign_false_denial",
          "unauthorized_effect",
          "fail_closed_violation",
          "authorization_indeterminate",
          "participant_decision_correctness",
          "effect_observation_completeness",
          "runtime_validity",
          "latency",
          "energy",
          "memory",
          "cost",
          "human_recovery_burden"
        ]
      }
    },
    "search_budget": {
      "type": "object",
      "required": [
        "harness_expansions",
        "stressor_expansions",
        "per_candidate_attempts",
        "random_seeds",
        "wall_clock_seconds",
        "resource_limits_digest"
      ],
      "properties": {
        "harness_expansions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stressor_expansions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "per_candidate_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "random_seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "wall_clock_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "resource_limits_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": [
        "disposable_execution",
        "no_production_credentials",
        "network_egress",
        "host_privilege",
        "read_only_diagnoser",
        "separate_expander",
        "human_review_before_deployment"
      ],
      "properties": {
        "disposable_execution": {
          "const": true
        },
        "no_production_credentials": {
          "const": true
        },
        "network_egress": {
          "enum": [
            "disabled",
            "explicit_test_allowlist",
            "unknown"
          ]
        },
        "host_privilege": {
          "enum": [
            "unprivileged",
            "microvm",
            "container_hardened",
            "unknown"
          ]
        },
        "read_only_diagnoser": {
          "const": true
        },
        "separate_expander": {
          "const": true
        },
        "human_review_before_deployment": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "paired_seeds",
        "hidden_holdout_stressor_split",
        "positive_controls",
        "negative_controls",
        "independent_authorization_oracle",
        "independent_participant_oracle",
        "independent_effect_observer",
        "results_paired_by_case_seed",
        "confidence_method",
        "runs"
      ],
      "properties": {
        "paired_seeds": {
          "type": "boolean"
        },
        "hidden_holdout_stressor_split": {
          "type": "boolean"
        },
        "positive_controls": {
          "type": "boolean"
        },
        "negative_controls": {
          "type": "boolean"
        },
        "independent_authorization_oracle": {
          "type": "boolean"
        },
        "independent_participant_oracle": {
          "type": "boolean"
        },
        "independent_effect_observer": {
          "type": "boolean"
        },
        "results_paired_by_case_seed": {
          "type": "boolean"
        },
        "confidence_method": {
          "enum": [
            "wilson",
            "beta_posterior",
            "bootstrap_clustered",
            "other_preregistered",
            "not_set"
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "run_id",
              "harness_id",
              "parent_harness_id",
              "harness_digest",
              "stressor_set_digest",
              "frozen_input_digest",
              "status",
              "metrics",
              "evidence_refs"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 2
              },
              "harness_id": {
                "type": "string",
                "minLength": 2
              },
              "parent_harness_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "harness_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "stressor_set_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "frozen_input_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "authored",
                  "executed",
                  "complete",
                  "incomplete",
                  "rejected_utility",
                  "held_out"
                ]
              },
              "metrics": {
                "type": "object"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified_experiment"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "frozen_inputs": {
            "properties": {
              "task_model_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "tool_bundle_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "environment_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "benchmark_suite_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "task_split_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "policy_semantics_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "authorization_oracle_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "participant_oracle_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "effect_observer_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "evaluator_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "base_harness_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "search_budget": {
            "properties": {
              "harness_expansions": {
                "type": "integer",
                "minimum": 1
              },
              "stressor_expansions": {
                "type": "integer",
                "minimum": 1
              },
              "per_candidate_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "random_seeds": {
                "minItems": 1
              },
              "wall_clock_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "resource_limits_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "isolation": {
            "properties": {
              "network_egress": {
                "enum": [
                  "disabled",
                  "explicit_test_allowlist"
                ]
              },
              "host_privilege": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          },
          "evaluation": {
            "properties": {
              "paired_seeds": {
                "const": true
              },
              "hidden_holdout_stressor_split": {
                "const": true
              },
              "positive_controls": {
                "const": true
              },
              "negative_controls": {
                "const": true
              },
              "independent_authorization_oracle": {
                "const": true
              },
              "independent_participant_oracle": {
                "const": true
              },
              "independent_effect_observer": {
                "const": true
              },
              "results_paired_by_case_seed": {
                "const": true
              },
              "confidence_method": {
                "not": {
                  "const": "not_set"
                }
              },
              "runs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
