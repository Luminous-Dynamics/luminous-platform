{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/opsbench-operational-assurance-case-v0.1.json",
  "title":"OpsBench operational assurance case v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","version","status","case_id","study_id","run_id","episode_id","arm_id","attempt_id","attempt_ids","evaluated_at","scope_sha256","executor","top_level_claim_id","required_claim_types","claims","arguments","evidence","assumptions","defeaters"],
  "properties":{
    "schema":{"const":"luminous-opsbench-operational-assurance-case-v0.1"},
    "version":{"const":1},
    "status":{"enum":["example_only","registered_case"]},
    "case_id":{"type":"string","minLength":1},
    "study_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "episode_id":{"type":"string","minLength":1},
    "arm_id":{"type":"string","minLength":1},
    "attempt_id":{"type":["string","null"]},
    "attempt_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "evaluated_at":{"type":"string","format":"date-time"},
    "scope_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "executor":{"type":"object","additionalProperties":false,"required":["source_id","trust_domain_id"],"properties":{"source_id":{"type":"string","minLength":1},"trust_domain_id":{"type":"string","minLength":1}}},
    "top_level_claim_id":{"type":"string","minLength":1},
    "required_claim_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["authority","causal_integrity","publisher_authenticity","objective_outcome","service_slo","safety","study_integrity","economics"]}},
    "claims":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["claim_id","claim_type","statement","required","argument_id"],
        "properties":{
          "claim_id":{"type":"string","minLength":1},
          "claim_type":{"enum":["top_level","authority","causal_integrity","publisher_authenticity","objective_outcome","service_slo","safety","study_integrity","economics"]},
          "statement":{"type":"string","minLength":10},
          "required":{"type":"boolean"},
          "argument_id":{"type":"string","minLength":1}
        }
      }
    },
    "arguments":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["argument_id","target_claim_id","rule","premise_claim_ids","evidence_ids","assumption_ids","defeater_ids"],
        "properties":{
          "argument_id":{"type":"string","minLength":1},
          "target_claim_id":{"type":"string","minLength":1},
          "rule":{"const":"all_required_premises_and_evidence_supported"},
          "premise_claim_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "assumption_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "defeater_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "evidence":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["evidence_id","evidence_type","verification_status","source_id","source_trust_domain_id","verifier_id","verifier_trust_domain_id","artifact_sha256","verifier_sha256","source_commit_sha","run_id","episode_id","arm_id","scope_sha256","observed_at","valid_until","attempt_id"],
        "properties":{
          "evidence_id":{"type":"string","minLength":1},
          "evidence_type":{"enum":["authority_decision","causal_trace_verification","publisher_authenticity_verification","business_oracle_result","service_slo_result","safety_assessment","sealed_corpus_verification","economic_scorecard"]},
          "verification_status":{"enum":["supported","refuted","indeterminate"]},
          "source_id":{"type":"string","minLength":1},
          "source_trust_domain_id":{"type":"string","minLength":1},
          "verifier_id":{"type":"string","minLength":1},
          "verifier_trust_domain_id":{"type":"string","minLength":1},
          "artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "verifier_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "source_commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
          "run_id":{"type":"string","minLength":1},
          "episode_id":{"type":"string","minLength":1},
          "arm_id":{"type":"string","minLength":1},
          "scope_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "observed_at":{"type":"string","format":"date-time"},
          "valid_until":{"type":["string","null"],"format":"date-time"},
          "attempt_id":{"type":["string","null"]}
        }
      }
    },
    "assumptions":{
      "type":"array","uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["assumption_id","statement","owner","scope_sha256","status","reviewed_at","expires_at","rationale"],
        "properties":{
          "assumption_id":{"type":"string","minLength":1},
          "statement":{"type":"string","minLength":10},
          "owner":{"type":"string","minLength":1},
          "scope_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "status":{"enum":["accepted","rejected","unknown"]},
          "reviewed_at":{"type":"string","format":"date-time"},
          "expires_at":{"type":["string","null"],"format":"date-time"},
          "rationale":{"type":"string","minLength":10}
        }
      }
    },
    "defeaters":{
      "type":"array","uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["defeater_id","target_claim_id","description","critical","status","evidence_ids"],
        "properties":{
          "defeater_id":{"type":"string","minLength":1},
          "target_claim_id":{"type":"string","minLength":1},
          "description":{"type":"string","minLength":10},
          "critical":{"type":"boolean"},
          "status":{"enum":["open","mitigated","disproved"]},
          "evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}