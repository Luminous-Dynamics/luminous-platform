  "scenario_definitions": [
    {
      "id": "UTL-00",
      "topology": "tight_deadline_control_packets_mixed_with_bulk",
      "purpose": "prioritize deadline-qualified utility rather than raw byte count"
    },
    {
      "id": "UTL-01",
      "topology": "heterogeneous_task_sizes_deadlines_and_value_weights",
      "purpose": "distinguish task completion value from byte throughput"
    },
    {
